modules["ui/runner"] = function(...)

local import: (string) -> any = ...
local Canvas: typeof(require("../render/canvas")) = import("render/canvas")
local Chrome: typeof(require("./chrome")) = import("ui/chrome")
local Chat: typeof(require("../input/chat")) = import("input/chat")
local Draw: typeof(require("../render/draw")) = import("render/draw")
local Effects: typeof(require("./effects")) = import("ui/effects")
local Fonts: typeof(require("./fonts")) = import("ui/fonts")
local Hits: typeof(require("./hits")) = import("ui/hits")
local Keys: typeof(require("../input/keys")) = import("input/keys")
local Layout: typeof(require("./layout")) = import("ui/layout")
local Motion: typeof(require("./motion")) = import("ui/motion")
local Overlays: typeof(require("./overlays")) = import("ui/overlays")
local Painter: typeof(require("./painter")) = import("ui/painter")
local Palette: typeof(require("./palette")) = import("ui/palette")
local Settings: typeof(require("../state/settings")) = import("state/settings")
local Util: typeof(require("../core/util")) = import("core/util")
local Visualizer: typeof(require("../hitbox/visualizer")) = import("hitbox/visualizer")
local Welcome: typeof(require("./welcome")) = import("ui/welcome")
local WindowBlock: typeof(require("../input/window")) = import("input/window")

local Runner = {}

type App = { [string]: any }

local MENU_TOGGLE_DELAY = 0.35
local TARGET_INTERVAL = 0.05
local TYPING_INTERVAL = 0.1
local CAMERA_INTERVAL = 0.5
local FOCUS_INTERVAL = 0.1
local RESUME_GUARD = 0.25
local CALIBRATE_INTERVAL = 0.5

function Runner.springs(app: App): { [string]: any }
    local bag = app.Springs
    if not bag then
        bag = {}
        app.Springs = bag
    end
    return bag
end

local function clamp01(value: number): number
    return math.clamp(value, 0, 1)
end

local function liveMouse(app: App): Vector2
    local ok, position = pcall(getmouseposition)
    if ok and position then
        return position * app.DPI
    end
    return app.Mouse
end

local function refreshCamera(app: App, now: number)
    if now < app.NextCamera then
        return
    end
    app.NextCamera = now + CAMERA_INTERVAL
    local camera = Util.read(workspace, "CurrentCamera")
    if camera then
        app.Camera = camera
        local size = Util.read(camera, "ViewportSize")
        if size then
            app.Viewport = size
        end
    end
end

local function refreshLocal(app: App)
    local character = Util.read(app.LocalPlayer, "Character")
    app.LocalRoot = character and Util.child(character, "HumanoidRootPart") or nil
end

local function updateGeometry(app: App, now: number, dt: number)
    local state = app.State
    local m = app.M
    Painter.setCorner(tonumber(state.Roundness) or Settings.DEFAULT_ROUNDNESS)
    local requested = math.max(0.10, tonumber(state.UIScale) or Settings.defaultUiScale())
    if not Hits.isDragging("window:resize") then
        state.UIScale = requested
    end
    local menuSize = Vector2.new(m.Width, m.Height) * requested * app.DPI
    app.MenuSize = menuSize
    app.Scale = menuSize.X / m.Width

    if not app.Centered and app.Viewport.X > 0 then
        local viewport = app.Viewport * app.DPI
        local fit = math.min((viewport.X - 36 * app.DPI) / (m.Width * app.DPI), (viewport.Y - 36 * app.DPI) / (m.Height * app.DPI))
        state.UIScale = math.max(0.10, math.min(state.UIScale, fit))
        menuSize = Vector2.new(m.Width, m.Height) * state.UIScale * app.DPI
        app.MenuSize = menuSize
        app.Scale = menuSize.X / m.Width
        app.MenuPos = Vector2.new(math.floor(viewport.X / 2 - menuSize.X / 2), math.floor(viewport.Y / 2 - menuSize.Y / 2))
        app.TargetPos = app.MenuPos
        app.Centered = true
    end

    if app.RevealStart then
        local elapsed = now - app.RevealStart
        state.VisibilityAnim = 1
        state.IntroAlpha = 1
        state.NavReveal = math.clamp((elapsed - 0.28) / 0.82, 0, 1)
        state.TabReveal = math.clamp((elapsed - 0.30) / 0.62, 0, 1)
        local visual = math.clamp((elapsed - 0.08) / 0.72, 0, 1)
        app.WelcomeVisual = visual * visual * (3 - 2 * visual)
        if elapsed >= 2.22 then
            app.RevealStart = nil
            app.WelcomeVisual = 1
        end
    else
        state.VisibilityAnim = Motion.ease(state, state.VisibilityAnim, if state.Visible then 1 else 0, dt, if state.Visible then 12 else 18)
        state.IntroAlpha = clamp01(state.VisibilityAnim)
    end

    local opening = state.Visible == true

    local open = math.clamp(Motion.spring(state, Runner.springs(app), "open", if opening then 1 else 0, dt, if opening then 0.45 else 0.25, if opening then 0.82 else 1), 0, 1.04)
    state.UIScaleAnim = 0.86 + 0.14 * open

    local previous = app.MenuPos
    local follow = 1 - math.exp(-22 * dt)
    app.MenuPos = Util.lerpVector2(app.MenuPos, app.TargetPos, follow)
    local velocity = app.MenuPos - previous
    app.Moving = Hits.heldKey() == "window:drag" or Hits.heldKey() == "window:resize" or math.abs(velocity.X) + math.abs(velocity.Y) > 0.25

    local animated = state.UIScaleAnim
    local current = app.MenuSize * animated
    local origin = app.MenuPos + app.MenuSize / 2 - current / 2
    app.WindowPos = origin
    app.WindowSize = current
    app.Unit = app.Scale * animated

    local stable = state.IntroAlpha > 0.94 and math.abs(animated - 1) < 0.018
    state.EdgeStableAlpha = Motion.ease(state, state.EdgeStableAlpha, if stable then 1 else 0, dt, if stable then 15 else 30)

    local intro = state.IntroAlpha
    local visual = app.WelcomeVisual
    app.Alpha.UI = math.clamp((if state.Transparent then state.UITrans else 1) * intro, 0, 1)
    app.Alpha.Btn = math.clamp((if state.Transparent then state.ButtonTrans else 1) * intro * visual, 0, 1)
    app.Alpha.Text = math.clamp((intro - 0.35) * 1.54, 0, 1) * visual
    app.Pal = Palette.compute(state, dt)

    local font = tonumber(state.UIFont) or 5
    Draw.setFont(font)
    app.TextScale = Util.finite(math.max(app.Scale, 0.95) * Fonts.scale(font), 1)
end

local function updateTabs(app: App, dt: number)
    local state = app.State
    if state.AnimationsEnabled then

        local speed = 14 * Motion.speed(state)
        if state.NextTab then

            state.TabAlpha = Motion.ease(state, state.TabAlpha, 0, dt, speed * 2.2)
            if state.TabAlpha < 0.03 then
                state.CurrentTab = state.NextTab
                state.NextTab = nil
                state.TabReveal = 0
                state.TabAlpha = 1
            end
        end
        if not app.RevealStart then

            local step = if state.HighPerformanceMode then 1 else dt * Motion.intensity(state) / 0.62
            state.TabReveal = math.min(1, (state.TabReveal or 0) + step)
            state.NavReveal = math.min(1, (state.NavReveal or 0) + step)
        end
    else
        if state.NextTab then
            state.CurrentTab = state.NextTab
            state.NextTab = nil
        end
        state.TabAlpha, state.TabReveal, state.NavReveal = 1, 1, 1
    end
    state.TogglePulse = Motion.ease(state, state.TogglePulse, 0, dt, 7 * Motion.speed(state))
end

local function drawField(app: App, now: number)
    local state = app.State
    if not (state.FovHitboxEnabled or state.DynSizeEnabled) or not state.ShowFOV then
        return
    end
    local center = app.Mouse
    local radius = state.FOVSize * app.DPI
    local mode = state.FOVAnim
    if mode == "Static" then
        Canvas.circle(center, radius, state.FOVColor, state.FOVTrans, state.FOVThickness)
        return
    end
    local dots = state.FOVDots
    local dotRadius = state.FOVThickness * 1.5 * app.DPI
    local phase = now * state.FOVSpeed
    if mode == "Breathe" then
        radius += math.sin(phase) * 15 * app.DPI
        phase = 0
    end
    for index = 1, dots do
        local angle = (index / dots) * math.pi * 2 + phase
        Canvas.filledCircle(center + Vector2.new(math.cos(angle), math.sin(angle)) * radius, dotRadius, state.FOVColor, state.FOVTrans)
    end
end

local function captureBind(app: App, key: string)
    local state = app.State
    local focus: string = app.Focus
    local clear = key == "Escape" or key == "Backspace" or key == "Delete"
    local optionKey = string.match(focus, "^" .. app.BIND_PREFIX .. "(.+)$")
    if optionKey then
        if clear then
            state.OptionKeybinds[optionKey] = "None"
        elseif key ~= "Unknown" then
            state.OptionKeybinds[optionKey] = key
        end
    else
        local target = app.CAPTURE_STATE[focus]
        if target and clear then
            state[target] = "None"
        elseif target and key ~= "Unknown" then
            state[target] = key
        end
    end
    app.Focus = nil
end

local function handleKeys(app: App, now: number)
    local state = app.State
    local down = Keys.pressed(true)
    local fresh: { [string]: boolean } = {}
    for key in down do
        if not app.PreviousKeys[key] then
            fresh[key] = true
        end
    end
    local captured = Keys.findNew(down, app.PreviousKeys)
    app.PreviousKeys = down

    local focus: string? = app.Focus
    local capturing = focus ~= nil and app:isCapturing(focus)
    if state.Visible and capturing and captured then
        captureBind(app, captured)
        return
    end
    local blocked = app.Focus ~= nil or Hits.busy() or app.Popup.Name ~= "None" or app.OpenDropdown ~= nil
        or (state.TypingGuard ~= false and state.ChatTypingHeuristic ~= false and app.ChatTyping)
    if blocked then
        return
    end
    local menuKey = Keys.normalize(state.Keybind)
    if menuKey ~= "" and menuKey ~= "None" and fresh[menuKey] then
        if now - app.LastToggle > MENU_TOGGLE_DELAY then
            app.LastToggle = now
            state.Visible = not state.Visible
            if not state.Visible then
                app.Focus = nil
                Hits.cancel()
                WindowBlock.setBlocked(false)
            end
        end
        return
    end
    local fired: { [string]: boolean } = {}
    for stateKey, keyName in state.OptionKeybinds do
        local key = Keys.normalize(keyName)
        if key ~= "" and key ~= "None" and fresh[key] and not fired[stateKey] then
            fired[stateKey] = true
            app:toggleState(stateKey)
        end
    end
end

local function updateHold(app: App)
    local state = app.State
    local active = state.HitboxEnabled == true
    if active and state.HoldMode then
        local key = Keys.normalize(state.HoldKey)
        active = key ~= "" and key ~= "None" and app.PreviousKeys[key] == true and app.Focus == nil and not app.ChatTyping
    end
    state.HitboxActive = active
end

local function updateSlow(app: App, now: number)
    local state = app.State
    if now >= app.NextTyping then
        app.NextTyping = now + TYPING_INTERVAL
        app.ChatTyping = state.TypingGuard ~= false and state.ChatTypingHeuristic ~= false and Chat.isTyping()
    end
    if now >= app.NextTarget then
        app.NextTarget = now + TARGET_INTERVAL
        if app.Camera then
            pcall(app.Hitbox.selectSingleTarget, app.Hitbox, app.Camera, app.Mouse / app.DPI, app.GetPlayers(), app.LocalRoot)
        end
    end
    app:refreshStatus()

    if app.Focus == "NPCMatch" then
        app.Entities:previewSearch(app.Buffers.NPCMatch or "")
    else
        app.Entities:stopPreview()
    end
end

local function drawHitboxes(app: App)
    local state = app.State
    local wanted = (state.VisualizeHitbox and state.HitboxActive) or (state.NPCVisualize ~= false and app.Entities:hasEnabledGroups())
    if not wanted or not app.Camera or app.Welcome then
        return
    end
    local frame = {
        Camera = app.Camera,
        Players = app.GetPlayers(),
        Mouse = app.Mouse / app.DPI,
        LocalRoot = app.LocalRoot,
        Delta = app.Dt,
        SingleTarget = app.Hitbox.SingleTarget,
    }
    pcall(app.Visualizer.render, app.Visualizer, app.Hitbox, frame)
end

local MOVE_SLACK = 0.5
local IDLE_RELEASE = 1.0

local function updateWindowBlock(app: App)
    local state = app.State
    local mouse = app.Mouse
    local now = app.Now
    if not app.MouseSeen or (mouse - app.MouseSeen).X ^ 2 + (mouse - app.MouseSeen).Y ^ 2 > MOVE_SLACK * MOVE_SLACK then
        app.MouseSeen = mouse
        app.MouseMovedAt = now
    end
    local over = Util.contains(mouse, app.WindowPos, app.WindowSize)
    local enabled = state.BlockRobloxWindow ~= false and state.Visible and state.VisibilityAnim > 0.05 and not app.Suspended
    local block = false
    if enabled then
        if Hits.busy() then
            block = true
        elseif over then
            local steering = app.Focus == nil and WindowBlock.playerIsPlaying(app.PreviousKeys)
            local recent = now - (app.MouseMovedAt or 0) < IDLE_RELEASE
            block = not steering and (recent or Hits.at(mouse) ~= nil)
        end
    end
    WindowBlock.setBlocked(block)
end

local function drawWindow(app: App, now: number)
    local state = app.State
    local m = app.M
    app.Modal = app.Popup.Name ~= "None" or app.OpenDropdown ~= nil

    Hits.add({
        key = "window:drag",
        position = app.WindowPos,
        size = app:size(m.Width, 54),
        press = function(mouse: Vector2)
            app.DragOffset = app.MenuPos - mouse
        end,
        drag = function(mouse: Vector2)
            app.TargetPos = mouse + app.DragOffset
        end,
    })
    local corner = 20 * app.Unit
    Hits.add({
        key = "window:resize",
        position = app.WindowPos + app.WindowSize - Vector2.new(corner, corner),
        size = Vector2.new(corner, corner),
        drag = function(mouse: Vector2)
            local width = math.max(m.Width * app.DPI * 0.60, mouse.X - app.MenuPos.X)
            local scale = math.clamp(width / (m.Width * app.DPI), 0.60, 2.0)
            local default = Settings.defaultUiScale()
            if math.abs(scale - default) < 0.04 then
                scale = default
            end
            state.UIScale = scale
        end,
    })

    local tab = app:currentTab()
    local index = Layout.activeIndex(app, tab)
    local section = tab.sections[index]

    local baseText = app.Alpha.Text
    local behind = 1 - 0.92 * clamp01(app.Popup.Alpha)
    app.Alpha.Text = baseText * behind
    local x, y, width, bottom = Chrome.draw(app, now, tab, section, index)
    Layout.draw(app, section, x, y, width, bottom)

    if tab.name == "Changelog" then
        Effects.meteors(state, now, app.ContentBox, app.Scale, app.Alpha.Text, app.Pal.Text)
    end
    app.Alpha.Text = baseText
    Overlays.drawDropdown(app)
    Overlays.drawPopup(app, now)
end

local function processInput(app: App)
    local state = app.State
    local mouse = app.Mouse
    local active = not app.Suspended
    local down = active and isleftpressed() == true
    local pressed = down and not app.WasDown
    local released = app.WasDown and not down
    app.WasDown = down
    app.LeftDown = down
    if app.Welcome or not state.Visible and state.VisibilityAnim < 0.5 then
        return
    end
    if pressed then
        local focus: string? = app.Focus
        if focus and not app:isCapturing(focus) then
            app.Typing:apply()
        end
        Hits.press(mouse)
    elseif down then
        Hits.hold(mouse)
    end
    if released then
        Hits.release(mouse)
    end
end

function Runner.step(app: App, now: number)
    local state = app.State
    local dt = math.min(now - app.LastNow, 0.05)
    app.LastNow = now
    app.Dt, app.Now = dt, now

    Hits.begin()
    Painter.begin()
    Canvas.begin()

    app.Mouse = liveMouse(app)
    app.HoverKey = Hits.hover(app.Mouse)
    refreshCamera(app, now)
    Canvas.setCamera(app.Camera)
    if now >= (app.NextCalibrate or 0) then
        app.NextCalibrate = now + CALIBRATE_INTERVAL
        Canvas.calibrate()
    end
    refreshLocal(app)
    Palette.glide(state, Settings.COLOR_KEYS, dt)
    app:flushTheme()
    processInput(app)
    updateGeometry(app, now, dt)
    updateTabs(app, dt)

    if app.Welcome then
        if Welcome.render(app, now) then
            Painter.finish()
            Canvas.publish()
            return
        end
    end

    if not app.Welcome and state.UpdateNoticePending and not state.UpdateNoticeOpened and app.Popup.Name == "None" then
        state.UpdateNoticeOpened = true
        app.LastClick = nil
        app:openPopup("updateNotice")
    end

    updateSlow(app, now)
    updateHold(app)
    drawField(app, now)
    drawHitboxes(app)
    handleKeys(app, now)
    app.Typing:step(now)

    if state.IntroAlpha > 0.001 then
        drawWindow(app, now)
    end
    updateWindowBlock(app)
    Painter.finish()
    Canvas.publish()
end

local function connectRender(): any
    local connection = nil
    pcall(function()
        connection = game:GetService("RunService").Render:Connect(function()
            pcall(Canvas.flush)
        end)
    end)
    return connection
end

function Runner.start(app: App): () -> ()
    local running = true
    app.Springs.open = { x = 0, v = 0 }
    app.LastNow = os.clock()
    app.NextCamera, app.NextTyping, app.NextTarget = 0, 0, 0
    app.LastToggle = 0
    app.ChatTyping = false
    app.PreviousKeys = Keys.pressed(true)
    app.WasDown = false
    app.DragOffset = Vector2.zero
    app.WelcomeVisual = 1
    app.Visualizer = Visualizer.new({
        State = app.State,
        Profile = app.Profile,
        LocalPlayer = app.LocalPlayer,
        GetNPCVisualEntries = function()
            return app.Entities:visualEntries()
        end,
    })
    if Welcome.pending() then
        app.Welcome = Welcome.new()
        app.WelcomeVisual = 1
    end
    app:applyFont()

    local connection = connectRender()
    local chatThread = Chat.start()

    local mainThread = task.spawn(function()
        while running do
            if app.Suspended then
                task.wait(0.2)
            else
                local ok = pcall(Runner.step, app, os.clock())
                if not ok then
                    Painter.finish()
                    Canvas.publish()
                end
                task.wait()
            end
        end
    end)

    local active = true
    local resumeAt = 0
    local focusThread = task.spawn(function()
        while running do
            local ok, value = pcall(isrbxactive)
            local nowActive = not ok or value == true
            if not nowActive and active then
                active = false
                app.Suspended = true
                Hits.cancel()
                app.Focus = nil
                app.WasDown = false
                WindowBlock.setBlocked(false)
                Painter.hideAll()
                Canvas.clear()
            elseif nowActive and not active then
                active = true
                resumeAt = os.clock() + RESUME_GUARD
            end
            if active and app.Suspended and os.clock() >= resumeAt then
                app.Suspended = false
                app.PreviousKeys = Keys.pressed(true)
                app.Typing:reset()
                app.LastNow = os.clock()
            end
            task.wait(FOCUS_INTERVAL)
        end
    end)

    task.delay(0.35, function()
        if running then
            pcall(app.Entities.loadSaved, app.Entities)
        end
    end)
    task.defer(function()
        if running then
            pcall(app.loadStartupConfig, app)
        end
    end)

    return function()
        running = false
        pcall(task.cancel, mainThread)
        pcall(task.cancel, focusThread)
        pcall(task.cancel, chatThread)
        if connection then
            pcall(function()
                connection:Disconnect()
            end)
        end
        Canvas.clear()
        Painter.hideAll()
        WindowBlock.setBlocked(false)
    end
end

return Runner
end
modules["ui/spec"] = function(...)

local Spec = {}

type Map = { [string]: any }

local function merge(spec: Map, options: Map?): Map
    if options then
        for key, value in options do
            spec[key] = value
        end
    end
    return spec
end

function Spec.toggle(text: string, state: string, options: Map?): Map
    return merge({ kind = "toggle", text = text, state = state, bindable = true }, options)
end

function Spec.slider(text: string, state: string, min: number, max: number, options: Map?): Map
    return merge({ kind = "slider", text = text, state = state, min = min, max = max, float = false }, options)
end

function Spec.button(text: string, onClick: ((app: any, position: Vector2, size: Vector2) -> ())?, options: Map?): Map
    return merge({ kind = "button", text = text, onClick = onClick }, options)
end

function Spec.dropdown(text: string, state: string, values: any, options: Map?): Map
    return merge({ kind = "dropdown", text = text, state = state, values = values }, options)
end

function Spec.text(text: string, options: Map?): Map
    return merge({ kind = "text", text = text }, options)
end

function Spec.bindrow(index: number, options: Map?): Map
    return merge({ kind = "bindrow", index = index }, options)
end

function Spec.chips(text: string, rows: { { string } }): Map
    return { kind = "chips", text = text, rows = rows, height = 30 + #rows * 32 }
end

function Spec.pair(left: Map, right: Map): Map
    return { kind = "pair", left = left, right = right }
end

function Spec.section(title: string, rows: { Map }): Map
    return { title = title, rows = rows }
end

function Spec.tab(name: string, label: string, sections: { Map }): Map
    return { name = name, label = label, sections = sections }
end

function Spec.assignIds(tab: Map)
    local count = 0
    local function assign(spec: Map)
        count += 1
        spec.id = tab.name .. "/" .. tostring(count)
    end
    for _, section in tab.sections do
        for _, row in section.rows do
            if row.kind == "pair" then
                assign(row.left)
                assign(row.right)
            else
                assign(row)
            end
        end
    end
end

function Spec.gate(tab: Map, exempt: { [string]: boolean })
    local function mark(spec: Map)
        if not exempt[spec.state or ""] and not spec.exempt then
            spec.gated = true
        end
    end
    for _, section in tab.sections do
        for _, row in section.rows do
            if row.kind == "pair" then
                mark(row.left)
                mark(row.right)
            else
                mark(row)
            end
        end
    end
end

return Spec
end
modules["ui/typing"] = function(...)

local import: (string) -> any = ...
local Sizing: typeof(require("../hitbox/sizing")) = import("hitbox/sizing")

local Typing = {}
Typing.__index = Typing

type App = { [string]: any }

local FIRST_REPEAT = 0.4
local NEXT_REPEAT = 0.05

local NUMERIC_KEYS: { [string]: boolean } = {
    SizeAll = true, NPCSizeAll = true, MaxDistance = true, FOVSize = true, FOVSpeed = true, FOVDots = true,
    DimX = true, DimY = true, DimZ = true,
    SizeRoot = true, SizeHead = true, SizeTorso = true, SizeArms = true, SizeLegs = true,
}

function Typing.new(app: App)
    return setmetatable({ App = app, LastKey = "", RepeatAt = 0 }, Typing)
end

type Self = typeof(Typing.new(nil :: any))

local NAMED_CHARACTERS: { [string]: string } = { Space = " ", Period = ".", NumberSign = "#" }

local function characterOf(key: string): string
    if #key == 1 then
        return key
    end
    local named = NAMED_CHARACTERS[key]
    if named then
        return named
    end
    local digit = string.match(key, "^Number(%d)$") or string.match(key, "^Keypad(%d)$")
    return digit or ""
end

local function isNumericKey(key: string): boolean
    return NUMERIC_KEYS[key] == true
        or string.match(key, "^DynSize") ~= nil
        or string.match(key, "^DynMin") ~= nil
        or string.match(key, "^DynMax") ~= nil
end

local function acceptsDigitsOnly(key: string): boolean
    return isNumericKey(key)
end

local function append(app: App, focus: string, char: string)
    local buffers = app.Buffers
    local current = buffers[focus] or ""
    if focus == "Hex" then
        local hex = string.upper(char)
        if string.match(hex, "^[0-9A-F#]$") and #current < 7 then
            buffers.Hex = current .. hex
        end
    elseif focus == "Red" or focus == "Green" or focus == "Blue" then
        if string.match(char, "%d") and #current < 3 then
            buffers[focus] = current .. char
        end
    elseif acceptsDigitsOnly(focus) then
        if string.match(char, "%d") then
            buffers[focus] = current .. char
        end
    else
        buffers[focus] = current .. char
    end
end

function Typing.matchPlayer(app: App, query: string): string
    if query == "" then
        return ""
    end
    local lowered = string.lower(query)
    for _, player in app.GetPlayers() do
        if player ~= app.LocalPlayer and player.Name and player.DisplayName then
            if string.sub(string.lower(player.Name), 1, #lowered) == lowered
                or string.sub(string.lower(player.DisplayName), 1, #lowered) == lowered then
                return player.Name
            end
        end
    end
    return ""
end

local function addToList(name: string, set: { [string]: boolean }, order: { string })
    if set[name] or name == "None" or name == "" then
        return
    end
    set[name] = true
    table.insert(order, 1, name)
end

local COLOR_FIELDS = { Hex = true, Red = true, Green = true, Blue = true }

function Typing.apply(self: Self)
    local app = self.App
    local state = app.State
    local focus: string? = app.Focus
    if focus == "Target" then
        addToList(Typing.matchPlayer(app, app.Buffers.Target or ""), state.Targets, state.TargetOrder)
        app.Buffers.Target = ""
    elseif focus == "Whitelist" then
        addToList(Typing.matchPlayer(app, app.Buffers.Whitelist or ""), state.Whitelist, state.WhitelistOrder)
        app.Buffers.Whitelist = ""
    elseif focus == "NPCMatch" then
        app.Entities:addSearch(app.Buffers.NPCMatch or "")
        app.Buffers.NPCMatch = ""
    elseif focus and COLOR_FIELDS[focus] then
        app.Picker:applyField(focus)
    elseif focus and type(state[focus]) == "number" then
        local value = tonumber(app.Buffers[focus])
        if value then
            local number = string.match(focus, "^DynMin(%d+)$")
            local maxNumber = string.match(focus, "^DynMax(%d+)$")
            if number and value > (state[Sizing.MAX_KEYS[tonumber(number) :: number]] or 0) then
                value = nil
            elseif maxNumber and value < (state[Sizing.MIN_KEYS[tonumber(maxNumber) :: number]] or 0) then
                value = nil
            end
            if value then
                state[focus] = value
            end
        end
    end
    app.Focus = nil
end

function Typing.step(self: Self, now: number)
    local app = self.App
    local focus: string? = app.Focus
    if not focus or app:isCapturing(focus) then
        return
    end
    local ok, key = pcall(getpressedkey)
    local pressed = if ok and type(key) == "string" and key ~= "None" then key else ""
    if pressed == "" then
        self.LastKey = ""
        return
    end
    local isNew = pressed ~= self.LastKey
    if isNew then
        self.LastKey = pressed
        self.RepeatAt = now + FIRST_REPEAT
    elseif now <= self.RepeatAt then
        return
    else
        self.RepeatAt = now + NEXT_REPEAT
    end

    local buffers = app.Buffers
    if pressed == "Enter" then
        if isNew then
            self:apply()
        end
    elseif pressed == "Tab" then
        if isNew and (focus == "Target" or focus == "Whitelist") then
            local match = Typing.matchPlayer(app, buffers[focus] or "")
            if match ~= "" then
                buffers[focus] = match
            end
        end
    elseif pressed == "Backspace" then
        buffers[focus] = string.sub(buffers[focus] or "", 1, -2)
    else
        local char = characterOf(pressed)
        if char ~= "" then
            append(app, focus, char)
        end
    end
end

function Typing.reset(self: Self)
    self.LastKey = ""
    self.RepeatAt = 0
end

return Typing
end
modules["ui/welcome"] = function(...)

local import: (string) -> any = ...
local Changelog: typeof(require("./changelog")) = import("ui/changelog")
local Color: typeof(require("../core/color")) = import("core/color")
local Effects: typeof(require("./effects")) = import("ui/effects")
local Motion: typeof(require("./motion")) = import("ui/motion")
local Painter: typeof(require("./painter")) = import("ui/painter")
local Storage: typeof(require("../core/storage")) = import("core/storage")
local Util: typeof(require("../core/util")) = import("core/util")

local Welcome = {}

type App = { [string]: any }

Welcome.MARKER = Storage.ROOT .. "/v4_release_welcome.txt"

local POPUP_SIZE = Vector2.new(400, 404)
local TITLE = "Welcome to V4"
local HEADING = "here is what changed"
local DISCORD = "lmk about issues in the discord"
local Z_CARD, Z_TEXT = 30, 32

local function reveal(elapsed: number, delay: number, duration: number): number
    local t = math.clamp((elapsed - delay) / math.max(0.01, duration), 0, 1)
    return t
end

local function smoother(t: number): number
    return t * t * t * (t * (t * 6 - 15) + 10)
end

local function entries(): { string }
    local list: { string } = {}
    for _, text in Changelog.PAGES[1].Lines do
        table.insert(list, (string.gsub(text, "^%+%s*", "")))
    end
    return list
end

function Welcome.new(): { [string]: any }
    return { Start = 0, Closing = false, ClosingStart = 0, Fade = 0, Hover = 0, WasDown = false }
end

function Welcome.pending(): boolean
    return not Storage.isFile(Welcome.MARKER)
end

local function wrapped(label: string, size: number, limit: number): { string }
    local rows: { string } = {}
    local current = ""
    for word in string.gmatch(label, "%S+") do
        local candidate = if current == "" then word else current .. " " .. word
        if current ~= "" and Painter.textWidth(candidate, size) > limit then
            table.insert(rows, current)
            current = word
        else
            current = candidate
        end
    end
    if current ~= "" then
        table.insert(rows, current)
    end
    return rows
end

local function text(app: App, label: string, position: Vector2, size: number, color: Color3, alpha: number, center: boolean?)
    Painter.text(label, position, size, color, alpha, Z_TEXT, center, false)
end

function Welcome.render(app: App, now: number): boolean
    local session = app.Welcome
    local state = app.State
    local pal = app.Pal
    local dpi: number = app.DPI
    if session.Start == 0 then
        session.Start = now
    end

    local viewport: Vector2 = app.Viewport * dpi
    local baseWidth, baseHeight = app.M.Width, app.M.Height
    local fitX = (viewport.X - 36 * dpi) / (baseWidth * dpi)
    local fitY = (viewport.Y - 36 * dpi) / (baseHeight * dpi)
    local fullScale = math.max(0.10, math.min(state.UIScale, fitX, fitY)) * dpi
    local fullSize = Util.roundVector2(Vector2.new(baseWidth, baseHeight) * fullScale)
    local fullPos = Util.roundVector2(Vector2.new(viewport.X * 0.5 - fullSize.X * 0.5, viewport.Y * 0.5 - fullSize.Y * 0.5))

    local popupFitX = (viewport.X - 42 * dpi) / (POPUP_SIZE.X * dpi)
    local popupFitY = (viewport.Y - 42 * dpi) / (POPUP_SIZE.Y * dpi)
    local popupScale = math.max(0.10, math.min(state.UIScale, popupFitX, popupFitY, 1.10)) * dpi
    local popupSize = Util.roundVector2(POPUP_SIZE * popupScale)
    local popupPos = Util.roundVector2(Vector2.new(viewport.X * 0.5 - popupSize.X * 0.5, viewport.Y * 0.5 - popupSize.Y * 0.5))

    local elapsed = now - session.Start
    session.Fade = Motion.ease(state, session.Fade, 1, app.Dt, 10)
    local fade = math.clamp(session.Fade, 0, 1)

    local raw, closing = 0, 0
    if session.Closing then
        closing = now - session.ClosingStart
        raw = math.clamp((closing - 0.20) / 1.38, 0, 1)
    end
    local expand = smoother(raw)
    local position = Util.roundVector2(popupPos + (fullPos - popupPos) * expand)
    local size = Util.roundVector2(popupSize + (fullSize - popupSize) * expand)
    local scale = popupScale + (fullScale - popupScale) * expand
    local contentFade = if session.Closing then math.clamp(1 - closing / 0.30, 0, 1) else 1
    local merge = math.clamp((raw - 0.12) / 0.68, 0, 1)
    local rounding = math.max(6, math.round((16 - expand) * scale))

    Painter.rect(position, size, pal.Main, fade, 1, rounding)
    Effects.outline(state, now, position, size, scale, fade, "main")

    local margin = 9 * popupScale * (1 - merge)
    local cardPos = Util.roundVector2(position + Vector2.new(margin, margin))
    local cardSize = Util.roundVector2(size - Vector2.new(margin * 2, margin * 2))
    Painter.rect(cardPos, cardSize, Color.lerp(pal.Panel, pal.Main, 0.35), fade * (1 - merge) * 0.96, Z_CARD, math.max(8, math.round(16 * scale)))

    local content = fade * contentFade
    local unit = popupScale
    local width = cardSize.X / unit
    local function line(label: string, x: number, y: number, delay: number, duration: number, color: Color3, center: boolean, size: number)
        local shown = reveal(elapsed, delay, duration) * content
        local at = cardPos + Vector2.new(x * unit, (y + (1 - shown) * 8 - raw * 7) * unit)
        text(app, label, Util.roundVector2(at), size * unit, color, shown, center)
    end
    line(TITLE, 22, 18, 0.15, 0.55, pal.Text, false, 20)
    line(HEADING, 22, 44, 0.35, 0.55, pal.Sub, false, 12)
    local ruleShown = reveal(elapsed, 0.30, 0.50)
    Painter.rect(
        Util.roundVector2(cardPos + Vector2.new(20 * unit, 66 * unit)),
        Util.roundVector2(Vector2.new((width - 40) * unit * ruleShown, math.max(1, unit))),
        pal.Off, content * 0.8, Z_CARD + 1, 0
    )

    local textLimit = (width - 40 - 24) * unit
    local cursor = 78
    for index, label in entries() do
        local rows = wrapped(label, 13 * unit, textLimit)
        local rowHeight = 10 + #rows * 17
        local delay = 0.55 + (index - 1) * 0.12
        local shown = reveal(elapsed, delay, 0.45) * content
        local rowPosition = Util.roundVector2(cardPos + Vector2.new((20 + (1 - shown) * 10) * unit, (cursor - raw * 7) * unit))
        local rowSize = Util.roundVector2(Vector2.new((width - 40) * unit, rowHeight * unit))
        Painter.rect(rowPosition, rowSize, pal.Panel, shown * (1 - merge) * 0.95, Z_CARD + 1, math.max(8, math.round(14 * unit)))
        for rowIndex, row in rows do
            line(row, 34, cursor + 5 + (rowIndex - 1) * 17, delay, 0.45, pal.Text, false, 13)
        end
        cursor += rowHeight + 4
    end

    local barY = cardSize.Y / unit - 44
    line(DISCORD, 22, barY + 8, 1.70, 0.50, pal.Sub, false, 12)
    local buttonReveal = reveal(elapsed, 1.90, 0.50) * content
    local buttonSize = Util.roundVector2(Vector2.new(84 * unit, 28 * unit))
    local buttonPos = Util.roundVector2(Vector2.new(cardPos.X + cardSize.X - buttonSize.X - 20 * unit, cardPos.Y + barY * unit))
    local hovered = buttonReveal > 0.80 and not session.Closing and Util.contains(app.Mouse, buttonPos, buttonSize)
    session.Hover = Motion.ease(state, session.Hover, if hovered then 1 else 0, app.Dt, 18)
    Painter.rect(buttonPos, buttonSize, Color.lerp(pal.Panel, pal.Accent, 0.15 + 0.85 * session.Hover), buttonReveal, Z_CARD + 1, math.max(7, math.round(14 * unit)))
    Painter.text(
        "Close",
        buttonPos + buttonSize / 2,
        13 * unit,
        Color.lerp(pal.Text, Color3.new(0.07, 0.08, 0.08), session.Hover),
        buttonReveal,
        Z_TEXT,
        true,
        true
    )

    local pressed = app.LeftDown and not session.WasDown
    session.WasDown = app.LeftDown
    if pressed and hovered then
        session.Closing = true
        session.ClosingStart = now
        Storage.ensureFolder(Storage.ROOT)
        Storage.write(Welcome.MARKER, "seen")
    end

    if session.Closing and raw >= 0.995 then
        app:finishWelcome(fullPos, fullScale / dpi)
        return false
    end
    return true
end

return Welcome
end
modules["ui/widgets"] = function(...)

local import: (string) -> any = ...
local Canvas: typeof(require("../render/canvas")) = import("render/canvas")
local Color: typeof(require("../core/color")) = import("core/color")
local Hits: typeof(require("./hits")) = import("ui/hits")
local Motion: typeof(require("./motion")) = import("ui/motion")
local Painter: typeof(require("./painter")) = import("ui/painter")

local Widgets = {}

export type Fx = {

    Alpha: number,

    Scale: number,
}

type App = { [string]: any }
type Spec = { [string]: any }

Widgets.HEIGHTS = { toggle = 40, slider = 50, button = 36, dropdown = 36, bindrow = 30 }
Widgets.GAP = 4

local Z_BG, Z_TEXT, Z_CONTROL, Z_CONTROL_TEXT = 5, 6, 7, 8
local BIND_WIDTH, BIND_HEIGHT = 58, 22
local SWITCH_WIDTH, SWITCH_HEIGHT = 42, 22
local KNOB = 16

local function anim(spec: Spec, name: string): number
    local values = spec.Anim
    if not values then
        values = {}
        spec.Anim = values
    end
    return values[name] or 0
end

local function setAnim(spec: Spec, name: string, value: number)
    spec.Anim[name] = value
end

local function easeTo(app: App, spec: Spec, name: string, goal: number, speed: number): number
    local value = Motion.ease(app.State, anim(spec, name), goal, app.Dt, speed)
    setAnim(spec, name, value)
    return value
end

local function clamp01(value: number): number

    local t = math.clamp(value, 0, 1)
    return t
end

local function disabledMix(app: App, color: Color3, disabled: number): Color3
    return Color.lerp(color, app.Pal.Main, disabled)
end

local function springTo(app: App, spec: Spec, name: string, goal: number, response: number, ratio: number): number
    local bag = spec.Spr
    if not bag then
        bag = {}
        spec.Spr = bag
    end
    return Motion.spring(app.State, bag, name, goal, app.Dt, response, ratio)
end

local function pressScale(app: App, spec: Spec, name: string, key: any, shrink: number): number
    local goal = if Hits.isPressed(key) and app.HoverKey == key then 1 else 0
    local value = springTo(app, spec, name, goal, 0.26, 0.5)
    return 1 - shrink * math.clamp(value, -0.6, 1.2)
end

local function shrinkBox(position: Vector2, size: Vector2, scale: number): (Vector2, Vector2)
    local smaller = size * scale
    return position + (size - smaller) / 2, smaller
end

local function region(app: App, key: any, position: Vector2, size: Vector2, click: (() -> ())?, drag: ((Vector2) -> ())?)
    if app.Modal then
        return
    end
    Hits.add({ key = key, position = position, size = size, click = click, drag = drag })
end

local function isDisabled(app: App, spec: Spec): boolean
    if spec.gated and app.State.HitboxEnabled ~= true then
        return true
    end
    local rule = spec.disabled
    return rule ~= nil and rule(app.State, app) == true
end

local function drawSwitch(app: App, spec: Spec, boxPos: Vector2, boxSize: Vector2, scale: number, fx: Fx, disabled: number, hover: number)
    local pal = app.Pal
    local on = spec.state and app.State[spec.state] == true
    local value = springTo(app, spec, "on", if on then 1 else 0, 0.34, 0.6)
    local shown = clamp01(value)
    local size = app:size(SWITCH_WIDTH, SWITCH_HEIGHT) * scale
    local position = boxPos + Vector2.new(boxSize.X - 52 * scale * app.Unit, (boxSize.Y - size.Y) / 2)
    local track = Color.lerp(pal.Off, Color.lighten(pal.Accent, 0.25 * clamp01(hover)), shown)
    local round = math.clamp(tonumber(app.State.ToggleRoundness) or 0.55, 0, 1)
    Painter.rect(position, size, disabledMix(app, track, disabled), app.Alpha.Btn * fx.Alpha, Z_CONTROL, size.Y * 0.5 * round, true)

    local bounce = easeTo(app, spec, "bounce", 0, 13 * Motion.intensity(app.State))
    local held = springTo(app, spec, "held", if Hits.isPressed(spec.id) and app.HoverKey == spec.id then 1 else 0, 0.22, 0.8)
    local travel = math.abs(Motion.velocity(spec.Spr, "on"))
    local knobHeight = KNOB * scale * app.Unit * (1 + bounce * 0.22)
    local knobWidth = knobHeight * (1 + math.min(travel * 0.07, 0.35) + 0.18 * clamp01(held))
    local pad = 2 * scale * app.Unit
    local room = size.X - knobHeight - pad * 2
    local knobX = position.X + pad + room * value - (knobWidth - knobHeight) * value
    local knobColor = Color.lerp(Color.lerp(pal.Sub, pal.Main, shown), pal.Disabled, disabled)
    Painter.rect(Vector2.new(knobX, position.Y + (size.Y - knobHeight) / 2), Vector2.new(knobWidth, knobHeight), knobColor, app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, knobHeight * 0.5 * round, true)

    if shown > 0.02 and app.State.PremiumEffects and not app.State.HighPerformanceMode then
        Canvas.circle(position + size / 2, (12 + bounce * 5) * app.Unit, pal.Accent, app.Alpha.Text * 0.12 * shown, 1)
    end
end

local function drawBind(app: App, spec: Spec, boxPos: Vector2, boxSize: Vector2, scale: number, fx: Fx, disabled: number)
    local pal = app.Pal
    local key = spec.id .. ":bind"
    local size = app:size(BIND_WIDTH, BIND_HEIGHT) * scale
    local position = boxPos + Vector2.new(boxSize.X - 120 * scale * app.Unit, (boxSize.Y - size.Y) / 2)
    local hovered = app.HoverKey == key
    local hover = easeTo(app, spec, "bindHover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "bindPress", key, 0.05)
    local pressedPos, pressedSize = shrinkBox(position, size, press)
    local capture = app.Focus == app.BIND_PREFIX .. spec.state
    local fill = Color.lerp(Color.lerp(pal.Main, pal.Accent, 0.18 * clamp01(hover)), Color.lerp(pal.Main, pal.Disabled, 0.4), disabled)
    Painter.rect(pressedPos, pressedSize, fill, app.Alpha.Btn * fx.Alpha, Z_CONTROL, 10)
    local label = if capture then "press..." else app:shortKey(app.State.OptionKeybinds[spec.state])
    local textColor = if capture then pal.Accent else Color.lerp(pal.Sub, pal.Accent, 0.35 * clamp01(hover))
    Painter.text(label, pressedPos + pressedSize / 2, 11 * app.TextScale, textColor, app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, true, true)
    region(app, key, position, size, function()
        local focus = app.BIND_PREFIX .. spec.state
        app.Focus = if app.Focus == focus then nil else focus
    end, nil)
end

local function drawSideButton(app: App, spec: Spec, boxPos: Vector2, width: number, height: number, scale: number, fx: Fx, disabled: number)
    local pal = app.Pal
    local side = spec.side
    local sideKey = spec.id .. ":side"
    local position = boxPos + Vector2.new((width - (side.width or height)) * app.Unit, 0)
    local size = app:size(side.width or height, height) * scale
    local hovered = app.HoverKey == sideKey
    local hover = easeTo(app, spec, "sideHover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "sidePress", sideKey, 0.05)
    local p, s = shrinkBox(position, size, press)
    Painter.rect(p, s, Color.lerp(pal.Panel, pal.Accent, 0.15 * clamp01(hover)), app.Alpha.Btn * fx.Alpha * app:sourceFade(sideKey), Z_CONTROL, 10)
    local sideColor = Color.lerp(pal.Text, pal.Disabled, disabled)
    local labelAlpha = app.Alpha.Text * fx.Alpha * app:sourceFade(sideKey)
    if side.label == "?" then

        local unit = app.Unit * press
        local center = p + s / 2
        local radius = 8.5 * unit
        Painter.rect(center - Vector2.new(radius, radius), Vector2.new(radius * 2, radius * 2), sideColor, labelAlpha * 0.22, Z_CONTROL, 1000, true)
        local stem = Vector2.new(math.max(2, 2 * unit), 5.5 * unit)
        Painter.rect(center + Vector2.new(-stem.X / 2, -1.2 * unit), stem, sideColor, labelAlpha, Z_CONTROL_TEXT, stem.X * 0.5, true)
        local dot = math.max(2, 2 * unit)
        Painter.rect(center + Vector2.new(-dot / 2, -4.6 * unit), Vector2.new(dot, dot), sideColor, labelAlpha, Z_CONTROL_TEXT, dot * 0.5, true)
    else
        Painter.text(side.label, p + s / 2, (if side.small then 11 else 14) * app.TextScale, sideColor, labelAlpha, Z_CONTROL_TEXT, true, true)
    end
    region(app, sideKey, position, size, function()
        app:rememberClick(position, size, sideKey)
        side.onClick(app)
    end, nil)
end

local function mainWidth(spec: Spec, width: number, height: number): number
    if spec.side then
        return width - ((spec.side.width or height) + 6)
    end
    return width
end

function Widgets.toggle(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local height = Widgets.HEIGHTS.toggle
    local disabledGoal = if isDisabled(app, spec) then 1 else 0
    local disabled = easeTo(app, spec, "disabled", disabledGoal, 12)
    local mainW = mainWidth(spec, width, height)
    local key = spec.id
    local position = app:pos(x, y)
    local size = app:size(mainW, height)
    local hovered = app.HoverKey == key and disabledGoal == 0
    local hover = easeTo(app, spec, "hover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "press", key, 0.04) * fx.Scale
    local p, s = shrinkBox(position, size, press)

    local fade = app:sourceFade(key)
    local bg = Color.lerp(Color.lerp(pal.Panel, pal.Accent, 0.15 * clamp01(hover)), pal.Main, disabled)
    Painter.rect(p, s, bg, app.Alpha.Btn * fx.Alpha * fade, Z_BG, 16)
    Painter.text(spec.text, p + Vector2.new(12 * app.Unit * press, s.Y / 2), 14 * app.TextScale, Color.lerp(pal.Text, pal.Disabled, disabled), app.Alpha.Text * fx.Alpha * fade, Z_TEXT, false, true)
    drawSwitch(app, spec, p, s, press, fx, disabled, hover)
    if disabledGoal == 0 then
        region(app, key, position, size, function()
            app:rememberClick(position, size, key)
            app:toggle(spec)
        end, nil)
    end
    if spec.bindable then
        drawBind(app, spec, p, s, press, fx, disabled)
    end
    if spec.side then
        drawSideButton(app, spec, app:pos(x, y), width, height, 1, fx, disabled)
    end
end

local function sliderValue(spec: Spec, trackPos: Vector2, trackSize: Vector2, mouse: Vector2): number
    local fraction = math.clamp((mouse.X - trackPos.X) / math.max(0.001, trackSize.X), 0, 1)
    local value = spec.min + (spec.max - spec.min) * fraction
    if spec.float then
        return math.floor(value * 100) / 100
    end
    return math.floor(value)
end

function Widgets.slider(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local state = app.State
    local height = Widgets.HEIGHTS.slider
    local disabledGoal = if isDisabled(app, spec) then 1 else 0
    local disabled = easeTo(app, spec, "disabled", disabledGoal, 12)
    local key = spec.id
    local position = app:pos(x, y)
    local size = app:size(width, height)
    local hovered = app.HoverKey == key and disabledGoal == 0
    local hover = easeTo(app, spec, "hover", if hovered then 1 else 0, 16)
    local scale = fx.Scale
    local p, s = shrinkBox(position, size, scale)
    local unit = app.Unit

    Painter.rect(p, s, Color.lerp(pal.Panel, pal.Main, disabled), app.Alpha.Btn * fx.Alpha, Z_BG, 16)
    local label = spec.text
    if spec.label then
        label = spec.label(state)
    end
    local textColor = Color.lerp(pal.Text, pal.Disabled, disabled)
    Painter.text(label, p + Vector2.new(14 * unit, 7 * unit * scale), 14 * app.TextScale * scale, textColor, app.Alpha.Text * fx.Alpha, Z_TEXT)

    local value: number = state[spec.state]
    local held = Hits.isDragging(key)
    local fraction = springTo(app, spec, "fill", math.clamp((value - spec.min) / math.max(0.1, spec.max - spec.min), 0, 1), if held then 0.12 else 0.30, if held then 1 else 0.78)
    local trackPos = p + Vector2.new(14 * unit * scale, 36 * unit * scale)
    local trackSize = Vector2.new((width - 92) * unit * scale, 5 * unit * scale)
    Painter.rect(trackPos, trackSize, pal.Main, app.Alpha.Text * fx.Alpha, Z_CONTROL, 8)
    local fillColor = Color.lerp(Color.lighten(pal.Accent, 0.25 * clamp01(hover)), pal.Disabled, disabled)
    Painter.rect(trackPos, Vector2.new(math.max(1, trackSize.X * clamp01(fraction)), trackSize.Y), fillColor, app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, 8)

    local near = springTo(app, spec, "near", if hovered or held then 1 else 0, 0.28, 0.7)
    local grab = springTo(app, spec, "grab", if held then 1 else 0, 0.22, 0.6)
    local tip = trackPos + Vector2.new(trackSize.X * clamp01(fraction), trackSize.Y / 2)
    local thumb = (7 + 3 * near + 3 * grab) * unit * scale
    Painter.rect(tip - Vector2.new(thumb / 2, thumb / 2), Vector2.new(thumb, thumb), Color.lerp(Color.lighten(pal.Accent, 0.55), pal.Disabled, disabled), app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, 16)
    if state.PremiumEffects and near > 0.02 and not state.HighPerformanceMode then
        Canvas.circle(tip, (8 + 3 * grab) * unit, pal.Accent, app.Alpha.Text * 0.22 * fx.Alpha * clamp01(near), 1)
    end

    local boxKey = key .. ":value"
    local boxPos = app:pos(x + width - 58, y + 20)
    local boxSize = app:size(46, 22)
    local boxHover = easeTo(app, spec, "valueHover", if app.HoverKey == boxKey and disabledGoal == 0 then 1 else 0, 16)
    local boxPress = pressScale(app, spec, "valuePress", boxKey, 0.06)
    local bp, bs = shrinkBox(boxPos, boxSize, boxPress * scale)
    Painter.rect(bp, bs, Color.lerp(Color.lerp(pal.Main, pal.Accent, 0.15 * clamp01(boxHover)), pal.Main, disabled), app.Alpha.Btn * fx.Alpha, Z_CONTROL, 12)
    local shown
    if app.Focus == spec.state then
        shown = (app.Buffers[spec.state] or "") .. "|"
    elseif spec.float then
        shown = string.format("%.2f", value)
    else
        shown = tostring(value)
    end
    Painter.text(shown, bp + bs / 2, 14 * app.TextScale * boxPress, textColor, app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, true, true)

    if disabledGoal == 0 then
        region(app, boxKey, boxPos, boxSize, function()
            app:rememberClick(boxPos, boxSize, boxKey)
            app:beginInput(spec.state, tostring(state[spec.state]))
        end, nil)
        local grabPos = trackPos - Vector2.new(10 * unit, 15 * unit)
        local grabSize = trackSize + Vector2.new(20 * unit, 30 * unit)
        region(app, key, grabPos, grabSize, nil, function(mouse)
            app:setValue(spec, sliderValue(spec, trackPos, trackSize, mouse))
        end)
    end
end

function Widgets.button(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local height = Widgets.HEIGHTS.button
    local disabledGoal = if isDisabled(app, spec) then 1 else 0
    local disabled = easeTo(app, spec, "disabled", disabledGoal, 12)
    local mainW = mainWidth(spec, width, height)
    local key = spec.id
    local position = app:pos(x, y)
    local size = app:size(mainW, height)
    local hovered = app.HoverKey == key and disabledGoal == 0
    local hover = easeTo(app, spec, "hover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "press", key, 0.04) * fx.Scale
    local p, s = shrinkBox(position, size, press)
    local fade = app:sourceFade(key)

    local base = Color.lerp(pal.Panel, pal.Accent, 0.25 * clamp01(hover))
    local textColor = Color.lerp(pal.Text, pal.Disabled, disabled)
    local open = spec.accordion and app.State[spec.accordion.state] == spec.accordion.value
    if spec.accordion then
        local value = easeTo(app, spec, "open", if open then 1 else 0, 16 * Motion.speed(app.State))
        base = Color.lerp(Color.lerp(pal.Panel, pal.Accent, 0.11 * clamp01(hover)), Color.lerp(pal.Panel, pal.Accent, 0.30), clamp01(value))
        textColor = Color.lerp(pal.Text, pal.Accent, 0.72 * clamp01(value))
    end

    local label = spec.text
    if spec.input then
        if app.Focus == spec.input then
            base = pal.Off
        end
        label = if spec.inputText then spec.inputText(app) else app:inputText(spec.input, spec.text)
    elseif spec.label then
        label = spec.label(app)
    end
    Painter.rect(p, s, Color.lerp(base, pal.Main, disabled), app.Alpha.Btn * fx.Alpha * fade, Z_BG, 16)
    if spec.align == "left" then
        Painter.text(label, p + Vector2.new(12 * app.Unit * press, s.Y / 2), 14 * app.TextScale, textColor, app.Alpha.Text * fx.Alpha * fade, Z_TEXT, false, true)
    else
        Painter.text(label, p + s / 2, 14 * app.TextScale, textColor, app.Alpha.Text * fx.Alpha * fade, Z_TEXT, true, true)
    end
    if spec.side then
        drawSideButton(app, spec, app:pos(x, y), width, height, 1, fx, disabled)
    end
    if disabledGoal == 0 then
        region(app, key, position, size, function()
            app:rememberClick(position, size, key)
            if spec.input then
                app:beginInput(spec.input, "")
            end
            if spec.onClick then
                spec.onClick(app, position, size)
            end
        end, nil)
    end
end

function Widgets.dropdown(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local height = Widgets.HEIGHTS.dropdown
    local disabledGoal = if isDisabled(app, spec) then 1 else 0
    local disabled = easeTo(app, spec, "disabled", disabledGoal, 12)
    local key = spec.id
    local position = app:pos(x, y)
    local size = app:size(mainWidth(spec, width, height), height)
    local hovered = app.HoverKey == key and disabledGoal == 0
    local hover = easeTo(app, spec, "hover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "press", key, 0.04) * fx.Scale
    local p, s = shrinkBox(position, size, press)
    local unit = app.Unit
    local textColor = Color.lerp(pal.Text, pal.Disabled, disabled)

    Painter.rect(p, s, Color.lerp(pal.Panel, pal.Accent, 0.15 * clamp01(hover)), app.Alpha.Btn * fx.Alpha, Z_BG, 16)
    Painter.text(spec.text .. ": " .. tostring(app.State[spec.state]), p + Vector2.new(12 * unit * press, s.Y / 2), 14 * app.TextScale, textColor, app.Alpha.Text * fx.Alpha, Z_TEXT, false, true)

    local arrowColor = Color.lerp(pal.Sub, pal.Disabled, disabled)
    local arrowAlpha = app.Alpha.Text * fx.Alpha
    local arrowCenter = p + Vector2.new(s.X - 16 * unit * press, s.Y / 2)
    local arm = 4 * unit * press
    if arrowAlpha > 0.02 and not app.Modal then
        Canvas.line(arrowCenter + Vector2.new(-arm, -arm * 0.5), arrowCenter + Vector2.new(0, arm * 0.5), arrowColor, arrowAlpha, math.max(1.5, 1.6 * unit))
        Canvas.line(arrowCenter + Vector2.new(0, arm * 0.5), arrowCenter + Vector2.new(arm, -arm * 0.5), arrowColor, arrowAlpha, math.max(1.5, 1.6 * unit))
    end

    if app.OpenDropdown == spec then
        app.DropdownBox = { Position = position, Size = size }
    end
    if disabledGoal == 0 then
        region(app, key, position, size, function()
            app:rememberClick(position, size, key)
            app:toggleDropdown(spec)
        end, nil)
    end
    if spec.side then
        drawSideButton(app, spec, app:pos(x, y), width, height, 1, fx, disabled)
    end
end

function Widgets.text(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local size = spec.size or 13
    local color = if spec.accent then pal.Accent else pal.Sub
    local label = spec.text
    if spec.label then
        label = spec.label(app)
    end
    if spec.center then
        local center = app:pos(x + width / 2, y + (spec.height or 23) / 2)
        Painter.text(label, center, size * app.TextScale * fx.Scale, color, app.Alpha.Text * fx.Alpha, Z_TEXT, true, true)
    else
        Painter.text(label, app:pos(x + 10, y + (spec.height or 23) / 2), size * app.TextScale * fx.Scale, color, app.Alpha.Text * fx.Alpha, Z_TEXT, false, true)
    end
end

local function fitText(text: string, size: number, limit: number): string
    if Painter.textWidth(text, size) <= limit then
        return text
    end
    local cut = #text
    while cut > 1 and Painter.textWidth(string.sub(text, 1, cut) .. "..", size) > limit do
        cut -= 1
    end
    return string.sub(text, 1, cut) .. ".."
end

function Widgets.bindrow(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local entry = app:boundOptions()[spec.index]
    if not entry then
        return
    end
    local pal = app.Pal
    local unit = app.Unit
    local height = Widgets.HEIGHTS.bindrow
    local position = app:pos(x, y)
    local size = app:size(width, height)
    local chipKey = spec.id .. ":bind"
    local chipSize = app:size(BIND_WIDTH, BIND_HEIGHT)
    local chipPosition = position + Vector2.new(size.X - chipSize.X - 8 * unit, (size.Y - chipSize.Y) / 2)
    local hovered = app.HoverKey == chipKey
    local hover = easeTo(app, spec, "bindHover", if hovered then 1 else 0, 16)
    local press = pressScale(app, spec, "bindPress", chipKey, 0.05)
    local pressedPosition, pressedSize = shrinkBox(chipPosition, chipSize, press)
    local focus = app.BIND_PREFIX .. entry.State
    local capture = app.Focus == focus
    Painter.rect(position, size, Color.lerp(pal.Panel, pal.Accent, 0.06), app.Alpha.Btn * fx.Alpha, Z_BG, 16)
    local name = fitText(tostring(entry.Name), 13 * app.TextScale, size.X - chipSize.X - 28 * unit)
    Painter.text(name, position + Vector2.new(12 * unit, size.Y / 2), 13 * app.TextScale, pal.Text, app.Alpha.Text * fx.Alpha, Z_TEXT, false, true)
    Painter.rect(pressedPosition, pressedSize, Color.lerp(pal.Main, pal.Accent, 0.18 * clamp01(hover)), app.Alpha.Btn * fx.Alpha, Z_CONTROL, 10)
    local label = if capture then "press..." else app:shortKey(entry.Key)
    local textColor = if capture then pal.Accent else Color.lerp(pal.Sub, pal.Accent, 0.35 * clamp01(hover))
    Painter.text(label, pressedPosition + pressedSize / 2, 11 * app.TextScale, textColor, app.Alpha.Text * fx.Alpha, Z_CONTROL_TEXT, true, true)
    region(app, chipKey, chipPosition, chipSize, function()
        app.Focus = if app.Focus == focus then nil else focus
    end, nil)
end

function Widgets.chips(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local pal = app.Pal
    local unit = app.Unit
    local alpha = fx.Alpha
    local middle = app:pos(x + width / 2, y + 10)
    local titleSize = 12 * app.TextScale
    local titleWidth = Painter.textWidth(spec.text, titleSize)
    Painter.text(spec.text, middle, titleSize, pal.Accent, app.Alpha.Text * alpha, Z_TEXT, true, true)
    local gap = 14 * unit
    local length = math.max(0, math.min(90 * unit, width * unit / 2 - titleWidth / 2 - gap * 2))
    Painter.rect(Vector2.new(middle.X - titleWidth / 2 - gap - length, middle.Y), Vector2.new(length, math.max(1, unit)), pal.Off, app.Alpha.UI * alpha * 0.9, Z_BG, 0)
    Painter.rect(Vector2.new(middle.X + titleWidth / 2 + gap, middle.Y), Vector2.new(length, math.max(1, unit)), pal.Off, app.Alpha.UI * alpha * 0.9, Z_BG, 0)
    local chipHeight = 24 * unit
    local chipGap = 8 * unit
    local textSize = 12 * app.TextScale
    for rowIndex, row in spec.rows do
        local widths: { number } = {}
        local total = -chipGap
        for index, name in row do
            widths[index] = Painter.textWidth(name, textSize) + 30 * unit
            total += widths[index] + chipGap
        end
        local rowY = app:pos(0, y + 30 + (rowIndex - 1) * 32).Y
        local cursor = middle.X - total / 2
        for index, name in row do
            local chipPosition = Vector2.new(cursor, rowY)
            local chipSize = Vector2.new(widths[index], chipHeight)
            Painter.rect(chipPosition - Vector2.new(1, 1), chipSize + Vector2.new(2, 2), pal.Off, app.Alpha.Btn * alpha * 0.8, Z_BG - 1, 14)
            Painter.rect(chipPosition, chipSize, Color.lerp(pal.Panel, pal.Accent, 0.10), app.Alpha.Btn * alpha, Z_BG, 14)
            Painter.text(name, chipPosition + Vector2.new(15 * unit, chipHeight / 2), textSize, pal.Text, app.Alpha.Text * alpha, Z_TEXT, false, true)
            cursor += widths[index] + chipGap
        end
    end
end

function Widgets.heightOf(spec: Spec): number
    if spec.kind == "text" or spec.kind == "chips" then
        return spec.height or 23
    end
    return Widgets.HEIGHTS[spec.kind] or 36
end

function Widgets.draw(app: App, spec: Spec, x: number, y: number, width: number, fx: Fx)
    local kind = spec.kind
    if kind == "toggle" then
        Widgets.toggle(app, spec, x, y, width, fx)
    elseif kind == "slider" then
        Widgets.slider(app, spec, x, y, width, fx)
    elseif kind == "button" then
        Widgets.button(app, spec, x, y, width, fx)
    elseif kind == "dropdown" then
        Widgets.dropdown(app, spec, x, y, width, fx)
    elseif kind == "text" then
        Widgets.text(app, spec, x, y, width, fx)
    elseif kind == "bindrow" then
        Widgets.bindrow(app, spec, x, y, width, fx)
    elseif kind == "chips" then
        Widgets.chips(app, spec, x, y, width, fx)
    end
end

return Widgets
end
-- vehicle
modules["vehicle/fleet"] = function(...)

local import: (string) -> any = ...
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")

local Fleet = {}
Fleet.__index = Fleet

type Car = {
    Main: any,
    Min: Vector3,
    Max: Vector3,
    World: boolean,
    Seats: { any },
    Born: number,
    NextMeasure: number,
}

export type Config = {
    LocalPlayer: any,
    GetPlayers: () -> { any },

    OnSpawn: ((position: Vector3) -> ())?,
}

local TICK = 0.03
local GRID_INTERVAL = 0.05
local SEATED_INTERVAL = 0.05
local IDENTIFY_INTERVAL = 0.1
local SEATED_MEMORY = 0.2

local SIT_REACH = 14
local HOLD_SECONDS = 0.35
local LOOKAHEAD_SECONDS = 0.4
local MAX_LOOKAHEAD = 8
local CELL_SIZE = 48

local SIDE_MARGIN = 3
local HEIGHT_MARGIN = 8
local MAX_CARS = 160
local MAX_PARTS = 200
local MAX_SEATS = 16

local MAX_EXTENT = 90

local YOUNG_SECONDS = 4
local YOUNG_INTERVAL = 0.5
local OLD_INTERVAL = 10
local MAIN_NAMES = { "main", "chassis", "body", "hull", "base", "root", "frame" }

function Fleet.new(config: Config)
    local self = {
        LocalPlayer = config.LocalPlayer,
        GetPlayers = config.GetPlayers,
        OnSpawn = config.OnSpawn,
        Cars = Util.newWeakKeyed() :: { [any]: Car },
        CarCount = 0,
        Grid = {} :: { [number]: { [number]: { Car } } },
        Holds = Util.newWeakKeyed() :: { [any]: number },

        Seated = Util.newWeakKeyed() :: { [any]: number },

        Occupants = Util.newWeakKeyed() :: { [any]: any },
        NextIdentify = Util.newWeakKeyed() :: { [any]: number },
        NextGrid = 0,
        NextSeated = 0,
        Running = false,
        Generation = 0,

        Scan = nil :: ((now: number) -> number?)?,
        Reset = nil :: (() -> ())?,
        Report = nil :: (() -> (string?, boolean))?,
    }
    return setmetatable(self, Fleet)
end

type Self = typeof(Fleet.new(nil :: any))

local function toLocal(frame: any, point: Vector3): Vector3
    local origin, right, up, look = frame.Position, frame.RightVector, frame.UpVector, frame.LookVector
    local x, y, z = point.X - origin.X, point.Y - origin.Y, point.Z - origin.Z
    return Vector3.new(
        x * right.X + y * right.Y + z * right.Z,
        x * up.X + y * up.Y + z * up.Z,
        x * look.X + y * look.Y + z * look.Z
    )
end

local function directionToLocal(frame: any, direction: Vector3): Vector3
    local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
    return Vector3.new(
        direction.X * right.X + direction.Y * right.Y + direction.Z * right.Z,
        direction.X * up.X + direction.Y * up.Y + direction.Z * up.Z,
        direction.X * look.X + direction.Y * look.Y + direction.Z * look.Z
    )
end

local function isSeat(object: any): boolean
    local className = Parts.className(object)
    return className == "VehicleSeat" or className == "Seat"
end

local function gather(model: any): ({ any }, { any })
    local ok, list = pcall(function()
        return model:GetDescendants()
    end)
    local found: { any } = {}
    local seats: { any } = {}
    if not ok or type(list) ~= "table" then
        return found, seats
    end
    for index = 1, #list do
        local object = list[index]
        if #seats < MAX_SEATS and isSeat(object) then
            seats[#seats + 1] = object
        end
        if #found < MAX_PARTS and Parts.valid(object) then
            found[#found + 1] = object
        end
    end
    return found, seats
end

local function mainOf(found: { any }): any
    local best, bestScore = nil, -math.huge
    for _, part in found do
        local name = string.lower(tostring(Util.read(part, "Name") or ""))
        local size = Util.read(part, "Size")
        local score = if size then size.X * size.Y * size.Z else 0
        for _, word in MAIN_NAMES do
            if name == word then
                score += 1e9
            end
        end
        if score > bestScore then
            best, bestScore = part, score
        end
    end
    return best
end

local function measure(model: any, now: number, born: number, limit: number?): Car?
    local found, seats = gather(model)
    local main = mainOf(found)
    if not main then
        return nil
    end
    local frame = Util.read(main, "CFrame")
    local low = Vector3.new(math.huge, math.huge, math.huge)
    local high = Vector3.new(-math.huge, -math.huge, -math.huge)
    local world = false
    local ok = frame ~= nil and pcall(function()
        for _, part in found do
            local own, size = Util.read(part, "CFrame"), Util.read(part, "Size")
            if own and size then
                local center = toLocal(frame, own.Position)

                local right = directionToLocal(frame, own.RightVector)
                local up = directionToLocal(frame, own.UpVector)
                local look = directionToLocal(frame, own.LookVector)
                local reachX = (math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(look.X) * size.Z) * 0.5
                local reachY = (math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(look.Y) * size.Z) * 0.5
                local reachZ = (math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(look.Z) * size.Z) * 0.5
                low = Vector3.new(math.min(low.X, center.X - reachX), math.min(low.Y, center.Y - reachY), math.min(low.Z, center.Z - reachZ))
                high = Vector3.new(math.max(high.X, center.X + reachX), math.max(high.Y, center.Y + reachY), math.max(high.Z, center.Z + reachZ))
            end
        end
    end)
    if not ok or low.X == math.huge then

        world = true
        low = Vector3.new(math.huge, math.huge, math.huge)
        high = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, part in found do
            local position, size = Util.read(part, "Position"), Util.read(part, "Size")
            if position and size then
                local reach = math.max(size.X, size.Z) * 0.5
                local up = size.Y * 0.5
                low = Vector3.new(math.min(low.X, position.X - reach), math.min(low.Y, position.Y - up), math.min(low.Z, position.Z - reach))
                high = Vector3.new(math.max(high.X, position.X + reach), math.max(high.Y, position.Y + up), math.max(high.Z, position.Z + reach))
            end
        end
        if low.X == math.huge then
            return nil
        end
    end
    if math.max(high.X - low.X, high.Z - low.Z) > (limit or MAX_EXTENT) then
        return nil
    end
    local interval = if now - born < YOUNG_SECONDS then YOUNG_INTERVAL else OLD_INTERVAL
    return { Main = main, Min = low, Max = high, World = world, Seats = seats, Born = born, NextMeasure = now + interval }
end

function Fleet.track(self: Self, model: any): boolean
    if self.Cars[model] then
        return true
    end
    if self.CarCount >= MAX_CARS then
        return true
    end
    local now = os.clock()
    local car = measure(model, now, now)
    if not car then
        return false
    end
    self.Cars[model] = car
    self.CarCount += 1
    self.NextGrid = 0
    if self.OnSpawn then
        local position = Util.read(car.Main, "Position")
        if position then
            pcall(self.OnSpawn, position)
        end
    end
    return true
end

function Fleet.extent(_self: Self, model: any): number?
    local car = measure(model, os.clock(), os.clock(), math.huge)
    if not car then
        return nil
    end
    return math.max(car.Max.X - car.Min.X, car.Max.Z - car.Min.Z)
end

local function cellOf(value: number): number
    return math.floor(value / CELL_SIZE)
end

local function rebuildGrid(self: Self, now: number)
    if now < self.NextGrid then
        return
    end
    self.NextGrid = now + GRID_INTERVAL
    local grid: { [number]: { [number]: { Car } } } = {}
    local gone = {}
    for model, car in self.Cars do
        if not Util.read(model, "Parent") then
            gone[#gone + 1] = model
        else
            if now >= car.NextMeasure then

                local again = measure(model, now, car.Born)
                if again then
                    self.Cars[model] = again
                    car = again
                else
                    car.NextMeasure = now + OLD_INTERVAL
                end
            end
            local position = Util.read(car.Main, "Position")
            if position then
                local x, z = cellOf(position.X), cellOf(position.Z)
                local column = grid[x]
                if not column then
                    column = {}
                    grid[x] = column
                end
                local bucket = column[z]
                if not bucket then
                    bucket = {}
                    column[z] = bucket
                end
                bucket[#bucket + 1] = car
            end
        end
    end
    for _, model in gone do
        self.Cars[model] = nil
        self.CarCount -= 1
    end
    self.Grid = grid
end

local function insideCar(car: Car, point: Vector3, margin: number?): boolean
    local side = margin or SIDE_MARGIN
    local height = if margin then margin else HEIGHT_MARGIN
    if car.World then
        return point.X >= car.Min.X - side and point.X <= car.Max.X + side
            and point.Z >= car.Min.Z - side and point.Z <= car.Max.Z + side
            and point.Y >= car.Min.Y - height and point.Y <= car.Max.Y + height
    end
    local frame = Util.read(car.Main, "CFrame")
    if not frame then
        return false
    end
    local inside = toLocal(frame, point)
    return inside.X >= car.Min.X - side and inside.X <= car.Max.X + side
        and inside.Z >= car.Min.Z - side and inside.Z <= car.Max.Z + side
        and inside.Y >= car.Min.Y - height and inside.Y <= car.Max.Y + height
end

local function nearCar(self: Self, point: Vector3): boolean
    local cx, cz = cellOf(point.X), cellOf(point.Z)
    for x = cx - 1, cx + 1 do
        local column = self.Grid[x]
        if column then
            for z = cz - 1, cz + 1 do
                local bucket = column[z]
                if bucket then
                    for _, car in bucket do
                        if insideCar(car, point, nil) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function closestPlayer(self: Self, car: Car, point: Vector3): any
    local best, bestSquared = nil, SIT_REACH * SIT_REACH
    local inside, insideSquared = nil, SIT_REACH * SIT_REACH
    for _, player in self.GetPlayers() do
        local character = Util.read(player, "Character")
        local root = if character then Util.child(character, "HumanoidRootPart") else nil
        local position = if root then Util.read(root, "Position") else nil
        if position then
            local squared = Util.distanceSquared(position, point)
            if squared <= bestSquared then
                best, bestSquared = character, squared
            end
            if squared <= insideSquared and insideCar(car, position, 0) then
                inside, insideSquared = character, squared
            end
        end
    end
    return inside or best
end

local function readSeated(self: Self, now: number)
    if now < self.NextSeated then
        return
    end
    self.NextSeated = now + SEATED_INTERVAL
    for _, car in self.Cars do
        for _, seat in car.Seats do
            if Util.child(seat, "SeatWeld") then
                local sitter = self.Occupants[seat]
                if not sitter and now >= (self.NextIdentify[seat] or 0) then
                    self.NextIdentify[seat] = now + IDENTIFY_INTERVAL
                    local at = Util.read(seat, "Position") or Util.read(car.Main, "Position")
                    if at then
                        sitter = closestPlayer(self, car, at)
                        self.Occupants[seat] = sitter
                    end
                end
                if sitter then
                    self.Seated[sitter] = now
                end
            else
                self.Occupants[seat] = nil
                self.NextIdentify[seat] = nil
            end
        end
    end
end

function Fleet.isSeated(self: Self, character: any): boolean
    local seen = self.Seated[character]
    return seen ~= nil and os.clock() - seen < SEATED_MEMORY
end

function Fleet.shouldProtect(self: Self, player: any, main: any, now: number): boolean
    if self.CarCount <= 0 then
        return false
    end
    local position = Util.read(main, "Position")
    if not position then
        return false
    end
    local near = nearCar(self, position)
    if not near then
        local velocity = Util.read(main, "Velocity")
        if velocity then
            local dx, dz = velocity.X * LOOKAHEAD_SECONDS, velocity.Z * LOOKAHEAD_SECONDS
            local travel = math.sqrt(dx * dx + dz * dz)
            if travel > 1 then
                local scale = math.min(1, MAX_LOOKAHEAD / travel)
                near = nearCar(self, Vector3.new(position.X + dx * scale, position.Y, position.Z + dz * scale))
            end
        end
    end
    if near then
        self.Holds[player] = now + HOLD_SECONDS
        return true
    end
    local hold = self.Holds[player]
    return hold ~= nil and now < hold
end

function Fleet.refresh(self: Self)
    self.NextGrid = 0
    rebuildGrid(self, os.clock())
end

function Fleet.hold(self: Self, player: any, untilTime: number)
    self.Holds[player] = math.max(self.Holds[player] or 0, untilTime)
end

function Fleet.status(self: Self): (string?, boolean)
    if self.Report then
        return self.Report()
    end
    return nil, false
end

function Fleet.start(self: Self)
    if self.Running then
        return
    end
    self.Generation += 1
    local generation = self.Generation
    self.Running = true
    task.spawn(function()
        while self.Running and self.Generation == generation do
            local now = os.clock()
            local wait: number = TICK
            if self.Scan then
                local ok, requested = pcall(self.Scan, now)
                if ok and type(requested) == "number" then
                    wait = requested
                end
            end
            pcall(rebuildGrid, self, now)
            pcall(readSeated, self, now)
            task.wait(wait)
        end
    end)
end

function Fleet.stop(self: Self)
    self.Generation += 1
    self.Running = false
    self.Cars = Util.newWeakKeyed()
    self.CarCount = 0
    self.Grid = {}
    self.Holds = Util.newWeakKeyed()
    self.Seated = Util.newWeakKeyed()
    self.Occupants = Util.newWeakKeyed()
    self.NextIdentify = Util.newWeakKeyed()
    if self.Reset then
        self.Reset()
    end
end

return Fleet
end
modules["vehicle/guard"] = function(...)

local import: (string) -> any = ...
local Fleet: typeof(require("./fleet")) = import("vehicle/fleet")
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Paths: typeof(require("../entities/paths")) = import("entities/paths")
local Storage: typeof(require("../core/storage")) = import("core/storage")
local Util: typeof(require("../core/util")) = import("core/util")

local Guard = {}

local DISCOVERY_SLICE = 0.004
local DISCOVERY_BATCH = 4000
local POLL_INTERVAL = 0.25
local ROOT_POLL = 0.25
local MAX_PRIORITY_QUEUE = 512
local ANCESTOR_DEPTH = 6
local FILE = Storage.ROOT .. "/vehicle_roots.json"

local PENDING_SECONDS = 3
local MAX_PENDING = 64
local SUBTREE_LIMIT = 4000
local RESOLVE_INTERVAL = 2
local WORLD_EVENT_LIMIT = 3000

local NOISE_LIMIT = 1500

local VEHICLE_EXTENT = 70
local DONE_SHOWN_SECONDS = 1.6

type Self = any

local function squash(name: string): string
    local lowered = string.lower(name)
    lowered = string.gsub(lowered, "[%s_%-%./\\]+", "")
    return lowered
end

local function endsWithAny(text: string, words: { string }): boolean
    for _, word in words do
        if #text >= #word and string.sub(text, -#word) == word then
            return true
        end
    end
    return false
end

local function vehicleName(name: string): boolean
    local text = squash(name)
    if string.find(text, "vehicle", 1, true) then
        return true
    end
    return endsWithAny(text, {
        "car", "cars", "truck", "jeep", "van", "bus", "buggy", "chassis", "motorcycle", "motorbike", "bike", "sedan", "cart",
        "boat", "ship", "plane", "heli", "helicopter", "tank", "taxi", "tractor", "kart", "atv", "quad", "skiff", "jet",
    })
end

local function isSeatClass(className: string): boolean
    return className == "VehicleSeat" or className == "Seat"
end

local function isVehicleSeat(seat: any, className: string, learned: { [any]: any }): boolean
    if className == "VehicleSeat" then
        return true
    end
    local current = Util.read(seat, "Parent")
    for _ = 1, ANCESTOR_DEPTH do
        if not current or current == workspace then
            return false
        end
        if vehicleName(tostring(Util.read(current, "Name") or "")) or learned[current] then
            return true
        end
        current = Util.read(current, "Parent")
    end
    return false
end

local function topRoot(object: any): any
    local current = object
    for _ = 1, 16 do
        local parent = Util.read(current, "Parent")
        if not parent or parent == workspace then
            return current
        end
        current = parent
    end
    return current
end

local function listOf(object: any, descendants: boolean): { any }
    local ok, list = pcall(function()
        return if descendants then object:GetDescendants() else object:GetChildren()
    end)
    return if ok and type(list) == "table" then list else {}
end

local function vehicleOf(self: Self, seat: any): (any, boolean)
    local candidates = {}
    local current = Util.read(seat, "Parent")
    for _ = 1, ANCESTOR_DEPTH do
        if not current or current == workspace or Parts.className(current) ~= "Model" then
            break
        end
        candidates[#candidates + 1] = current
        current = Util.read(current, "Parent")
    end
    if #candidates == 0 then
        local parent = Util.read(seat, "Parent")
        if parent and parent ~= workspace then
            candidates[1] = parent
        end
    end
    local measured = false
    for index = #candidates, 1, -1 do
        local extent = Fleet.extent(self, candidates[index])
        if extent then
            measured = true
            if extent <= VEHICLE_EXTENT then
                return candidates[index], false
            end
        end
    end
    return nil, not measured
end

local function enqueue(self: Self, object: any, priority: boolean)
    if self.Seen[object] then
        return
    end
    self.Seen[object] = true
    if priority then
        if self.PriorityTail - self.PriorityHead < MAX_PRIORITY_QUEUE then
            self.PriorityTail += 1
            self.PriorityQueue[self.PriorityTail] = object
        end
    else
        self.QueueTail += 1
        self.Queue[self.QueueTail] = object
    end
end

local function loadSaved(self: Self)
    local data = Storage.readJson(FILE)
    local list = if type(data) == "table" then data[tostring(game.PlaceId)] else nil
    self.SavedPaths = {}
    if type(list) == "table" then
        for _, path in list do
            if type(path) == "string" and path ~= "" then
                self.SavedPaths[#self.SavedPaths + 1] = path
            end
        end
    end
end

local function saveRoots(self: Self)
    local data = Storage.readJson(FILE)
    if type(data) ~= "table" then
        data = {}
    end
    data[tostring(game.PlaceId)] = self.SavedPaths
    Storage.ensureFolder(Storage.ROOT)
    Storage.writeJson(FILE, data)
end

local onAdded: (self: Self, object: any) -> ()

local function watchRoot(self: Self, folder: any, path: string)
    if self.Watched[folder] then
        return
    end
    local record = { Path = path, Connection = nil :: any, Events = 0, Window = os.clock() }
    local ok, connection = pcall(function()
        return folder.DescendantAdded:Connect(function(object)
            local now = os.clock()
            if now - record.Window >= 1 then
                record.Window, record.Events = now, 0
            end
            record.Events += 1
            if record.Events > NOISE_LIMIT then

                pcall(function()
                    record.Connection:Disconnect()
                end)
                return
            end
            onAdded(self, object)
        end)
    end)
    if not ok or not connection then
        return
    end
    record.Connection = connection
    self.Watched[folder] = record
    self.PathWatched[path] = true
    enqueue(self, folder, true)
end

local function learnRoot(self: Self, seat: any)
    local top = topRoot(seat)
    if top == seat or self.Watched[top] or top == Util.read(self.LocalPlayer, "Character") then
        return
    end
    local count = (self.RootCounts[top] or 0) + 1
    self.RootCounts[top] = count
    if Parts.className(top) ~= "Folder" and count < 2 then
        return
    end
    local path = Paths.toText(top)
    if not path or path == "" then
        return
    end
    if not self.PathWatched[path] then
        self.SavedPaths[#self.SavedPaths + 1] = path
        saveRoots(self)
    end
    watchRoot(self, top, path)
end

local function tryRecord(self: Self, seat: any, className: string): boolean
    if self.BySeat[seat] then
        return true
    end
    if not isVehicleSeat(seat, className, self.Watched) then
        return true
    end
    local model, retry = vehicleOf(self, seat)
    if not model then
        return not retry
    end
    if Fleet.track(self, model) then
        self.BySeat[seat] = true
        learnRoot(self, seat)
        return true
    end
    return false
end

local function addPending(self: Self, seat: any, now: number)
    if #self.Pending < MAX_PENDING then
        self.Pending[#self.Pending + 1] = { Seat = seat, Deadline = now + PENDING_SECONDS }
    end
end

local function inspect(self: Self, object: any)
    local className = Parts.className(object)
    if isSeatClass(className) then
        if not self.SeatSet[object] then
            self.SeatSet[object] = true
            self.SeatCount += 1
        end
        if not tryRecord(self, object, className) then
            addPending(self, object, os.clock())
        end
    end
end

onAdded = function(self: Self, object: any)
    if isSeatClass(Parts.className(object)) then
        inspect(self, object)
    end
end

local function processPending(self: Self, now: number)
    for index = #self.Pending, 1, -1 do
        local item = self.Pending[index]
        local className = Parts.className(item.Seat)
        local gone = not Util.read(item.Seat, "Parent") or now > item.Deadline
        if gone or tryRecord(self, item.Seat, className) then
            self.Pending[index] = self.Pending[#self.Pending]
            self.Pending[#self.Pending] = nil
        end
    end
end

local function resolveSaved(self: Self, now: number)
    if now < self.NextResolve then
        return
    end
    self.NextResolve = now + RESOLVE_INTERVAL
    for _, path in self.SavedPaths do
        if not self.PathWatched[path] then
            local folder = Paths.resolve(path)
            if folder and folder ~= workspace then
                watchRoot(self, folder, path)
            end
        end
    end
end

local function inspectSubtree(self: Self, top: any)
    inspect(self, top)
    local list = listOf(top, true)
    for index = 1, math.min(#list, SUBTREE_LIMIT) do
        inspect(self, list[index])
    end
end

local function pollWatched(self: Self, now: number)
    if now < self.NextPoll then
        return
    end
    self.NextPoll = now + POLL_INTERVAL
    for folder in self.Watched do
        for _, child in listOf(folder, false) do
            if not self.Seen[child] then
                self.Seen[child] = true
                inspectSubtree(self, child)
            end
        end
    end
end

local function pollRoots(self: Self, now: number)
    if now < self.NextRootPoll then
        return
    end
    self.NextRootPoll = now + ROOT_POLL
    local localCharacter = Util.read(self.LocalPlayer, "Character")
    for _, child in listOf(workspace, false) do
        if child ~= localCharacter and not self.Seen[child] then
            enqueue(self, child, vehicleName(tostring(Util.read(child, "Name") or "")))
        end
    end
end

local function pop(queue: { any }, head: number): (any, number)
    local object = queue[head]
    queue[head] = nil
    return object, head + 1
end

local function discover(self: Self)
    local started = os.clock()
    local processed = 0
    while processed < DISCOVERY_BATCH and os.clock() - started < DISCOVERY_SLICE do
        local object
        if self.PriorityHead <= self.PriorityTail then
            object, self.PriorityHead = pop(self.PriorityQueue, self.PriorityHead)
        elseif self.QueueHead <= self.QueueTail then
            object, self.QueueHead = pop(self.Queue, self.QueueHead)
        else
            self.PriorityQueue, self.PriorityHead, self.PriorityTail = {}, 1, 0
            self.Queue, self.QueueHead, self.QueueTail = {}, 1, 0
            if not self.ScanDone and self.Walked > 0 then
                self.ScanDone = true
                self.DoneAt = os.clock()
            end
            return
        end
        processed += 1
        self.Walked += 1
        if object and Util.read(object, "Parent") then
            inspect(self, object)
            for _, child in listOf(object, false) do
                enqueue(self, child, vehicleName(tostring(Util.read(child, "Name") or "")))
            end
        end
    end
end

function Guard.new(config: any): Self
    local self: Self = Fleet.new(config)
    self.Seen = Util.newWeakKeyed()
    self.BySeat = Util.newWeakKeyed()
    self.SeatSet = Util.newWeakKeyed()
    self.SeatCount = 0
    self.PriorityQueue, self.PriorityHead, self.PriorityTail = {}, 1, 0
    self.Queue, self.QueueHead, self.QueueTail = {}, 1, 0

    self.Watched = {}

    self.SavedPaths = {}
    self.PathWatched = {}
    self.RootCounts = Util.newWeakKeyed()
    self.Pending = {}
    self.NextResolve, self.NextPoll, self.NextRootPoll = 0, 0, 0

    self.Walked = 0
    self.ScanDone = false
    self.DoneAt = 0
    self.WorkspaceConnection = nil
    self.WorldConnection = nil
    self.WorldEvents, self.WorldWindow = 0, 0

    self.Scan = function(now: number): number?
        resolveSaved(self, now)
        processPending(self, now)
        pollRoots(self, now)
        pollWatched(self, now)
        discover(self)
        return if self.ScanDone then nil else 0
    end

    self.Report = function(): (string?, boolean)
        if not self.ScanDone then
            return "scanning: " .. tostring(self.SeatCount) .. " seats", true
        end
        if os.clock() - self.DoneAt < DONE_SHOWN_SECONDS then
            return "complete! " .. tostring(self.CarCount) .. " vehicles tracked", false
        end
        return nil, false
    end

    local function release()
        for _, watched in self.Watched do
            pcall(function()
                watched.Connection:Disconnect()
            end)
        end
        for _, name in { "WorkspaceConnection", "WorldConnection" } do
            local connection = self[name]
            if connection then
                pcall(function()
                    connection:Disconnect()
                end)
            end
            self[name] = nil
        end
        self.Watched, self.PathWatched, self.SavedPaths = {}, {}, {}
        self.RootCounts = Util.newWeakKeyed()
        self.Pending = {}
        self.Seen = Util.newWeakKeyed()
        self.BySeat = Util.newWeakKeyed()
        self.SeatSet = Util.newWeakKeyed()
        self.SeatCount, self.Walked = 0, 0
        self.ScanDone = false
        self.PriorityQueue, self.PriorityHead, self.PriorityTail = {}, 1, 0
        self.Queue, self.QueueHead, self.QueueTail = {}, 1, 0
    end
    self.Reset = release

    local baseStart = Fleet.start
    local baseStop = Fleet.stop

    self.start = function(guard: Self)
        if guard.Running then
            return
        end
        loadSaved(guard)
        local generation = guard.Generation + 1

        local ok, connection = pcall(function()
            return workspace.ChildAdded:Connect(function(child)
                task.defer(function()
                    if guard.Running then
                        pcall(inspectSubtree, guard, child)
                    end
                end)
            end)
        end)
        if ok then
            guard.WorkspaceConnection = connection
        end

        local watching, worldConnection = pcall(function()
            return workspace.DescendantAdded:Connect(function(object)
                local now = os.clock()
                if now - guard.WorldWindow >= 1 then
                    guard.WorldWindow, guard.WorldEvents = now, 0
                end
                guard.WorldEvents += 1

                if guard.WorldEvents <= WORLD_EVENT_LIMIT and guard.Generation == generation then
                    onAdded(guard, object)
                end
            end)
        end)
        if watching then
            guard.WorldConnection = worldConnection
        end
        baseStart(guard)
    end

    self.stop = function(guard: Self)
        baseStop(guard)
    end
    return self
end

return Guard
end
