local import: (string) -> any = ...
local Keys: typeof(require("./keys")) = import("input/keys")

local Window = {}

local MOVEMENT_KEYS = {
    { Name = "W", Code = 0x57 },
    { Name = "A", Code = 0x41 },
    { Name = "S", Code = 0x53 },
    { Name = "D", Code = 0x44 },
    { Name = "Up", Code = 0x26 },
    { Name = "Down", Code = 0x28 },
    { Name = "Left", Code = 0x25 },
    { Name = "Right", Code = 0x27 },
    { Name = "Space", Code = 0x20 },
}

local blocked: boolean? = nil

local function syncMovementKeys(entering: boolean)
    local held = if entering then {} else Keys.pressed(false)
    for _, key in MOVEMENT_KEYS do
        if held[key.Name] then
            pcall(keypress, key.Code)
        else
            pcall(keyrelease, key.Code)
        end
    end
end

function Window.playerIsPlaying(keys: { [string]: boolean? }): boolean
    if keys.RightMouse then
        return true
    end
    for _, key in MOVEMENT_KEYS do
        if keys[key.Name] then
            return true
        end
    end
    return false
end

function Window.setBlocked(state: boolean)
    if state == blocked then
        return
    end
    blocked = state
    pcall(block_roblox_window, state)
    syncMovementKeys(state)
end

return Window
end
