local function crumbsOf(container: any): { { [string]: any } }
    local chain = {}
    local current = container
    local guard = 0
    while current and current ~= workspace and guard < 32 do
        guard += 1
        table.insert(chain, 1, { label = tostring(Util.read(current, "Name") or "?"), target = current })
        current = Util.read(current, "Parent")
    end
    table.insert(chain, 1, { label = "workspace", target = workspace })
    return chain
end

