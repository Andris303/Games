local import: (string) -> any = ...
local Color: typeof(require("../../core/color")) = import("core/color")
local Paths: typeof(require("../../entities/paths")) = import("entities/paths")
local Util: typeof(require("../../core/util")) = import("core/util")

type App = { [string]: any }

local Lists = {}

local DANGER = Color3.fromRGB(204, 36, 29)
local ROW_GAP = 4

local function pageCount(total: number, perPage: number): number
    return math.max(1, math.ceil(total / perPage))
end

local function close(app: App): () -> ()
