local Spec: typeof(require("../spec")) = import("ui/spec")

type App = { [string]: any }

local MAX_LISTED = 8

local function bindPair(app: App, first: number): { [string]: any }
    local function cell(index: number): { [string]: any }
        return Spec.bindrow(index, {
            show = function()
                return #app:boundOptions() >= index
            end,
        })
    end
    return Spec.pair(cell(first), cell(first + 1))
