local import: (string) -> any = ...
local Fleet: typeof(require("../vehicle/fleet")) = import("vehicle/fleet")
local Util: typeof(require("../core/util")) = import("core/util")

local PrisonLife = {}

local POLL_INTERVAL = 0.05

local RETRY_SECONDS = 0.5

function PrisonLife.new(config: any)
    local fleet: any = Fleet.new(config)
    local nextPoll = 0
    local retryAt = Util.newWeakKeyed() :: { [any]: number }

    fleet.Scan = function(now: number): number?
        if now < nextPoll then
            return nil
        end
        nextPoll = now + POLL_INTERVAL
        local container = Util.child(workspace, "CarContainer")
        if not container then
            return nil
        end
        local ok, children = pcall(function()
            return container:GetChildren()
        end)
        if ok and type(children) == "table" then
            for _, model in children do
                if not fleet.Cars[model] and now >= (retryAt[model] or 0) and not Fleet.track(fleet, model) then
                    retryAt[model] = now + RETRY_SECONDS
                end
            end
        end
        return nil
    end
    return fleet
end

return PrisonLife
end
