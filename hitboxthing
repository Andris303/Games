local import: (string) -> any = ...
local Util: typeof(require("../core/util")) = import("core/util")

local Zombie = {}

local ENEMY_FOLDERS = { "BossFolder", "enemies" }
local DEAD_FOLDER = "deadenemies"

function Zombie.attach(entities: any): any
    local added: { [string]: any } = {}
    local dead: any = nil

    local function configure()
        local deadFolder = Util.child(workspace, DEAD_FOLDER)
        if deadFolder and dead ~= deadFolder then
            dead = deadFolder
            entities:setDeadPath(deadFolder)
        end
        for _, name in ENEMY_FOLDERS do
            local folder = Util.child(workspace, name)
            if folder and added[name] ~= folder then
                added[name] = folder
                entities:addPath(folder)
            end
        end
    end

    configure()
    local ok, connection = pcall(function()
        return workspace.ChildAdded:Connect(function(child)
            local name = tostring(Util.read(child, "Name") or "")
            if name == DEAD_FOLDER or table.find(ENEMY_FOLDERS, name) then
                configure()
            end
        end)
    end)
    if ok then
        return connection
    end
    return nil
end

return Zombie
end
