modules["ui/popups/kit"] = function(...)

local import: (string) -> any = ...
local Color: typeof(require("../../core/color")) = import("core/color")
local Hits: typeof(require("../hits")) = import("ui/hits")
local Motion: typeof(require("../motion")) = import("ui/motion")
local Painter: typeof(require("../painter")) = import("ui/painter")

local Kit = {}
Kit.__index = Kit

type App = { [string]: any }

local Z_BODY, Z_CONTROL, Z_TEXT = 22, 24, 26
Kit.Z_BODY, Kit.Z_CONTROL, Kit.Z_TEXT = Z_BODY, Z_CONTROL, Z_TEXT

function Kit.new(app: App, width: number, height: number, position: Vector2, size: Vector2, alpha: number)
    local self = {
        App = app,
        Width = width,
        Height = height,
        Position = position,
        ScreenSize = size,
        Alpha = alpha,
    }
    return setmetatable(self, Kit)
end

type Self = typeof(Kit.new(nil :: any, 0, 0, Vector2.zero, Vector2.zero, 0))

function Kit.p(self: Self, x: number, y: number): Vector2
    return self.Position + Vector2.new(x / self.Width * self.ScreenSize.X, y / self.Height * self.ScreenSize.Y)
end

function Kit.s(self: Self, w: number, h: number): Vector2
    return Vector2.new(w / self.Width * self.ScreenSize.X, h / self.Height * self.ScreenSize.Y)
end

function Kit.rect(self: Self, x: number, y: number, w: number, h: number, color: Color3, alpha: number?, rounding: number?)
    Painter.rect(self:p(x, y), self:s(w, h), color, self.Alpha * (alpha or 1), Z_CONTROL, rounding or 10)
end

function Kit.solid(self: Self, x: number, y: number, w: number, h: number, color: Color3, radius: number)
    local factor = self.ScreenSize.X / self.Width
    Painter.rect(self:p(x, y), self:s(w, h), color, self.Alpha, Z_CONTROL, radius * factor, true)
end

function Kit.text(self: Self, text: string, x: number, y: number, size: number, color: Color3, center: boolean?, middle: boolean?)
    Painter.text(text, self:p(x, y), size * self.App.TextScale, color, self.Alpha, Z_TEXT, center, middle)
end

local function easeKey(app: App, key: string, goal: number, speed: number): number
    local store = app.PopAnim
    local value = Motion.ease(app.State, store[key] or 0, goal, app.Dt, speed)
    store[key] = value
    return value
end

function Kit.button(self: Self, key: string, x: number, y: number, w: number, h: number, onClick: () -> (), options: { [string]: any }?): number
    local app = self.App
    local pal = app.Pal
    local opts: { [string]: any } = options or {}
    local position, size = self:p(x, y), self:s(w, h)
    local hovered = app.HoverKey == key
    local hover = easeKey(app, key .. ":hover", if hovered then 1 else 0, 16)
    local pressed = Hits.isPressed(key) and hovered
    local press = easeKey(app, key .. ":press", if pressed then 1 else 0, 28)
    local scale = 1 - 0.05 * press
    local shrunk = size * scale
    local moved = position + (size - shrunk) / 2

    local active = opts.active == true
    local base = opts.base or pal.Panel
    local fill = if active then pal.Accent else Color.lerp(base, opts.hoverColor or pal.Accent, (opts.hoverMix or 1) * hover)
    Painter.rect(moved, shrunk, fill, self.Alpha, Z_CONTROL, opts.rounding or 16)
    local textColor
    if active then
        textColor = pal.Panel
    else
        textColor = Color.lerp(opts.textColor or pal.Text, opts.hoverText or Color3.new(0, 0, 0), hover * (opts.hoverMix or 1))
    end
    if opts.label then
        Painter.text(opts.label, moved + shrunk / 2, (opts.size or 13) * app.TextScale, textColor, self.Alpha, Z_TEXT, true, true)
    end
    Hits.add({ key = key, position = position, size = size, click = onClick })
    return hover
end

function Kit.pager(self: Self, key: string, x: number, y: number, w: number, page: number, maxPage: number, onPage: (number) -> ())
    local pal = self.App.Pal
    local canPrev, canNext = page > 1, page < maxPage
    local function arrow(suffix: string, label: string, ax: number, enabled: boolean, target: number)
        local hover = self:button(key .. suffix, ax, y, 28, 24, function()
            if enabled then
                onPage(target)
            end
        end, {
            label = label,
            textColor = if enabled then pal.Text else Color3.fromRGB(90, 90, 95),
            base = if enabled then pal.Panel else Color.lerp(pal.Panel, pal.Main, 0.5),
            hoverMix = if enabled then 1 else 0,
            rounding = 12,
        })
        return hover
    end
    arrow(":prev", "<", x, canPrev, page - 1)
    arrow(":next", ">", x + w - 28, canNext, page + 1)
    self:text(tostring(page) .. "/" .. tostring(maxPage), x + w / 2, y + 12, 13, pal.Sub, true, true)
end

function Kit.closeButton(self: Self, label: string, onClick: () -> ())
    self:button("pop:close", 10, self.Height - 38, self.Width - 20, 28, onClick, { label = label })
end

function Kit.lines(self: Self, lines: { string }, y: number, step: number, size: number?)
    local color = self.App.Pal.Sub
    for index, line in lines do
        self:text(line, self.Width / 2, y + (index - 1) * step, size or 13, color, true, true)
    end
end

function Kit.switchRow(self: Self, key: string, x: number, y: number, w: number, h: number, label: string, on: boolean, onClick: () -> ())
    local app = self.App
    local pal = app.Pal
    local hovered = app.HoverKey == key
    local hover = easeKey(app, key .. ":hover", if hovered then 1 else 0, 16)
    local value = easeKey(app, key .. ":on", if on then 1 else 0, 16)
    self:rect(x, y, w, h, Color.lerp(Color.lerp(pal.Panel, pal.Main, 0.10), pal.Accent, 0.08 * hover), 1, 16)
    self:text(label, x + 13, y + h / 2, 13, pal.Text, false, true)
    local trackW, trackH, knob = 42, 22, 16
    local tx, ty = x + w - trackW - 11, y + (h - trackH) / 2
    local round = math.clamp(tonumber(app.State.ToggleRoundness) or 0.55, 0, 1)
    self:solid(tx, ty, trackW, trackH, Color.lerp(pal.Off, pal.Accent, value), trackH * 0.5 * round)
    local kx = tx + 3 + (trackW - knob - 6) * value
    self:solid(kx, ty + (trackH - knob) / 2, knob, knob, Color.lerp(pal.Sub, pal.Main, value), knob * 0.5 * round)
    Hits.add({ key = key, position = self:p(x, y), size = self:s(w, h), click = onClick })
end

function Kit.slider(self: Self, key: string, x: number, y: number, w: number, h: number, label: string, fraction: number, shown: string, onDrag: (number) -> ())
    local app = self.App
    local pal = app.Pal
    local hover = easeKey(app, key .. ":hover", if app.HoverKey == key then 1 else 0, 16)
    self:rect(x, y, w, h, Color.lerp(Color.lerp(pal.Panel, pal.Main, 0.10), pal.Accent, 0.06 * hover), 1, 16)
    self:text(label, x + 12, y + 14, 13, pal.Text, false, true)
    local barX, barY, barW, barH = x + 12, y + h - 12, w - 65, 5
    self:rect(barX, barY, barW, barH, pal.Main, 1, 8)
    self:rect(barX, barY, math.max(1, barW * math.clamp(fraction, 0, 1)), barH, Color.lighten(pal.Accent, 0.2 * hover), 1, 8)
    self:rect(x + w - 47, y + 6, 35, 18, pal.Main, 1, 12)
    self:text(shown, x + w - 29.5, y + 15, 13, pal.Text, true, true)
    local barPos, barSize = self:p(barX, barY), self:s(barW, barH)
    Hits.add({
        key = key,
        position = self:p(x, y),
        size = self:s(w, h),
        drag = function(mouse: Vector2)
            onDrag(math.clamp((mouse.X - barPos.X) / math.max(0.001, barSize.X), 0, 1))
        end,
    })
end

function Kit.input(self: Self, key: string, x: number, y: number, w: number, h: number, shown: string, onFocus: () -> (), base: Color3?)
    local app = self.App
    local pal = app.Pal
    local focused = app.Focus == key
    local hover = easeKey(app, key .. ":hover", if app.HoverKey == key then 1 else 0, 16)
    self:rect(x, y, w, h, if focused then pal.Off else Color.lerp(base or pal.Panel, pal.Accent, 0.22 * hover), 1, 10)
    self:text(if focused then (app.Buffers[key] or "") .. "|" else shown, x + w / 2, y + h / 2, 13, pal.Text, true, true)
    Hits.add({ key = key, position = self:p(x, y), size = self:s(w, h), click = onFocus })
end

function Kit.header(self: Self, title: string, subtitle: string?, onClose: () -> (), onBack: (() -> ())?): number
    local pal = self.App.Pal
    local left = 18
    if onBack then
        self:button("pop:back", 12, 11, 26, 26, onBack, { label = "<", size = 14, rounding = 10 })
        left = 48
    end
    self:text(title, left, if subtitle then 19 else 24, 15, pal.Text, false, true)
    if subtitle then
        self:text(subtitle, left, 35, 10, pal.Sub, false, true)
    end
    self:button("pop:close", self.Width - 38, 11, 26, 26, onClose, { label = "x", size = 13, rounding = 10 })
    self:rect(16, 48, self.Width - 32, 1, pal.Off, 0.8, 0)
    return 58
end

local BADGES: { [string]: { any } } = {
    Model = { "M", Color3.fromRGB(69, 133, 136) },
    Folder = { "F", Color3.fromRGB(215, 153, 33) },
    Part = { "P", Color3.fromRGB(214, 93, 14) },
    MeshPart = { "P", Color3.fromRGB(214, 93, 14) },
    Humanoid = { "H", Color3.fromRGB(152, 151, 26) },
}

function Kit.badgeFor(self: Self, className: string, fallback: string?): (string, Color3)
    local badge = BADGES[className]
    if badge then
        return badge[1], badge[2]
    end
    local letter = string.upper(string.sub(fallback or className, 1, 1))
    return if letter == "" then "?" else letter, self.App.Pal.Sub
end

function Kit.listRow(self: Self, key: string, x: number, y: number, w: number, h: number, options: { [string]: any })
    local app = self.App
    local pal = app.Pal
    local clickable = options.onClick ~= nil
    local hover = easeKey(app, key .. ":hover", if clickable and app.HoverKey == key then 1 else 0, 16)
    local press = easeKey(app, key .. ":press", if clickable and Hits.isPressed(key) and app.HoverKey == key then 1 else 0, 26)
    local inset = press * 1.5
    self:rect(x + inset, y + inset * 0.5, w - inset * 2, h - inset, Color.lerp(Color.lerp(pal.Main, pal.Panel, 0.30), pal.Accent, 0.13 * hover), 1, 12)
    local badgeColor: Color3 = options.badgeColor or pal.Sub
    local size = h - 12
    self:rect(x + 8, y + 6, size, size, Color.lerp(pal.Main, badgeColor, 0.80), 1, 9)
    self:text(options.badge or "?", x + 8 + size / 2, y + h / 2, 12, Color.lighten(badgeColor, 0.75), true, true)
    local textX = x + 16 + size
    local sub: string? = options.sub
    if sub and sub ~= "" then
        self:text(options.title, textX, y + h / 2 - 6, 12, pal.Text, false, true)
        self:text(sub, textX, y + h / 2 + 7, 9, pal.Sub, false, true)
    else
        self:text(options.title, textX, y + h / 2, 12, pal.Text, false, true)
    end
    if options.arrow then
        self:text(">", x + w - 14 + hover * 2, y + h / 2, 13, Color.lerp(pal.Sub, pal.Accent, hover), true, true)
    end
    if clickable then
        Hits.add({ key = key, position = self:p(x, y), size = self:s(w, h), click = options.onClick })
    end
end

function Kit.miniSwitch(self: Self, key: string, x: number, y: number, on: boolean, onClick: () -> ())
    local app = self.App
    local pal = app.Pal
    local width, height, knob = 36, 20, 14
    local hover = easeKey(app, key .. ":hover", if app.HoverKey == key then 1 else 0, 16)
    local value = Motion.spring(app.State, app.Springs, key .. ":on", if on then 1 else 0, app.Dt, 0.30, 0.65)
    local shown = math.clamp(value, 0, 1)
    local round = math.clamp(tonumber(app.State.ToggleRoundness) or 0.55, 0, 1)
    self:solid(x, y, width, height, Color.lerp(Color.lerp(pal.Off, pal.Main, 0.2), Color.lighten(pal.Accent, 0.2 * hover), shown), height * 0.5 * round)
    local stretch = 1 + math.min(math.abs(Motion.velocity(app.Springs, key .. ":on")) * 0.06, 0.3)
    local knobW = knob * stretch
    self:solid(x + 3 + (width - knob - 6) * value - (knobW - knob) * value, y + (height - knob) / 2, knobW, knob, Color.lerp(pal.Sub, pal.Main, shown), knob * 0.5 * round)
    Hits.add({ key = key, position = self:p(x - 4, y - 4), size = self:s(width + 8, height + 8), click = onClick })
end

function Kit.segment(self: Self, key: string, x: number, y: number, w: number, h: number, labels: { string }, selected: number, onSelect: (number) -> ())
    local app = self.App
    local pal = app.Pal
    local count = #labels
    local cell = w / count
    self:rect(x, y, w, h, Color.lerp(pal.Main, pal.Panel, 0.42), 1, 12)
    local slide = Motion.spring(app.State, app.Springs, key .. ":slide", selected - 1, app.Dt, 0.34, 0.82)
    self:rect(x + 2 + slide * cell, y + 2, cell - 4, h - 4, Color.lerp(pal.Panel, pal.Accent, 0.30), 1, 10)
    for index, label in labels do
        local cellKey = key .. ":" .. index
        local hover = easeKey(app, cellKey .. ":hover", if app.HoverKey == cellKey then 1 else 0, 16)
        local lit = easeKey(app, cellKey .. ":lit", if index == selected then 1 else 0, 14)
        local color = Color.lerp(Color.lerp(pal.Sub, pal.Text, hover), Color.lighten(pal.Accent, 0.55), lit)
        self:text(label, x + (index - 0.5) * cell, y + h / 2, 11, color, true, true)
        Hits.add({
            key = cellKey,
            position = self:p(x + (index - 1) * cell, y),
            size = self:s(cell, h),
            click = function()
                onSelect(index)
            end,
        })
    end
end

function Kit.crumbs(self: Self, key: string, x: number, y: number, w: number, h: number, parts: { { [string]: any } }, onSelect: (any) -> ())
    local app = self.App
    local pal = app.Pal
    local factor = self.ScreenSize.X / self.Width
    local fontSize = 11
    self:rect(x, y, w, h, Color.lerp(pal.Main, pal.Panel, 0.42), 1, 12)
    local widths: { number } = {}
    for index, part in parts do
        widths[index] = Painter.textWidth(part.label, fontSize * app.TextScale) / factor + 14
    end
    local first = #parts
    local used = widths[first]
    while first > 1 and used + widths[first - 1] + 12 <= w - 16 - (if first > 2 then 22 else 0) do
        first -= 1
        used += widths[first] + 12
    end
    local cursor = x + 8
    if first > 1 then
        self:text("...", cursor + 6, y + h / 2, fontSize, pal.Sub, true, true)
        cursor += 22
    end
    for index = first, #parts do
        local part = parts[index]
        local last = index == #parts
        local partKey = key .. ":" .. index
        local hover = easeKey(app, partKey .. ":hover", if not last and app.HoverKey == partKey then 1 else 0, 16)
        if hover > 0.01 then
            self:rect(cursor, y + 3, widths[index], h - 6, pal.Panel, hover, 8)
        end
        self:text(part.label, cursor + widths[index] / 2, y + h / 2, fontSize, if last then pal.Accent else Color.lerp(pal.Sub, pal.Text, hover), true, true)
        if not last then
            Hits.add({
                key = partKey,
                position = self:p(cursor, y + 3),
                size = self:s(widths[index], h - 6),
                click = function()
                    onSelect(part.target)
                end,
            })
            self:text(">", cursor + widths[index] + 6, y + h / 2, 10, pal.Off, true, true)
        end
        cursor += widths[index] + 12
    end
end

function Kit.shield(self: Self)
    Hits.add({ key = "pop:body", position = self.Position, size = self.ScreenSize, shield = true })
end

return Kit
end
