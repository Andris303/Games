modules["input/chat"] = function(...)

local Chat = {}

local OFFSETS_URL = "https://offsets.imtheo.lol/Offsets.hpp"

type Offsets = { [string]: { [string]: number } }

local offsets: Offsets? = nil
local userInputService: any = nil
local chatInputBar: any = nil

local function parse(text: string): Offsets
    local result: Offsets = {}
    local current: string? = nil
    for line in string.gmatch(text, "[^\n]+") do
        local namespace = string.match(line, "^%s*namespace%s+(%w+)%s*{")
        if namespace then
            current = namespace
            result[namespace] = result[namespace] or {}
        elseif string.match(line, "^%s*}") then
            current = nil
        elseif current then
            local name, hex = string.match(line, "inline%s+constexpr%s+uintptr_t%s+(%w+)%s*=%s*(0x%x+)")
            if name and hex then
                local value = tonumber(hex)
                if value then
                    result[current][name] = value
                end
            end
        end
    end
    return result
end

local function trusted(candidate: Offsets): boolean
    local instance = candidate.Instance
    local parentOffset = instance and instance.Parent
    if type(parentOffset) ~= "number" then
        return false
    end
    local ok, result = pcall(function()
        local address = memory.readu64(workspace, parentOffset)
        if not address or address == 0 then
            return false
        end
        local parent = pointer_to_userdata(address)
        if not parent then
            return false
        end
        return parent == game or memory.rtti(parent, 0) == "RBX::DataModel"
    end)
    return ok and result == true
end

local function download(): Offsets?
    local ok, response = pcall(function()
        return game:HttpGet(OFFSETS_URL)
    end)
    if ok and type(response) == "string" then
        local latest = parse(response)
        if trusted(latest) then
            return latest
        end
    end
    return nil
end

local function textBoxFocused(): boolean?
    local inputNames = offsets and offsets.UserInputService
    local stateNames = offsets and offsets.WindowInputState
    if not userInputService or not inputNames or not stateNames then
        return nil
    end
    local stateOffset = inputNames.WindowInputState
    local textBoxOffset = stateNames.CurrentTextBox
    if type(stateOffset) ~= "number" or type(textBoxOffset) ~= "number" then
        return nil
    end
    local ok, result = pcall(function()
        local state = memory.readu64(userInputService, stateOffset)
        if not state or state == 0 then
            return false
        end
        local textBox = memory.readu64(state + textBoxOffset)
        return textBox ~= nil and textBox ~= 0
    end)
    if not ok then
        return nil
    end
    return result == true
end

local CHAT_BAR_NAMESPACES = { "ChatInputBarConfiguration", "ChatInputBarConfig", "TextChatInputBarConfiguration" }
local FOCUS_FIELDS = { "IsFocused", "Focused", "IsActive", "Active" }

local function chatBarFocused(): boolean?
    if not chatInputBar or not offsets then
        return nil
    end
    for _, namespaceName in CHAT_BAR_NAMESPACES do
        local names = offsets[namespaceName]
        if names then
            local focusOffset = nil
            for _, field in FOCUS_FIELDS do
                focusOffset = focusOffset or names[field]
            end
            if type(focusOffset) == "number" then
                local ok, value = pcall(memory.readbool, chatInputBar, focusOffset)
                if ok then
                    return value == true
                end
            end
        end
    end
    return nil
end

function Chat.start(): thread
    return task.spawn(function()
        offsets = download()
        if not offsets then
            return
        end
        pcall(function()
            userInputService = game:GetService("UserInputService")
        end)
        pcall(function()
            local service = game:FindFirstChildOfClass("TextChatService")
            chatInputBar = service and service:FindFirstChild("ChatInputBarConfiguration")
        end)
    end)
end

function Chat.isTyping(): boolean
    if not offsets then
        return false
    end
    local focused = textBoxFocused()
    if focused ~= nil then
        return focused
    end
    return chatBarFocused() == true
end

return Chat
end
modules["input/keys"] = function(...)

local Keys = {}

export type KeySet = { [string]: boolean? }

local MODIFIER_ORDER = { "RightAlt", "LeftAlt", "RightCtrl", "LeftCtrl", "RightShift", "LeftShift" }

local ALIASES: { [string]: string } = {
    MouseButton1 = "LeftMouse",
    Mouse1 = "LeftMouse",
    LButton = "LeftMouse",
    LeftButton = "LeftMouse",
    LeftMouseButton = "LeftMouse",
    MouseButton2 = "RightMouse",
    Mouse2 = "RightMouse",
    RButton = "RightMouse",
    RightButton = "RightMouse",
    RightMouseButton = "RightMouse",
    LShift = "LeftShift",
    RShift = "RightShift",
    LCtrl = "LeftCtrl",
    RCtrl = "RightCtrl",
    LeftControl = "LeftCtrl",
    RightControl = "RightCtrl",
    LControl = "LeftCtrl",
    RControl = "RightCtrl",
    Control = "Ctrl",
    LAlt = "LeftAlt",
    RAlt = "RightAlt",
    LeftMenu = "LeftAlt",
    RightMenu = "RightAlt",
}

function Keys.normalize(key: any): string
    local name = tostring(key or "")
    name = string.gsub(name, "^Enum%.KeyCode%.", "")
    name = string.gsub(name, "^KeyCode%.", "")
    return ALIASES[name] or name
end

local function dropGenericModifiers(keys: KeySet)
    if keys.LeftShift or keys.RightShift then
        keys.Shift = nil
    end
    if keys.LeftCtrl or keys.RightCtrl then
        keys.Ctrl = nil
        keys.Control = nil
    end
    if keys.LeftAlt or keys.RightAlt then
        keys.Alt = nil
    end
end

local function readKeyboard(): KeySet
    local keys: KeySet = {}
    local ok, pressed = pcall(getpressedkeys)
    if ok and type(pressed) == "table" then
        for index = 1, #pressed do
            local key = Keys.normalize(pressed[index])
            if key ~= "" and key ~= "LeftMouse" and key ~= "RightMouse" then
                keys[key] = true
            end
        end
    end
    dropGenericModifiers(keys)
    return keys
end

local function readButton(read: () -> boolean): boolean
    local ok, down = pcall(read)
    return ok and down == true
end

function Keys.pressed(includeMouse: boolean): KeySet
    local keys = readKeyboard()
    if includeMouse then
        if readButton(isleftpressed) then
            keys.LeftMouse = true
        end
        if readButton(isrightpressed) then
            keys.RightMouse = true
        end
    end
    return keys
end

function Keys.findNew(keys: KeySet, previous: KeySet): string?
    for index = 1, #MODIFIER_ORDER do
        local key = MODIFIER_ORDER[index]
        if keys[key] and not previous[key] then
            return key
        end
    end
    for key in keys do
        if not previous[key] then
            return key
        end
    end
    return nil
end

return Keys
end
