modules["hitbox/character-cache"] = function(...)

local import: (string) -> any = ...
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")

export type Cached = {
    Character: any,
    MainPart: any,
    Humanoid: any,
    BodyEffects: any,
    KO: any,
    Dead: any,
    Head: any,
    UpperTorso: any,
    LowerTorso: any,
    Torso: any,
    LeftArm: any,
    LeftLowerArm: any,
    LeftHand: any,
    RightArm: any,
    RightLowerArm: any,
    RightHand: any,
    LeftLeg: any,
    LeftLowerLeg: any,
    LeftFoot: any,
    RightLeg: any,
    RightLowerLeg: any,
    RightFoot: any,
    NextRefresh: number,
}

local CharacterCache = {}

local FIELDS = {
    "MainPart", "Humanoid", "BodyEffects", "KO", "Dead", "Head", "UpperTorso", "LowerTorso", "Torso",
    "LeftArm", "LeftLowerArm", "LeftHand", "RightArm", "RightLowerArm", "RightHand",
    "LeftLeg", "LeftLowerLeg", "LeftFoot", "RightLeg", "RightLowerLeg", "RightFoot",
}

local function child(character: any, first: string, second: string?): any
    local found = character:FindFirstChild(first)
    if found == nil and second ~= nil then
        found = character:FindFirstChild(second)
    end
    return found
end

function CharacterCache.build(character: any, nextRefresh: number): Cached
    local effects = character:FindFirstChild("BodyEffects")
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:FindFirstChild("Humanoid")
    local main = character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
    return {
        Character = character,
        MainPart = main,
        Humanoid = humanoid,
        BodyEffects = effects,
        KO = effects and child(effects, "K.O", "KO"),
        Dead = effects and effects:FindFirstChild("Dead"),
        Head = child(character, "Head", "HeadHB"),
        UpperTorso = character:FindFirstChild("UpperTorso"),
        LowerTorso = character:FindFirstChild("LowerTorso"),
        Torso = character:FindFirstChild("Torso"),
        LeftArm = child(character, "Left Arm", "LeftUpperArm"),
        LeftLowerArm = character:FindFirstChild("LeftLowerArm"),
        LeftHand = character:FindFirstChild("LeftHand"),
        RightArm = child(character, "Right Arm", "RightUpperArm"),
        RightLowerArm = character:FindFirstChild("RightLowerArm"),
        RightHand = character:FindFirstChild("RightHand"),
        LeftLeg = child(character, "Left Leg", "LeftUpperLeg"),
        LeftLowerLeg = character:FindFirstChild("LeftLowerLeg"),
        LeftFoot = character:FindFirstChild("LeftFoot"),
        RightLeg = child(character, "Right Leg", "RightUpperLeg"),
        RightLowerLeg = character:FindFirstChild("RightLowerLeg"),
        RightFoot = character:FindFirstChild("RightFoot"),
        NextRefresh = nextRefresh,
    }
end

function CharacterCache.matches(first: Cached?, second: Cached?): boolean
    if not first or not second or first.Character ~= second.Character then
        return false
    end
    for index = 1, #FIELDS do
        local key = FIELDS[index]
        if (first :: any)[key] ~= (second :: any)[key] then
            return false
        end
    end
    return true
end

function CharacterCache.main(cached: Cached?): any
    if cached and Parts.valid(cached.MainPart) then
        return cached.MainPart
    end
    if cached and Parts.valid(cached.Head) then
        return cached.Head
    end
    return nil
end

function CharacterCache.down(cached: Cached?): boolean
    if not cached then
        return true
    end
    local health = cached.Humanoid and Util.read(cached.Humanoid, "Health")
    if type(health) == "number" and health <= 0 then
        return true
    end
    if cached.KO and Util.read(cached.KO, "Value") == true then
        return true
    end
    return cached.Dead ~= nil and Util.read(cached.Dead, "Value") == true
end

return CharacterCache
end
modules["hitbox/players"] = function(...)

local import: (string) -> any = ...
local CharacterCache: typeof(require("./character-cache")) = import("hitbox/character-cache")
local Sizing: typeof(require("./sizing")) = import("hitbox/sizing")
local VisualClone: typeof(require("./visual-clone")) = import("hitbox/visual-clone")
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")

type State = { [string]: any }

type PartState = {
    Size: Vector3,
    HasCanCollide: boolean,
    CanCollide: any,
    HasTransparency: boolean,
    Transparency: any,
    HasLocalTransparency: boolean,
    LocalTransparency: any,
    HasMassless: boolean,
    Massless: any,
    HasCanTouch: boolean,
    CanTouch: any,
    HasCanQuery: boolean,
    CanQuery: any,
    AppliedSize: Vector3,
    NextVerify: number,
}

type Checks = {
    NextBasic: number,
    NextWall: number,
    NextMount: number?,
    Dead: boolean,
    Forcefield: boolean,
    Invisible: boolean,
    WallVisible: boolean,
}

type Entry = {
    Player: any,
    Character: any,
    Cached: any,
    Extended: { [any]: PartState },
    VisualClones: { [any]: any },
    TargetParts: { any },
    PartKeys: { [any]: string },
    Seen: { [any]: boolean },

    Mounted: boolean,

    MountedAt: number?,
    MountKnown: boolean,

    MountSeenAt: number,

    UpperOnly: boolean,
    FilterReason: string?,
    ExtensionSize: Vector3?,
    Distance: number,
    Checks: Checks,
}

type Context = {
    Now: number,
    Mouse: Vector2,
    LocalRoot: any,
    SingleTarget: any,
    EnforceSingle: boolean,
}

export type Config = {
    State: State,
    LocalPlayer: any,
    GetPlayers: () -> { any },
    GetCamera: () -> any,
    GetMouse: () -> Vector2,
    Profile: any,
    ScanEntities: (() -> ())?,
    HasActiveNPCs: (() -> boolean)?,
    WallCheck: any,
    VehicleGuard: any,
}

local Players = {}
Players.__index = Players

local UPDATE_INTERVAL = 0.05

local VEHICLE_INTERVAL = 0.033
local STATIC_INTERVAL = 0.1
local CACHE_INTERVAL = 0.5
local RECONCILE_INTERVAL = 0.25
local SIZE_VERIFY_INTERVAL = 0.75
local IDLE_INTERVAL = 0.2
local NPC_INTERVAL = 0.15
local BASIC_CHECK_INTERVAL = 0.4
local WALL_CHECK_INTERVAL = 0.12

local VISIBILITY_KEYS = {
    "Head", "Torso", "UpperTorso", "LowerTorso", "LeftArm", "RightArm", "LeftLeg", "RightLeg",
    "LeftLowerArm", "RightLowerArm", "LeftLowerLeg", "RightLowerLeg", "LeftHand", "RightHand", "LeftFoot", "RightFoot",
}

local PART_GROUPS: { { Key: string, Parts: { string } } } = {
    { Key = "Head", Parts = { "Head" } },
    { Key = "Torso", Parts = { "Torso", "UpperTorso", "LowerTorso" } },
    { Key = "LeftArm", Parts = { "LeftArm", "LeftLowerArm", "LeftHand" } },
    { Key = "RightArm", Parts = { "RightArm", "RightLowerArm", "RightHand" } },
    { Key = "LeftLeg", Parts = { "LeftLeg", "LeftLowerLeg", "LeftFoot" } },
    { Key = "RightLeg", Parts = { "RightLeg", "RightLowerLeg", "RightFoot" } },
}

function Players.new(config: Config)
    local self = {
        State = config.State,
        LocalPlayer = config.LocalPlayer,
        GetPlayers = config.GetPlayers,
        GetCamera = config.GetCamera,
        GetMouse = config.GetMouse,
        Profile = config.Profile,
        ScanEntities = config.ScanEntities,
        HasActiveNPCs = config.HasActiveNPCs,
        WallCheck = config.WallCheck,
        VehicleGuard = config.VehicleGuard,

        Roots = {} :: { [any]: { Character: any, Main: any } },

        DeadFolder = nil :: any,
        Entries = {} :: { [any]: Entry },
        SingleTarget = nil :: any,
        Running = false,
        Generation = 0,
        NextNPCUpdate = 0,
        NextReconcile = 0,
        WasEnabled = false,
        WallRunning = false,
        Context = { Now = 0, Mouse = Vector2.new(0, 0), LocalRoot = nil, SingleTarget = nil, EnforceSingle = false } :: Context,
    }
    return setmetatable(self, Players)
end

type Self = typeof(Players.new(nil :: any))

local function isLocalPlayer(self: Self, player: any): boolean
    if not player then
        return false
    end
    if player == self.LocalPlayer then
        return true
    end
    local localCharacter = self.LocalPlayer and Util.read(self.LocalPlayer, "Character")
    local character = Util.read(player, "Character")
    if localCharacter and character and character == localCharacter then
        return true
    end
    local localId = self.LocalPlayer and Util.read(self.LocalPlayer, "UserId")
    local playerId = Util.read(player, "UserId")
    return localId ~= nil and playerId ~= nil and tostring(localId) == tostring(playerId)
end

function Players.getEntries(self: Self): { [any]: Entry }
    return self.Entries
end

function Players.isDefaultSized(self: Self, player: any): boolean
    local entry = self.Entries[player]
    local reason = entry and entry.FilterReason or nil
    return reason == "vehicle" or reason == "mounted" or reason == "mounting"
end

function Players.inDeadFolder(self: Self, player: any): boolean
    local folder = self.DeadFolder
    local slot = self.Roots[player]
    return folder ~= nil and slot ~= nil and Util.read(slot.Character, "Parent") == folder
end

function Players.getExtensionSize(self: Self, player: any): Vector3?
    local entry = self.Entries[player]
    return entry and entry.ExtensionSize or nil
end

function Players.isValidPart(_self: Self, part: any): boolean
    return Parts.valid(part)
end

local function newEntry(self: Self, player: any, character: any, now: number): Entry
    local entry: Entry = {
        Player = player,
        Character = character,
        Cached = CharacterCache.build(character, now + CACHE_INTERVAL),
        Extended = {},
        VisualClones = {},
        TargetParts = {},
        PartKeys = {},
        Mounted = false,
        MountedAt = nil,
        MountKnown = false,
        MountSeenAt = 0,
        UpperOnly = false,
        Seen = {},
        FilterReason = nil,
        ExtensionSize = nil,
        Distance = 0,
        Checks = { NextBasic = 0, NextWall = 0, Dead = false, Forcefield = false, Invisible = false, WallVisible = true },
    }
    self.Entries[player] = entry
    return entry
end

local function restorePart(self: Self, entry: Entry, part: any)
    local state = entry.Extended[part]
    if not state then
        return
    end
    if part and part.Parent then
        Util.write(part, "Size", state.Size)
        if state.HasCanCollide then
            Util.write(part, "CanCollide", state.CanCollide)
        end
        if state.HasMassless then
            Util.write(part, "Massless", state.Massless)
        end
        if state.HasCanTouch then
            Util.write(part, "CanTouch", state.CanTouch)
        end
        if state.HasCanQuery then
            Util.write(part, "CanQuery", state.CanQuery)
        end
        if state.HasLocalTransparency then
            Util.write(part, "LocalTransparencyModifier", state.LocalTransparency)
        end
    end
    local clone = entry.VisualClones[part]
    if clone then
        if self.WallCheck then
            self.WallCheck:unignorePart(clone)
        end
        VisualClone.destroy(clone)
    end
    entry.VisualClones[part] = nil
    entry.Extended[part] = nil
end

local function restoreEntry(self: Self, entry: Entry)
    local extended = {}
    for part in entry.Extended do
        extended[#extended + 1] = part
    end
    for _, part in extended do
        restorePart(self, entry, part)
    end
    entry.ExtensionSize = nil
end

local function dropEntry(self: Self, player: any)
    local entry = self.Entries[player]
    if entry then
        restoreEntry(self, entry)
    end
    self.Entries[player] = nil
end

local function findMain(character: any): any
    return Util.child(character, "HumanoidRootPart") or Util.child(character, "Torso") or Util.child(character, "UpperTorso")
end

local function refreshRoots(self: Self, players: { any })
    local present: { [any]: boolean } = {}
    if self.Profile.Id == "waterloo" then
        self.DeadFolder = Util.child(workspace, "DeadCharacters")
    end
    for _, player in players do
        if not isLocalPlayer(self, player) and Parts.className(player) == "Player" then
            present[player] = true
            local character = Util.read(player, "Character")
            local slot = self.Roots[player]
            if not character then
                self.Roots[player] = nil
                dropEntry(self, player)
            elseif not slot or slot.Character ~= character then
                dropEntry(self, player)
                self.Roots[player] = { Character = character, Main = findMain(character) }
            elseif not slot.Main then
                slot.Main = findMain(character)
            end
        end
    end
    local stale = {}
    for player in self.Roots do
        if not present[player] then
            stale[#stale + 1] = player
        end
    end
    for player in self.Entries do
        if not present[player] then
            stale[#stale + 1] = player
        end
    end
    for _, player in stale do
        self.Roots[player] = nil
        dropEntry(self, player)
    end
end

local function appendPart(entry: Entry, part: any, key: string)
    if Parts.valid(part) and not entry.Seen[part] then
        entry.Seen[part] = true
        entry.PartKeys[part] = key
        entry.TargetParts[#entry.TargetParts + 1] = part
    end
end

local function collectTargetParts(self: Self, entry: Entry): { any }
    table.clear(entry.TargetParts)
    table.clear(entry.PartKeys)
    table.clear(entry.Seen)
    local cached = entry.Cached
    local selected = self.State.TargetParts or {}
    local root = entry.Character:FindFirstChild("HumanoidRootPart")
    if self.Profile.Restricted then
        appendPart(entry, root, "HRP")
        return entry.TargetParts
    end
    if selected.HRP then
        appendPart(entry, root, "HRP")
    end
    for _, group in PART_GROUPS do
        if selected[group.Key] then
            for _, name in group.Parts do
                appendPart(entry, (cached :: any)[name], group.Key)
            end
        end
    end
    if #entry.TargetParts == 0 then
        appendPart(entry, root, "HRP")
    end
    return entry.TargetParts
end

local function hasForcefield(character: any): boolean
    local ok, found = pcall(function()
        return character:FindFirstChild("ForceField") or character:FindFirstChildOfClass("ForceField")
    end)
    return ok and found ~= nil
end

local function isInvisible(entry: Entry): boolean
    local cached: any = entry.Cached
    local visible = 0
    local checked = 0
    for _, key in VISIBILITY_KEYS do
        local part = cached[key]
        if Parts.valid(part) then
            checked += 1
            local state = entry.Extended[part]
            local transparency = state and state.Transparency or nil
            if transparency == nil then
                transparency = Util.read(part, "Transparency")
            end
            if type(transparency) == "number" and transparency < 0.95 then
                visible += 1
            end
        end
    end
    return checked > 0 and visible == 0
end

local function wallVisible(self: Self, main: any): boolean
    if not self.WallCheck then
        return true
    end
    local camera = self.GetCamera()
    if not camera then
        return true
    end
    local ok, origin, target = pcall(function()
        return camera.CFrame.Position, main.Position
    end)
    if not ok or not origin or not target then
        return true
    end
    local visibleOk, visible = pcall(function()
        return self.WallCheck:canSee(origin, target)
    end)
    return not visibleOk or visible ~= false
end

local function horseAllows(self: Self, entry: Entry, main: any): boolean
    if not self.Profile.LegacyHorseIsolation then
        return true
    end
    local ok, weld, horse, marker = pcall(function()
        return main:FindFirstChild("HorseWeld"), entry.Character:FindFirstChild("Horse"), main:FindFirstChild("OriginalTransparency")
    end)
    if not ok then
        return true
    end
    if marker then
        return false
    end
    if horse and not weld then
        return false
    end
    return true
end

local function checkReason(self: Self, entry: Entry, main: any, now: number): string?
    local checks = entry.Checks
    local state = self.State
    local restricted = self.Profile.Restricted
    if state.DeadCheck == false then
        checks.Dead = false
    end
    if state.ForcefieldCheck == false then
        checks.Forcefield = false
    end
    if state.InvisibleCheck == false or restricted then
        checks.Invisible = false
    end
    if now >= checks.NextBasic then
        checks.NextBasic = now + BASIC_CHECK_INTERVAL
        if state.DeadCheck ~= false then
            checks.Dead = CharacterCache.down(entry.Cached)
        end
        if state.ForcefieldCheck ~= false then
            checks.Forcefield = hasForcefield(entry.Character)
        end
        if state.InvisibleCheck ~= false and not restricted then
            checks.Invisible = isInvisible(entry)
        end
    end
    if checks.Dead then
        return "dead"
    end
    if checks.Forcefield then
        return "forcefield"
    end
    if checks.Invisible then
        return "invisible"
    end
    if state.WallCheck ~= false and not restricted then
        if now >= checks.NextWall then
            checks.NextWall = now + WALL_CHECK_INTERVAL
            checks.WallVisible = wallVisible(self, main)
        end
        if checks.WallVisible == false then
            return "wall"
        end
    else
        checks.WallVisible = true
        checks.NextWall = 0
    end
    return nil
end

local function rangeReason(self: Self, player: any, main: any, context: Context, skipField: boolean): (string?, number, number)
    local state = self.State
    local whitelist = state.Whitelist or {}
    local targets = state.Targets or {}
    if whitelist[player.Name] then
        return "whitelist", 0, 0
    end
    if Players.inDeadFolder(self, player) then
        return "dead", 0, 0
    end
    if state.Mode == "Target" and not targets[player.Name] then
        return "target", 0, 0
    end
    if state.TeamCheck and self.LocalPlayer.Team and player.Team == self.LocalPlayer.Team then
        return "team", 0, 0
    end
    local distance = 0
    if context.LocalRoot and (state.DistanceLimit or state.DynSizeEnabled) then
        local squared = Util.distanceSquared(main.Position, context.LocalRoot.Position)
        if state.DistanceLimit then
            local maximum = math.max(0, tonumber(state.MaxDistance) or 0)
            if squared > maximum * maximum then
                return "distance", 0, 0
            end
        end
        if state.DynSizeEnabled then
            distance = math.sqrt(squared)
        end
    end
    if state.FovHitboxEnabled and not skipField then
        local camera = self.GetCamera()
        if not camera then
            return "fov", 0, 0
        end
        local ok, screen, onScreen = pcall(function()
            return camera:WorldToScreenPoint(main.Position)
        end)
        if not ok or not screen or not onScreen then
            return "fov", 0, 0
        end
        local x = screen.X - context.Mouse.X
        local y = screen.Y - context.Mouse.Y
        if x * x + y * y > state.FOVSize * state.FOVSize then
            return "fov", 0, 0
        end
    end
    local size, allowed = Sizing.resolve(state, distance)
    if not allowed then
        return "dynamic", 0, 0
    end
    return nil, distance, size
end

local function isMounted(entry: Entry, main: any): boolean
    if Util.child(main, "HorseWeld") then
        return true
    end
    local humanoid = entry.Cached.Humanoid
    if humanoid == nil then
        return false
    end
    if Util.read(humanoid, "Sit") == true or Util.read(humanoid, "SeatPart") ~= nil then
        return true
    end

    local ok, state = pcall(function()
        return humanoid:GetState()
    end)
    return ok and state == Enum.HumanoidStateType.Seated
end

local MOUNT_GRACE = 0.25
local METHOD_TWO, METHOD_THREE, METHOD_FOUR = "Method 2", "Method 3", "Method 4"

local function collectUpperParts(entry: Entry): { any }
    table.clear(entry.TargetParts)
    table.clear(entry.PartKeys)
    table.clear(entry.Seen)
    local cached: any = entry.Cached
    for _, name in { "Head", "Torso", "UpperTorso", "LowerTorso" } do
        appendPart(entry, cached[name], if name == "Head" then "Head" else "Torso")
    end
    return entry.TargetParts
end

local function updateMount(self: Self, entry: Entry, main: any, now: number)
    local method = self.State.MountMethod

    local active = self.Profile.MountMethods and (self.Profile.Id == "waterloo" or self.State.VehicleFixEnabled == true)
    if active and method ~= "Off" then
        local checks = entry.Checks
        if now >= (checks.NextMount or 0) then
            checks.NextMount = now + 0.04
            local mounted = isMounted(entry, main)
            local guard = self.VehicleGuard
            if not mounted and guard and guard.isSeated then

                mounted = guard:isSeated(entry.Character) == true
            end
            if mounted then
                entry.MountSeenAt = now
            elseif entry.Mounted and now - entry.MountSeenAt < MOUNT_GRACE then
                mounted = true
            end

            if mounted and not entry.Mounted and entry.MountKnown then
                entry.MountedAt = now
            end
            entry.Mounted = mounted
            entry.MountKnown = true
        end
    else
        entry.Mounted = false
        entry.MountKnown = false
    end
end

local function detailReason(self: Self, entry: Entry, main: any, context: Context): string?
    local state = self.State
    if context.EnforceSingle and entry.Player ~= context.SingleTarget then
        return "single"
    end
    if state.VehicleFixEnabled == true and self.VehicleGuard and not (entry.Mounted and self.Profile.MountMethods) then
        local ok, protected = pcall(self.VehicleGuard.shouldProtect, self.VehicleGuard, entry.Player, main, context.Now)
        if ok and protected then
            return "vehicle"
        end
    end
    local reason = checkReason(self, entry, main, context.Now)
    if reason then
        return reason
    end
    if not horseAllows(self, entry, main) then
        return "restricted"
    end
    return nil
end

local function eligibleSize(self: Self, entry: Entry, context: Context, skipField: boolean): (Vector3?, string?, number?)
    local main = CharacterCache.main(entry.Cached)
    if not main then
        return nil, "transient"
    end
    local reason, distance, size = rangeReason(self, entry.Player, main, context, skipField)
    if reason then
        return nil, reason
    end
    reason = detailReason(self, entry, main, context)
    if reason then
        return nil, reason
    end
    return Sizing.box(self.State, size), nil, distance
end

local function capture(self: Self, entry: Entry, part: any): PartState?
    local existing = entry.Extended[part]
    if existing then
        return existing
    end
    local size = Util.read(part, "Size")
    if not size then
        return nil
    end
    local profile = self.Profile
    local canCollide = Util.read(part, "CanCollide")
    local transparency = Util.read(part, "Transparency")
    local localTransparency = Util.read(part, "LocalTransparencyModifier")
    local state: PartState = {
        Size = size,
        HasCanCollide = canCollide ~= nil,
        CanCollide = canCollide,
        HasTransparency = transparency ~= nil,
        Transparency = transparency,
        HasLocalTransparency = localTransparency ~= nil,
        LocalTransparency = localTransparency,
        HasMassless = false,
        Massless = nil,
        HasCanTouch = false,
        CanTouch = nil,
        HasCanQuery = false,
        CanQuery = nil,
        AppliedSize = size,
        NextVerify = 0,
    }
    if profile.ExtendedMassless ~= nil or self.State.VehicleFixEnabled == true then
        state.Massless = Util.read(part, "Massless")
        state.HasMassless = state.Massless ~= nil
    end
    if profile.ExtendedCanTouch ~= nil then
        state.CanTouch = Util.read(part, "CanTouch")
        state.HasCanTouch = state.CanTouch ~= nil
    end
    if profile.ExtendedCanQuery ~= nil then
        state.CanQuery = Util.read(part, "CanQuery")
        state.HasCanQuery = state.CanQuery ~= nil
    end
    entry.Extended[part] = state
    return state
end

local function ensureVisualClone(self: Self, entry: Entry, part: any, state: PartState)
    if not self.Profile.VisualBodyClones or self.Profile.Restricted then
        return
    end
    if part == entry.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    local clone = entry.VisualClones[part]
    if clone and Parts.valid(clone) then
        return
    end
    if clone then
        VisualClone.destroy(clone)
    end
    clone = VisualClone.create(part, "SevereVisualClone", state.Size, if state.HasTransparency then state.Transparency else nil)
    if not clone then
        return
    end
    entry.VisualClones[part] = clone
    if self.WallCheck then
        self.WallCheck:ignorePart(clone)
    end
    if state.HasLocalTransparency then
        Util.write(part, "LocalTransparencyModifier", 1)
    end
end

local function syncClones(self: Self, entry: Entry)
    local stale = {}
    for part, clone in entry.VisualClones do
        if not Parts.valid(part) or not Parts.valid(clone) then
            stale[#stale + 1] = part
        else
            VisualClone.follow(part, clone)
        end
    end
    for _, part in stale do
        restorePart(self, entry, part)
    end
end

local function setSize(part: any, size: Vector3)
    part.Size = size
end

local function applySize(state: PartState, part: any, target: Vector3, now: number)
    local verify = now >= state.NextVerify
    if verify then
        state.NextVerify = now + SIZE_VERIFY_INTERVAL
    end
    if not Util.sameSize(state.AppliedSize, target, 0.03) then
        if pcall(setSize, part, target) then
            state.AppliedSize = target
        end
    elseif verify then
        local current = Util.read(part, "Size")
        if current and not Util.sameSize(current, target, 0.05) and pcall(setSize, part, target) then
            state.AppliedSize = target
        end
    end
end

local function applyToEntry(self: Self, entry: Entry, parts: { any }, target: Vector3, distance: number, now: number)
    local desired: { [any]: boolean } = {}
    for _, part in parts do
        desired[part] = true
    end
    local stale = {}
    for part in entry.Extended do
        if not desired[part] then
            stale[#stale + 1] = part
        end
    end
    for _, part in stale do
        restorePart(self, entry, part)
    end

    local profile = self.Profile
    local root = entry.Character:FindFirstChild("HumanoidRootPart")
    for _, part in parts do
        local state = capture(self, entry, part)
        if state then
            ensureVisualClone(self, entry, part, state)
            applySize(state, part, Sizing.partBox(self.State, entry.PartKeys[part] or "HRP", target), now)
            if state.HasCanCollide then
                if profile.ExtendedCanCollide ~= nil then
                    Util.write(part, "CanCollide", profile.ExtendedCanCollide == true)
                elseif part ~= root or self.State.VehicleFixEnabled == true then

                    Util.write(part, "CanCollide", false)
                end
            end
            if state.HasMassless then

                Util.write(part, "Massless", if profile.ExtendedMassless ~= nil then profile.ExtendedMassless == true else true)
            end
            if state.HasCanTouch then
                Util.write(part, "CanTouch", profile.ExtendedCanTouch == true)
            end
            if state.HasCanQuery then
                Util.write(part, "CanQuery", profile.ExtendedCanQuery == true)
            end
        end
    end
    entry.ExtensionSize = target
    entry.Distance = distance
end

local function updatePlayer(self: Self, entry: Entry, context: Context, size: number, distance: number)
    local main = CharacterCache.main(entry.Cached)
    if main then
        updateMount(self, entry, main, context.Now)
    end
    local reason = if main then detailReason(self, entry, main, context) else "transient"
    if reason then
        entry.FilterReason = reason
        restoreEntry(self, entry)
        return
    end

    local method = self.State.MountMethod
    entry.UpperOnly = false
    local boxSize = size
    if entry.Mounted then
        if method == METHOD_FOUR then
            entry.FilterReason = "mounted"
            restoreEntry(self, entry)
            return
        end

        local since = entry.MountedAt
        if since and context.Now - since < (tonumber(self.State.MountDelay) or 0) then
            entry.FilterReason = "mounting"
            restoreEntry(self, entry)
            return
        end
        if method == METHOD_TWO then
            boxSize = math.min(size, math.max(1, tonumber(self.State.MountedMax) or 8))
        elseif method == METHOD_THREE then
            entry.UpperOnly = true
        end
    end
    local parts = if entry.UpperOnly then collectUpperParts(entry) else collectTargetParts(self, entry)
    if #parts == 0 then
        entry.FilterReason = "transient"
        restoreEntry(self, entry)
        return
    end
    entry.FilterReason = nil
    applyToEntry(self, entry, parts, Sizing.box(self.State, boxSize), distance, context.Now)
    syncClones(self, entry)
end

local function processPlayer(self: Self, player: any, slot: { Character: any, Main: any }, context: Context)
    local reason, distance, size = rangeReason(self, player, slot.Main, context, false)
    local entry = self.Entries[player]
    if reason then
        if entry then
            dropEntry(self, player)
        end
        return
    end
    if not entry then
        entry = newEntry(self, player, slot.Character, context.Now)
    elseif context.Now >= entry.Cached.NextRefresh then
        entry.Cached = CharacterCache.build(slot.Character, context.Now + CACHE_INTERVAL)
    end
    updatePlayer(self, entry, context, size, distance)
end

local function singleTargetMode(state: State): boolean
    return (state.FovHitboxEnabled and state.FovSingleTarget) or (state.DynSizeEnabled and state.DynSizeSingleTarget)
end

function Players.selectSingleTarget(self: Self, camera: any, mouse: Vector2, players: { any }, localRoot: any): any
    local state = self.State
    if not singleTargetMode(state) then
        self.SingleTarget = nil
        return nil
    end
    if not camera then
        self.SingleTarget = nil
        return nil
    end
    local best = nil
    local bestDistance = math.huge
    local probe: Context = { Now = os.clock(), Mouse = mouse, LocalRoot = localRoot, SingleTarget = nil, EnforceSingle = false }
    for _, player in players do
        local entry = self.Entries[player]
        if entry and not isLocalPlayer(self, player) then
            local _, reason = eligibleSize(self, entry, probe, true)
            if not reason then
                local main = CharacterCache.main(entry.Cached)
                local ok, screen, visible = pcall(function()
                    return camera:WorldToScreenPoint(main.Position)
                end)
                if ok and screen and visible then
                    local x = screen.X - mouse.X
                    local y = screen.Y - mouse.Y
                    local squared = x * x + y * y
                    if (not state.FovHitboxEnabled or squared <= state.FOVSize * state.FOVSize) and squared < bestDistance then
                        bestDistance = squared
                        best = player
                    end
                end
            end
        end
    end
    self.SingleTarget = best
    return best
end

function Players.resetAll(self: Self)
    local players = {}
    for player in self.Entries do
        players[#players + 1] = player
    end
    for _, player in players do
        restoreEntry(self, self.Entries[player])
    end
end

function Players.shieldNear(self: Self, position: Vector3, radius: number, seconds: number)
    local guard = self.VehicleGuard
    if not guard or self.State.VehicleFixEnabled ~= true then
        return
    end
    local now = os.clock()
    local limit = radius * radius
    for player, slot in self.Roots do
        local at = Util.read(slot.Main, "Position")
        if at and Util.distanceSquared(at, position) <= limit then
            guard:hold(player, now + seconds)
            local entry = self.Entries[player]
            if entry then
                entry.FilterReason = "vehicle"
                restoreEntry(self, entry)
            end
        end
    end
end

local function localRootPart(self: Self): any
    local character = Util.read(self.LocalPlayer, "Character")
    return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function syncWallCheck(self: Self, needed: boolean)
    if not self.WallCheck then
        return
    end
    if needed and not self.WallRunning then
        self.WallCheck:start()
        self.WallRunning = true
    elseif not needed and self.WallRunning then
        self.WallCheck:stop()
        self.WallRunning = false
    end
end

local function step(self: Self): boolean
    local state = self.State
    local now = os.clock()
    local npcActive = false
    if self.HasActiveNPCs then
        local ok, active = pcall(self.HasActiveNPCs)
        npcActive = ok and active == true
    end
    syncWallCheck(self, state.WallCheck ~= false and (state.HitboxActive == true or npcActive))

    if npcActive and now >= self.NextNPCUpdate then
        self.NextNPCUpdate = now + NPC_INTERVAL
        if self.ScanEntities then
            pcall(self.ScanEntities)
        end
    end
    if not state.HitboxActive then
        if self.WasEnabled then
            Players.resetAll(self)
        end
        self.WasEnabled = false
        return npcActive
    end

    local players = self.GetPlayers()
    if now >= self.NextReconcile then
        self.NextReconcile = now + RECONCILE_INTERVAL
        refreshRoots(self, players)
    end
    self.WasEnabled = true

    local context = self.Context
    context.Now = now
    context.Mouse = self.GetMouse()
    context.LocalRoot = localRootPart(self)
    context.SingleTarget = self.SingleTarget
    context.EnforceSingle = singleTargetMode(state)
    for _, player in players do
        local slot = self.Roots[player]
        if slot and slot.Main then

            if not pcall(processPlayer, self, player, slot, context) then
                slot.Main = nil
            end
        end
    end
    return true
end

function Players.start(self: Self)
    if self.Running then
        return
    end
    self.Generation += 1
    local generation = self.Generation
    self.Running = true
    task.spawn(function()
        while self.Running and self.Generation == generation do
            local ok, active = pcall(step, self)
            local interval = IDLE_INTERVAL
            if ok and active then
                local state = self.State
                if state.HitboxActive and state.VehicleFixEnabled then
                    interval = VEHICLE_INTERVAL
                elseif state.HitboxActive and (state.FovHitboxEnabled or state.DynSizeEnabled or state.DistanceLimit) then
                    interval = UPDATE_INTERVAL
                else
                    interval = STATIC_INTERVAL
                end
            end
            task.wait(interval)
        end
    end)
end

function Players.stop(self: Self)
    if not self.Running and next(self.Entries) == nil then
        return
    end
    self.Generation += 1
    self.Running = false
    Players.resetAll(self)
    local players = {}
    for player in self.Entries do
        players[#players + 1] = player
    end
    for _, player in players do
        dropEntry(self, player)
    end
    self.Roots = {}
    self.SingleTarget = nil
    self.WasEnabled = false
    if self.WallCheck and self.WallRunning then
        self.WallCheck:stop()
    end
    self.WallRunning = false
end

return Players
end
modules["hitbox/sizing"] = function(...)

local Sizing = {}

type State = { [string]: any }

local RANGE_COUNT = 10
local MIN_KEYS: { string } = {}
local MAX_KEYS: { string } = {}
local SIZE_KEYS: { string } = {}
for index = 1, RANGE_COUNT do
    MIN_KEYS[index] = "DynMin" .. index
    MAX_KEYS[index] = "DynMax" .. index
    SIZE_KEYS[index] = "DynSize" .. index
end

Sizing.RANGE_COUNT = RANGE_COUNT
Sizing.MIN_KEYS = MIN_KEYS
Sizing.MAX_KEYS = MAX_KEYS
Sizing.SIZE_KEYS = SIZE_KEYS

function Sizing.resolve(state: State, distance: number): (number, boolean)
    if not state.DynSizeEnabled then
        return state.SizeAll, true
    end
    local count = if state.ExtraDynEnabled then RANGE_COUNT else 5
    local furthest = 0
    for index = 1, count do
        local first = tonumber(state[MIN_KEYS[index]]) or 0
        local second = tonumber(state[MAX_KEYS[index]]) or 0
        local lower = math.min(first, second)
        local upper = math.max(first, second)
        furthest = math.max(furthest, upper)
        if distance >= lower and distance <= upper then
            return tonumber(state[SIZE_KEYS[index]]) or state.SizeAll, true
        end
    end
    if state.DisableBeyondMax and distance > furthest then
        return state.SizeAll, false
    end
    return state.SizeAll, true
end

local PART_SIZE_KEYS: { [string]: string } = {
    HRP = "SizeRoot",
    Head = "SizeHead",
    Torso = "SizeTorso",
    LeftArm = "SizeArms",
    RightArm = "SizeArms",
    LeftLeg = "SizeLegs",
    RightLeg = "SizeLegs",
}

function Sizing.box(state: State, size: number): Vector3
    if not state.CustomDimensions then
        return Vector3.new(size, size, size)
    end
    local base = math.max(1, tonumber(state.SizeAll) or 1)
    local factor = size / base
    return Vector3.new(
        (tonumber(state.DimX) or 1) * factor,
        (tonumber(state.DimY) or 1) * factor,
        (tonumber(state.DimZ) or 1) * factor
    )
end

function Sizing.partBox(state: State, group: string, fallback: Vector3): Vector3
    local key = PART_SIZE_KEYS[group]
    if not state.PartSizesEnabled or state.DynSizeEnabled or not key then
        return fallback
    end
    return Sizing.box(state, math.max(1, tonumber(state[key]) or 1))
end

return Sizing
end
modules["hitbox/visual-clone"] = function(...)

local import: (string) -> any = ...
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")

local VisualClone = {}

local STRIPPED_CLASSES: { [string]: boolean } = {
    Script = true,
    LocalScript = true,
    ModuleScript = true,
    Weld = true,
    ManualWeld = true,
    Motor = true,
    Motor6D = true,
    Snap = true,
    WeldConstraint = true,
}

local function shouldStrip(className: string): boolean
    return STRIPPED_CLASSES[className] == true or Parts.isBasePartClass(className)
end

local function destroyQuietly(object: any)
    pcall(function()
        object:Destroy()
    end)
end

local function copyOf(part: any): any
    local clone = nil
    pcall(function()
        clone = part:Clone()
    end)
    return clone
end

local function stripChildren(clone: any)
    pcall(function()
        local descendants = clone:GetDescendants()
        for index = #descendants, 1, -1 do
            local child = descendants[index]
            if shouldStrip(Parts.className(child)) then
                child:Destroy()
            end
        end
    end)
end

function VisualClone.create(part: any, name: string, size: Vector3, transparency: number?): any
    local clone = copyOf(part)
    if not clone then
        return nil
    end
    stripChildren(clone)
    local cframe = Util.read(part, "CFrame")
    if not cframe then
        destroyQuietly(clone)
        return nil
    end
    Util.write(clone, "Name", name)
    Util.write(clone, "Anchored", true)
    Util.write(clone, "CanCollide", false)
    Util.write(clone, "CanTouch", false)
    Util.write(clone, "CanQuery", false)
    Util.write(clone, "Massless", true)
    Util.write(clone, "Size", size)
    if transparency ~= nil then
        Util.write(clone, "Transparency", transparency)
    end
    Util.write(clone, "CFrame", cframe)
    if not Util.write(clone, "Parent", workspace) then
        destroyQuietly(clone)
        return nil
    end
    return clone
end

function VisualClone.follow(part: any, clone: any)
    local cframe = Util.read(part, "CFrame")
    if cframe then
        Util.write(clone, "CFrame", cframe)
    end
end

function VisualClone.destroy(clone: any)
    destroyQuietly(clone)
end

return VisualClone
end
modules["hitbox/visualizer"] = function(...)

local import: (string) -> any = ...
local CharacterCache: typeof(require("./character-cache")) = import("hitbox/character-cache")
local Sizing: typeof(require("./sizing")) = import("hitbox/sizing")
local Canvas: typeof(require("../render/canvas")) = import("render/canvas")
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")

type State = { [string]: any }

type Group = { Key: string, [number]: any }

type Style = {
    LineCol: Color3,
    LineTrans: number,
    FillCol: Color3,
    FillTrans: number,
}

export type Config = {
    State: State,
    Profile: any,
    LocalPlayer: any,
    GetNPCVisualEntries: (() -> { [any]: any })?,
}

export type Frame = {
    Camera: any,
    Players: { any },
    Mouse: Vector2,
    LocalRoot: any,
    Delta: number,
    SingleTarget: any,
}

local Visualizer = {}
Visualizer.__index = Visualizer

local SMOOTH_SPEED = 35
local MAX_SMOOTH_DELTA = 0.05

local NAME_FONT: string? = nil
local NAME_SIZE = 13

function Visualizer.new(config: Config)
    local self = {
        State = config.State,
        Profile = config.Profile,
        LocalPlayer = config.LocalPlayer,
        GetNPCVisualEntries = config.GetNPCVisualEntries,
        Cache = Util.newWeakKeyed(),

        Tracks = Util.newWeakKeyed(),
        Velocity = nil :: Vector3?,
        SizeAnimations = Util.newWeakKeyed(),
        SharedStaticSize = nil :: Vector3?,
        Groups = {} :: { Group },
    }
    return setmetatable(self, Visualizer)
end

type Self = typeof(Visualizer.new(nil :: any))

local function cachedParts(self: Self, player: any, character: any): any
    local cached = self.Cache[player]
    if cached and cached.Character == character and Parts.valid(cached.MainPart) and cached.Humanoid and cached.Humanoid.Parent then
        return cached
    end
    cached = CharacterCache.build(character, 0)
    self.Cache[player] = cached
    return cached
end

local function addGroup(self: Self, key: string, ...: any)
    local group: Group = { Key = key }
    for _, part in { ... } do
        if Parts.valid(part) then
            group[#group + 1] = part
        end
    end
    if #group > 0 then
        self.Groups[#self.Groups + 1] = group
    end
end

local function collectGroups(self: Self, character: any, cached: any, upperOnly: boolean?): { Group }
    table.clear(self.Groups)
    if upperOnly then
        addGroup(self, "Head", cached.Head)
        addGroup(self, "Torso", cached.Torso, cached.UpperTorso, cached.LowerTorso)
        return self.Groups
    end
    local selected = self.State.TargetParts or {}
    if self.Profile.Restricted or selected.HRP then
        addGroup(self, "HRP", character:FindFirstChild("HumanoidRootPart"))
        return self.Groups
    end
    if selected.Head then
        addGroup(self, "Head", cached.Head)
    end
    if selected.Torso then
        addGroup(self, "Torso", cached.Torso, cached.UpperTorso, cached.LowerTorso)
    end
    if selected.LeftArm then
        addGroup(self, "LeftArm", cached.LeftArm, cached.LeftLowerArm, cached.LeftHand)
    end
    if selected.RightArm then
        addGroup(self, "RightArm", cached.RightArm, cached.RightLowerArm, cached.RightHand)
    end
    if selected.LeftLeg then
        addGroup(self, "LeftLeg", cached.LeftLeg, cached.LeftLowerLeg, cached.LeftFoot)
    end
    if selected.RightLeg then
        addGroup(self, "RightLeg", cached.RightLeg, cached.RightLowerLeg, cached.RightFoot)
    end
    return self.Groups
end

local function groupBounds(parts: { any }, mainPart: any, desiredSize: Vector3?): (any, Vector3?, any)
    if #parts == 1 and Parts.valid(parts[1]) then
        return parts[1].CFrame, desiredSize or parts[1].Size, parts[1]
    end
    local wanted = desiredSize or Vector3.new(0, 0, 0)
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local first = nil
    for _, part in parts do
        if Parts.valid(part) then
            first = first or part
            local position = part.Position
            local size = part.Size
            local halfX, halfY, halfZ = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
            minX = math.min(minX, position.X - halfX)
            minY = math.min(minY, position.Y - halfY)
            minZ = math.min(minZ, position.Z - halfZ)
            maxX = math.max(maxX, position.X + halfX)
            maxY = math.max(maxY, position.Y + halfY)
            maxZ = math.max(maxZ, position.Z + halfZ)
        end
    end
    if not first then
        return nil, nil, nil
    end
    local center = Vector3.new((minX + maxX) * 0.5, (minY + maxY) * 0.5, (minZ + maxZ) * 0.5)
    local size = Vector3.new(math.max(wanted.X, maxX - minX), math.max(wanted.Y, maxY - minY), math.max(wanted.Z, maxZ - minZ))
    local orientation = if Parts.valid(mainPart) then mainPart.CFrame else first.CFrame
    return CFrame.fromMatrix(center, orientation.RightVector, orientation.UpVector, -orientation.LookVector), size, first
end

local function styleOf(self: Self, style: Style?): (Color3, number, Color3, number)
    local state = self.State
    if style then
        return style.LineCol, style.LineTrans, style.FillCol, style.FillTrans
    end
    return state.VisLineCol, state.VisLineTrans, state.VisFillCol, state.VisFillTrans
end

local function queueBox(self: Self, flat: boolean, position: Vector3, orientation: any, boxSize: Vector3, style: Style?, health: number?)
    local rightHalf = orientation.RightVector * (boxSize.X * 0.5)
    local upHalf = orientation.UpVector * (boxSize.Y * 0.5)
    local lookHalf = orientation.LookVector * (boxSize.Z * 0.5)
    local corners = {
        position + rightHalf + upHalf + lookHalf,
        position - rightHalf + upHalf + lookHalf,
        position - rightHalf + upHalf - lookHalf,
        position + rightHalf + upHalf - lookHalf,
        position + rightHalf - upHalf + lookHalf,
        position - rightHalf - upHalf + lookHalf,
        position - rightHalf - upHalf - lookHalf,
        position + rightHalf - upHalf - lookHalf,
    }
    local lineColor, lineAlpha, fillColor, fillAlpha = styleOf(self, style)
    Canvas.worldBox(flat, corners, lineColor, lineAlpha, fillColor, fillAlpha, health, self.Velocity)
end

local function drawBox(self: Self, targetCFrame: any, boxSize: Vector3, style: Style?, health: number?)
    queueBox(self, false, targetCFrame.Position, targetCFrame, boxSize, style, health)
end

local function drawFlat(self: Self, part: any, mainPart: any, boxSize: Vector3, style: Style?, health: number?)
    local anchor = if Parts.valid(mainPart) then mainPart.CFrame else part.CFrame
    queueBox(self, true, part.CFrame.Position, anchor, boxSize, style, health)
end

local function easeSize(previous: Vector3, target: Vector3, delta: number): Vector3
    local factor = 1 - math.exp(-SMOOTH_SPEED * math.min(math.max(delta, 0), MAX_SMOOTH_DELTA))
    return Vector3.new(
        previous.X + (target.X - previous.X) * factor,
        previous.Y + (target.Y - previous.Y) * factor,
        previous.Z + (target.Z - previous.Z) * factor
    )
end

local function animationsOff(state: State): boolean
    return not state.AnimationsEnabled or state.HighPerformanceMode == true
end

local function smoothSize(self: Self, player: any, part: any, target: Vector3, delta: number): Vector3
    local sizes = self.SizeAnimations[player]
    if not sizes then
        sizes = Util.newWeakKeyed()
        self.SizeAnimations[player] = sizes
    end
    if animationsOff(self.State) then
        sizes[part] = target
        return target
    end
    local current = easeSize(sizes[part] or Vector3.new(0, 0, 0), target, delta)
    sizes[part] = current
    return current
end

local function smoothStatic(self: Self, target: Vector3, delta: number): Vector3
    if animationsOff(self.State) or not self.SharedStaticSize then
        self.SharedStaticSize = target
        return target
    end
    local current = easeSize(self.SharedStaticSize, target, delta)
    self.SharedStaticSize = current
    return current
end

local function singleTargetMode(state: State): boolean
    return (state.FovHitboxEnabled and state.FovSingleTarget) or (state.DynSizeEnabled and state.DynSizeSingleTarget)
end

local function desiredBox(self: Self, frame: Frame, player: any, cached: any): Vector3?
    local state = self.State
    local main, humanoid = cached.MainPart, cached.Humanoid
    if not Parts.valid(main) or not humanoid or not humanoid.Parent then
        return nil
    end
    if state.DeadCheck ~= false then
        if humanoid.Health <= 0 then
            return nil
        end
        if cached.KO and cached.KO.Parent and cached.KO.Value == true then
            return nil
        end
        if cached.Dead and cached.Dead.Parent and cached.Dead.Value == true then
            return nil
        end
    end
    local targets = state.Targets or {}
    local whitelist = state.Whitelist or {}
    local targeted = state.Mode == "Target" and targets[player.Name]
    if state.Mode == "Target" and not targeted then
        return nil
    end
    if whitelist[player.Name] then
        return nil
    end
    if state.TeamCheck and self.LocalPlayer.Team and player.Team == self.LocalPlayer.Team then
        return nil
    end
    if state.ForcefieldCheck ~= false and player.Character:FindFirstChildOfClass("ForceField") then
        return nil
    end
    if singleTargetMode(state) and player ~= frame.SingleTarget then
        return nil
    end
    local distance = 0
    if frame.LocalRoot then

        distance = math.sqrt(Util.distanceSquared(main.Position, frame.LocalRoot.Position))
    end
    if state.DistanceLimit and frame.LocalRoot and distance > state.MaxDistance then
        return nil
    end
    if state.FovHitboxEnabled and not targeted then
        local screenPoint, onScreen = frame.Camera:WorldToScreenPoint(main.Position)
        if not onScreen then
            return nil
        end
        local x, y = screenPoint.X - frame.Mouse.X, screenPoint.Y - frame.Mouse.Y
        if x * x + y * y > state.FOVSize * state.FOVSize then
            return nil
        end
    end
    local size, allowed = Sizing.resolve(state, distance)
    if not allowed then
        return nil
    end
    return Sizing.box(state, size)
end

local function speedOf(self: Self, key: any, position: Vector3, now: number): Vector3?
    local track = self.Tracks[key]
    if not track then
        self.Tracks[key] = { Position = position, Time = now, X = 0, Y = 0, Z = 0 }
        return nil
    end
    local elapsed = now - track.Time
    if elapsed < 0.002 then
        return Vector3.new(track.X, track.Y, track.Z)
    end
    local dx, dy, dz = (position.X - track.Position.X) / elapsed, (position.Y - track.Position.Y) / elapsed, (position.Z - track.Position.Z) / elapsed
    if dx * dx + dy * dy + dz * dz > 250 * 250 then
        dx, dy, dz = 0, 0, 0
    end
    track.X, track.Y, track.Z = track.X + (dx - track.X) * 0.6, track.Y + (dy - track.Y) * 0.6, track.Z + (dz - track.Z) * 0.6
    track.Position, track.Time = position, now
    return Vector3.new(track.X, track.Y, track.Z)
end

local function queueName(self: Self, anchor: any, text: string, color: Color3, alpha: number)
    Canvas.worldText(anchor.Position, NAME_SIZE, color, alpha, text, NAME_FONT, self.Velocity)
end

local function healthOf(humanoid: any): number?
    local ok, health, maximum = pcall(function()
        return humanoid.Health, humanoid.MaxHealth
    end)
    if not ok or type(health) ~= "number" or type(maximum) ~= "number" or maximum <= 0 then
        return nil
    end
    return math.clamp(health / maximum, 0, 1)
end

local function drawPlayers(self: Self, hitboxes: any, frame: Frame, localPosition: Vector3?)
    local state = self.State
    local maximum = math.max(0, tonumber(state.MaxDistance) or 0)
    local maximumSq = maximum * maximum
    local localTeam = self.LocalPlayer.Team
    local dynamicLimited = state.DynSizeEnabled == true and state.DisableBeyondMax == true
    local sharedStatic = nil
    if state.DynSizeEnabled then
        self.SharedStaticSize = nil
    else
        sharedStatic = smoothStatic(self, Sizing.box(state, tonumber(state.SizeAll) or 1), frame.Delta)
    end
    local filtered = state.FovHitboxEnabled or (state.DynSizeEnabled and state.DynSizeSingleTarget)
    local entries = hitboxes:getEntries()

    for _, player in frame.Players do
        if player ~= self.LocalPlayer and Parts.className(player) == "Player" then
            if filtered and not entries[player] then
                self.Cache[player] = nil
                self.SizeAnimations[player] = nil
            elseif state.TeamCheck and localTeam and player.Team == localTeam then
                self.Cache[player] = nil
                self.SizeAnimations[player] = nil
            else
                local character = player.Character
                if character then
                    local quick = self.Cache[player]
                    local main = quick and quick.Character == character and quick.MainPart or nil
                    if not Parts.valid(main) then
                        main = character:FindFirstChild("HumanoidRootPart")
                            or character:FindFirstChild("Torso")
                            or character:FindFirstChild("UpperTorso")
                    end
                    local allowed = Parts.valid(main)
                    local distance = 0
                    local distanceSq = nil
                    if allowed and localPosition then
                        distanceSq = Util.distanceSquared(main.Position, localPosition)
                        distance = math.sqrt(distanceSq)
                    end
                    if allowed and state.DistanceLimit and localPosition then
                        allowed = (distanceSq :: number) <= maximumSq
                    end
                    if allowed and dynamicLimited and localPosition then
                        local _, dynamicAllowed = Sizing.resolve(state, distance)
                        allowed = dynamicAllowed ~= false
                    end
                    if allowed and hitboxes:inDeadFolder(player) then
                        allowed = false
                    end
                    if allowed then
                        local cached = cachedParts(self, player, character)
                        local entry = entries[player]
                        local reason = entry and entry.FilterReason or nil
                        local skipped = reason == "wall" or reason == "invisible" or reason == "dead" or reason == "forcefield"
                        local desired = if skipped then nil else desiredBox(self, frame, player, cached)
                        if desired then

                            local shown = if hitboxes:isDefaultSized(player) then nil else (hitboxes:getExtensionSize(player) or desired)
                            if shown and sharedStatic and not state.PartSizesEnabled then
                                shown = sharedStatic
                            end
                            self.Velocity = speedOf(self, player, cached.MainPart.Position, os.clock())
                            local boxes = 0
                            local health = if state.VisShowHealth then healthOf(cached.Humanoid) else nil
                            for _, group in collectGroups(self, character, cached, entry ~= nil and entry.UpperOnly) do
                                local groupSize = if shown then Sizing.partBox(state, group.Key, shown) else nil
                                local boxFrame, boxSize, first = groupBounds(group, cached.MainPart, groupSize)
                                if boxFrame and boxSize then
                                    if state.DynSizeEnabled then
                                        boxSize = smoothSize(self, player, first, boxSize, frame.Delta)
                                    end

                                    local bar = if boxes == 0 then health else nil
                                    if state.VisStyle == "3D" then
                                        drawBox(self, boxFrame, boxSize, nil, bar)
                                    else
                                        drawFlat(self, first, cached.MainPart, boxSize, nil, bar)
                                    end
                                    boxes += 1
                                end
                            end
                            if boxes > 0 then
                                local label = if state.VisShowNames then player.Name else ""
                                if state.VisShowDistance and localPosition then
                                    label = (if label == "" then "" else label .. " ") .. "[" .. tostring(math.floor(distance + 0.5)) .. "]"
                                end
                                if label ~= "" then
                                    queueName(self, cached.MainPart, label, state.VisTextCol, state.VisTextTrans)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

local function drawEntities(self: Self)
    local state = self.State
    if state.NPCVisualize == false or not self.GetNPCVisualEntries then
        return
    end
    local ok, entities = pcall(self.GetNPCVisualEntries)
    if not ok or type(entities) ~= "table" then
        return
    end
    local style: Style = {
        LineCol = state.NPCVisLineCol,
        LineTrans = state.NPCVisLineTrans,
        FillCol = state.NPCVisFillCol,
        FillTrans = state.NPCVisFillTrans,
    }
    for model, entity in entities do
        local part = entity and entity.Part
        local target = entity and entity.Target
        if model and model.Parent and Parts.valid(part) and target then
            self.Velocity = speedOf(self, model, part.Position, os.clock())
            if state.VisStyle == "3D" then
                drawBox(self, part.CFrame, target, style, nil)
            else
                drawFlat(self, part, part, target, style, nil)
            end
            if state.NPCVisShowNames ~= false then
                Canvas.worldText(part.Position, NAME_SIZE, state.NPCVisTextCol, state.NPCVisTextTrans, model.Name, NAME_FONT, self.Velocity)
            end
        end
    end
end

function Visualizer.render(self: Self, hitboxes: any, frame: Frame)
    local camera = frame.Camera
    if not camera then
        return
    end
    local state = self.State
    local localPosition = frame.LocalRoot and frame.LocalRoot.Position or nil
    if state.DistanceLimit and not localPosition then
        return
    end
    if state.VisualizeHitbox == true and state.HitboxActive == true then
        drawPlayers(self, hitboxes, frame, localPosition)
    end
    drawEntities(self)
end

return Visualizer
end
modules["hitbox/wall-check"] = function(...)

type Wall = {
    Position: Vector3,
    Size: Vector3,
    Rotation: { number },
    Radius: number,
    RadiusSq: number,
}

type Grid = { [number]: { [number]: { number } } }

export type WallCheck = {
    State: { [string]: any },
    LocalPlayer: any,
    GetPlayers: () -> { any },
    Walls: { Wall },
    Grid: Grid,
    LargeWalls: { number },
    IgnoredParts: { [any]: boolean? },
    Ready: boolean,
    Running: boolean,
    Generation: number,
    OffsetsValid: boolean,
    LastValidation: number,
    ignorePart: (self: WallCheck, part: any) -> (),
    unignorePart: (self: WallCheck, part: any) -> (),
    canSee: (self: WallCheck, origin: Vector3, target: Vector3) -> boolean,
    start: (self: WallCheck) -> (),
    stop: (self: WallCheck) -> (),
}

local WallCheck = {}
WallCheck.__index = WallCheck

local OFFSETS = {
    WorkspaceWorld = 0x3F0,
    WorldPrimitives = 0x290,
    BasePartPrimitive = 0x188,
    PrimitiveRotation = 0xC8,
    PrimitivePosition = 0xEC,
    PrimitiveFlags = 0x1B6,
    PrimitiveSize = 0x1BC,
}

local CELL_SIZE = 64
local SCAN_LIMIT = 8000
local MAX_WALLS = 5000
local REFRESH_INTERVAL = 15
local VALIDATION_INTERVAL = 30
local SLICE_PRIMITIVES = 160
local SLICE_SECONDS = 0.00125
local MAX_GRID_CELLS_PER_WALL = 64
local MAX_INVALID_STREAK = 200
local MAX_RAY_CELLS = 256

local function plausible(address: any): boolean
    return type(address) == "number" and address > 0x10000 and address < 0x7FFFFFFFFFFF
end

local function bitSet(value: number, bit: number): boolean
    return math.floor(value / bit) % 2 == 1
end

local function validVector(value: any): boolean
    if not value then
        return false
    end
    local x, y, z = value.X, value.Y, value.Z
    if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
        return false
    end
    if x ~= x or y ~= y or z ~= z then
        return false
    end
    if math.abs(x) > 1000000 or math.abs(y) > 1000000 or math.abs(z) > 1000000 then
        return false
    end
    return not (x == 0 and y == 0 and z == 0)
end

local function readPrimitive(part: any): number?
    local ok, primitive = pcall(memory.readu64, part, OFFSETS.BasePartPrimitive)
    if ok and plausible(primitive) then
        return primitive
    end
    return nil
end

local function readWall(primitive: number): Wall?
    local flags = memory.readu8(primitive + OFFSETS.PrimitiveFlags)
    if not bitSet(flags, 8) or not bitSet(flags, 2) then
        return nil
    end
    local size = memory.readvector(primitive, OFFSETS.PrimitiveSize)
    if not validVector(size) then
        return nil
    end
    if size.X < 0.5 or size.Y < 0.5 or size.Z < 0.5 or size.X > 500 or size.Y > 500 or size.Z > 500 then
        return nil
    end
    local position = memory.readvector(primitive, OFFSETS.PrimitivePosition)
    if not validVector(position) then
        return nil
    end
    local rotation = {}
    for index = 0, 8 do
        local value = memory.readf32(primitive + OFFSETS.PrimitiveRotation + index * 4)
        if value ~= value or math.abs(value) > 10 then
            return nil
        end
        rotation[index + 1] = value
    end
    local radius = math.max(size.X, size.Y, size.Z) * 0.866
    return { Position = position, Size = size, Rotation = rotation, Radius = radius, RadiusSq = radius * radius }
end

local function readPrimitiveAt(base: number, index: number): any
    return memory.readu64(base + index * 8)
end

function WallCheck.new(context: { State: { [string]: any }, LocalPlayer: any, GetPlayers: () -> { any } }): WallCheck
    local self = {
        State = context.State,
        LocalPlayer = context.LocalPlayer,
        GetPlayers = context.GetPlayers,
        Walls = {},
        Grid = {},
        LargeWalls = {},
        IgnoredParts = setmetatable({}, { __mode = "k" }),
        Ready = false,
        Running = false,
        Generation = 0,
        OffsetsValid = false,
        LastValidation = 0,
    }
    return setmetatable(self, WallCheck) :: any
end

function WallCheck.ignorePart(self: WallCheck, part: any)
    if part then
        self.IgnoredParts[part] = true
    end
end

function WallCheck.unignorePart(self: WallCheck, part: any)
    if part then
        self.IgnoredParts[part] = nil
    end
end

local function characterOf(player: any): any
    local ok, character = pcall(function()
        return player.Character
    end)
    return ok and character or nil
end

local function anchorPart(character: any): any
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

local function offsetsValid(self: WallCheck): boolean
    if type(memory) ~= "table" or type(memory.readu64) ~= "function" or type(memory.readu8) ~= "function" then
        return false
    end
    if type(memory.readf32) ~= "function" or type(memory.readvector) ~= "function" then
        return false
    end
    local ok, world = pcall(memory.readu64, workspace, OFFSETS.WorkspaceWorld)
    if not ok or not plausible(world) then
        return false
    end
    local primitives
    ok, primitives = pcall(memory.readu64, world + OFFSETS.WorldPrimitives)
    if not ok or not plausible(primitives) then
        return false
    end

    local candidate = nil
    for _, player in self.GetPlayers() do
        local character = characterOf(player)
        if character then
            candidate = anchorPart(character)
            if candidate then
                break
            end
        end
    end
    if not candidate then
        local own = characterOf(self.LocalPlayer)
        candidate = own and anchorPart(own)
    end
    if not candidate then
        return true
    end

    local primitive = readPrimitive(candidate)
    if not primitive then
        return false
    end
    local sizeOk, memorySize, partSize = pcall(function()
        return memory.readvector(primitive, OFFSETS.PrimitiveSize), candidate.Size
    end)
    if not sizeOk or not memorySize or not partSize then
        return false
    end
    return math.abs(memorySize.X - partSize.X) < 0.1
        and math.abs(memorySize.Y - partSize.Y) < 0.1
        and math.abs(memorySize.Z - partSize.Z) < 0.1
end

local function ignoredPrimitives(self: WallCheck): { [number]: boolean }
    local ignored: { [number]: boolean } = {}
    local function addChildren(character: any)
        local ok, children = pcall(function()
            return character:GetChildren()
        end)
        if not ok then
            return
        end
        for _, child in children do
            local primitive = readPrimitive(child)
            if primitive then
                ignored[primitive] = true
            end
        end
    end
    for _, player in self.GetPlayers() do
        local character = characterOf(player)
        if character then
            addChildren(character)
        end
    end
    local own = characterOf(self.LocalPlayer)
    if own then
        addChildren(own)
    end
    for part in self.IgnoredParts do
        local primitive = readPrimitive(part)
        if primitive then
            ignored[primitive] = true
        end
    end
    return ignored
end

local function indexWall(grid: Grid, large: { number }, wall: Wall, index: number)
    local radius = wall.Radius
    local x0 = math.floor((wall.Position.X - radius) / CELL_SIZE)
    local x1 = math.floor((wall.Position.X + radius) / CELL_SIZE)
    local z0 = math.floor((wall.Position.Z - radius) / CELL_SIZE)
    local z1 = math.floor((wall.Position.Z + radius) / CELL_SIZE)
    if (x1 - x0 + 1) * (z1 - z0 + 1) > MAX_GRID_CELLS_PER_WALL then
        large[#large + 1] = index
        return
    end
    for x = x0, x1 do
        local column = grid[x]
        if not column then
            column = {}
            grid[x] = column
        end
        for z = z0, z1 do
            local bucket = column[z]
            if not bucket then
                bucket = {}
                column[z] = bucket
            end
            bucket[#bucket + 1] = index
        end
    end
end

local function scan(self: WallCheck, generation: number): boolean
    local worldOk, world = pcall(memory.readu64, workspace, OFFSETS.WorkspaceWorld)
    if not worldOk or not plausible(world) then
        return false
    end
    local baseOk, base = pcall(memory.readu64, world + OFFSETS.WorldPrimitives)
    if not baseOk or not plausible(base) then
        return false
    end
    local ignored = ignoredPrimitives(self)
    local walls: { Wall } = {}
    local grid: Grid = {}
    local large: { number } = {}
    local invalidStreak = 0
    local index = 0

    local function active(): boolean
        return self.Running and self.Generation == generation and self.State.WallCheck ~= false
    end

    while index < SCAN_LIMIT and #walls < MAX_WALLS and active() do
        local started = os.clock()
        local processed = 0
        while index < SCAN_LIMIT and processed < SLICE_PRIMITIVES and #walls < MAX_WALLS do
            local readOk, primitive = pcall(readPrimitiveAt, base, index)
            index += 1
            processed += 1
            if readOk and plausible(primitive) then
                invalidStreak = 0
                if not ignored[primitive] then
                    local valid, wall = pcall(readWall, primitive)
                    if valid and wall then
                        walls[#walls + 1] = wall
                        indexWall(grid, large, wall, #walls)
                    end
                end
            else
                invalidStreak += 1
                if invalidStreak > MAX_INVALID_STREAK then
                    index = SCAN_LIMIT
                    break
                end
            end
            if os.clock() - started >= SLICE_SECONDS then
                break
            end
        end
        if index < SCAN_LIMIT and #walls < MAX_WALLS then
            task.wait()
        end
    end

    if not active() then
        return false
    end
    self.Walls = walls
    self.Grid = grid
    self.LargeWalls = large
    self.Ready = true
    return true
end

local function clipAxis(position: number, direction: number, half: number, entering: number, leaving: number): (boolean, number, number)
    if math.abs(direction) < 0.000001 then
        return position >= -half and position <= half, entering, leaving
    end
    local first = (-half - position) / direction
    local second = (half - position) / direction
    if first > second then
        first, second = second, first
    end
    entering = math.max(entering, first)
    leaving = math.min(leaving, second)
    return entering <= leaving, entering, leaving
end

local function segmentHitsWall(origin: Vector3, target: Vector3, wall: Wall): boolean
    local dx = target.X - origin.X
    local dy = target.Y - origin.Y
    local dz = target.Z - origin.Z
    local lengthSq = dx * dx + dy * dy + dz * dz
    if lengthSq < 0.000001 then
        return false
    end
    local length = math.sqrt(lengthSq)
    dx, dy, dz = dx / length, dy / length, dz / length

    local relX = origin.X - wall.Position.X
    local relY = origin.Y - wall.Position.Y
    local relZ = origin.Z - wall.Position.Z
    local m = wall.Rotation
    local hit, entering, leaving = clipAxis(
        relX * m[1] + relY * m[4] + relZ * m[7],
        dx * m[1] + dy * m[4] + dz * m[7],
        wall.Size.X * 0.5,
        0,
        length
    )
    if not hit then
        return false
    end
    hit, entering, leaving = clipAxis(
        relX * m[2] + relY * m[5] + relZ * m[8],
        dx * m[2] + dy * m[5] + dz * m[8],
        wall.Size.Y * 0.5,
        entering,
        leaving
    )
    if not hit then
        return false
    end
    hit, entering, leaving = clipAxis(
        relX * m[3] + relY * m[6] + relZ * m[9],
        dx * m[3] + dy * m[6] + dz * m[9],
        wall.Size.Z * 0.5,
        entering,
        leaving
    )
    if not hit then
        return false
    end
    return entering <= length + 0.000001 and leaving >= -0.000001
end

local function anyBlocking(self: WallCheck, origin: Vector3, target: Vector3, indexes: { number }?, visited: { [number]: boolean }): boolean
    if not indexes then
        return false
    end
    local dx = target.X - origin.X
    local dy = target.Y - origin.Y
    local dz = target.Z - origin.Z
    local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
    if distance < 0.000001 then
        return false
    end
    local ux, uy, uz = dx / distance, dy / distance, dz / distance
    for item = 1, #indexes do
        local index = indexes[item]
        if not visited[index] then
            visited[index] = true
            local wall = self.Walls[index]
            if wall then
                local cx = wall.Position.X - origin.X
                local cy = wall.Position.Y - origin.Y
                local cz = wall.Position.Z - origin.Z
                local projection = cx * ux + cy * uy + cz * uz
                if projection >= -1 and projection <= distance + 1 then
                    local perpendicularSq = cx * cx + cy * cy + cz * cz - projection * projection
                    if perpendicularSq <= wall.RadiusSq and segmentHitsWall(origin, target, wall) then
                        return true
                    end
                end
            end
        end
    end
    return false
end

function WallCheck.canSee(self: WallCheck, origin: Vector3, target: Vector3): boolean
    if not self.Ready or not validVector(origin) or not validVector(target) then
        return true
    end
    local startX = math.floor(origin.X / CELL_SIZE)
    local startZ = math.floor(origin.Z / CELL_SIZE)
    local endX = math.floor(target.X / CELL_SIZE)
    local endZ = math.floor(target.Z / CELL_SIZE)
    local dx = target.X - origin.X
    local dz = target.Z - origin.Z
    local stepX = if dx >= 0 then 1 else -1
    local stepZ = if dz >= 0 then 1 else -1
    local deltaX = if math.abs(dx) < 0.000001 then math.huge else math.abs(CELL_SIZE / dx)
    local deltaZ = if math.abs(dz) < 0.000001 then math.huge else math.abs(CELL_SIZE / dz)
    local boundaryX = if stepX > 0 then (startX + 1) * CELL_SIZE else startX * CELL_SIZE
    local boundaryZ = if stepZ > 0 then (startZ + 1) * CELL_SIZE else startZ * CELL_SIZE
    local nextX = if math.abs(dx) < 0.000001 then math.huge else math.abs((boundaryX - origin.X) / dx)
    local nextZ = if math.abs(dz) < 0.000001 then math.huge else math.abs((boundaryZ - origin.Z) / dz)
    local x, z = startX, startZ
    local visited: { [number]: boolean } = {}

    if anyBlocking(self, origin, target, self.LargeWalls, visited) then
        return false
    end
    for _ = 1, MAX_RAY_CELLS do
        local column = self.Grid[x]
        if column and anyBlocking(self, origin, target, column[z], visited) then
            return false
        end
        if x == endX and z == endZ then
            break
        end
        if nextX < nextZ then
            x += stepX
            nextX += deltaX
        elseif nextZ < nextX then
            z += stepZ
            nextZ += deltaZ
        else
            x += stepX
            z += stepZ
            nextX += deltaX
            nextZ += deltaZ
        end
    end
    return true
end

function WallCheck.start(self: WallCheck)
    if self.Running then
        return
    end
    self.Generation += 1
    local generation = self.Generation
    self.Running = true
    task.spawn(function()
        local function current(): boolean
            return self.Running and self.Generation == generation
        end
        while current() do
            if self.State.WallCheck ~= false then
                local now = os.clock()
                if not self.OffsetsValid or now - self.LastValidation >= VALIDATION_INTERVAL then
                    self.LastValidation = now
                    local ok, valid = pcall(offsetsValid, self)
                    self.OffsetsValid = ok and valid == true
                    if not self.OffsetsValid then
                        self.Ready = false
                    end
                end
                if self.OffsetsValid then
                    pcall(scan, self, generation)
                end
                local waited = 0
                while current() and waited < REFRESH_INTERVAL and self.State.WallCheck ~= false do
                    task.wait(0.25)
                    waited += 0.25
                end
            else
                self.Ready = false
                task.wait(0.25)
            end
        end
    end)
end

function WallCheck.stop(self: WallCheck)
    self.Generation += 1
    self.Running = false
    self.Walls = {}
    self.Grid = {}
    self.LargeWalls = {}
    self.Ready = false
end

return WallCheck
end
