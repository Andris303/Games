local TITLE_HEIGHT, DATE_HEIGHT, LINE_HEIGHT, PAGE_HEIGHT = 50, 36, 20, 290

local function changelogTab(): { [string]: any }
    local function title(text: string): { [string]: any }
        return Spec.text(text, { size = 39, height = TITLE_HEIGHT, accent = true, center = true })
    end
    local function date(text: string): { [string]: any }
        return Spec.text(text, { size = 24, height = DATE_HEIGHT, accent = true, center = true })
    end
    local function line(text: string): { [string]: any }
        return Spec.text(text, { size = 14.1, height = LINE_HEIGHT, center = true })
    end
    local sections = {}
    for _, entry in Changelog.PAGES do
        local content = TITLE_HEIGHT + DATE_HEIGHT + #entry.Lines * LINE_HEIGHT
        local rows = {
            Spec.text("", { height = math.max(0, math.floor((PAGE_HEIGHT - content) / 2)) }),
            title(entry.Title),
            date(entry.Date),
        }
        for _, text in entry.Lines do
            rows[#rows + 1] = line(text)
        end
        sections[#sections + 1] = Spec.section(string.upper(entry.Label), rows)
    end
    local older = {}
    for _, entry in Changelog.OLDER do
        older[#older + 1] = Spec.button(entry.Date .. "   " .. entry.Title, function(a: App)
            a.Browser.ChangelogPage = 1
            a:togglePopup("changelog", entry.Id)
        end)
    end
    sections[#sections + 1] = Spec.section("OLDER", older)
    return Spec.tab("Changelog", "Updates", sections)
end

local GAME_ROW_LENGTH = 40

local function gameRows(names: { string }): { { string } }
    local rows: { { string } } = {}
    local current: { string } = {}
    local length = 0
    for _, name in names do
        if #current > 0 and length + #name > GAME_ROW_LENGTH then
            table.insert(rows, current)
            current, length = {}, 0
        end
        table.insert(current, name)
        length += #name
    end
    if #current > 0 then
        table.insert(rows, current)
    end
    return rows
end

local function infoTab(): { [string]: any }
    local function line(entry: { text: string, heading: boolean }): { [string]: any }
        local heading = entry.heading
        return Spec.text(entry.text, {
            size = if heading then 14 else 12.25,
            height = if heading then 19 else 15.2,
            accent = heading,
        })
    end
    local function plain(text: string): { text: string, heading: boolean }
        return { text = text, heading = false }
    end
    local function heading(text: string): { text: string, heading: boolean }
        return { text = text, heading = true }
    end
    local leftLines = {
        heading("INFO"),
        plain("HumanoidRootPart (HRP) is recommended for"),
        plain("the widest universal compatibility."),
        plain("Other target parts may behave differently"),
        plain("depending on the game's hit validation."),
    }
    local rightLines = {
        heading("SUPPORT"),
        plain("If there is a game where this doesn't"),
        plain("work in it, lmk in the severe discord"),
        plain("server."),
        plain("If you encounter any bugs also lmk in"),
        plain("the discord server."),
    }
    local rows: { { [string]: any } } = {}
    for index = 1, math.max(#leftLines, #rightLines) do
        rows[index] = Spec.pair(line(leftLines[index] or plain("")), line(rightLines[index] or plain("")))
    end
    table.insert(rows, Spec.text("", { height = 8 }))
    table.insert(rows, Spec.chips("CUSTOM SUPPORTED GAMES", gameRows(Profiles.BUILT_IN_NAMES)))
    return Spec.tab("Info", "About", { Spec.section("ABOUT", rows) })
end

return function(app: App): { { [string]: any } }
    return { keybindsTab(app), configTab(), changelogTab(), infoTab() }
end
end
modules["ui/painter"] = function(...)

local import: (string) -> any = ...
local Draw: typeof(require("../render/draw")) = import("render/draw")

local Painter = {}

type Pool = {
    squares: { any },
    texts: { any },
    squareCount: number,
    textCount: number,
}

local pool: Pool = { squares = {}, texts = {}, squareCount = 0, textCount = 0 }
local shownSquares = 0
local shownTexts = 0
local white = Color3.new(1, 1, 1)

local corner = 0.46

local Z_SLOT = 512
local order = 0

local function depth(zIndex: number): number
    order += 1
    return zIndex * Z_SLOT + math.min(order, Z_SLOT - 1)
end

function Painter.setCorner(value: number)
    corner = math.clamp(value, 0, 0.6)
end

function Painter.corner(): number
    return corner
end

function Painter.begin()
    order = 0
    pool.squareCount = 0
    pool.textCount = 0
end

function Painter.finish()
    for index = pool.squareCount + 1, shownSquares do
        pool.squares[index]:show(false)
    end
    for index = pool.textCount + 1, shownTexts do
        pool.texts[index]:show(false)
    end
    shownSquares = pool.squareCount
    shownTexts = pool.textCount
end

function Painter.hideAll()
    pool.squareCount = 0
    pool.textCount = 0
    Painter.finish()
end

function Painter.rect(position: Vector2, size: Vector2, color: Color3, alpha: number, zIndex: number, rounding: number?, absolute: boolean?)
    local z = depth(zIndex)
    if alpha <= 0.004 or size.X < 1 or size.Y < 1 then
        return
    end
    local index = pool.squareCount + 1
    pool.squareCount = index
    local node = pool.squares[index]
    if not node then
        node = Draw.square(true, white, 1, 1, 0)
        pool.squares[index] = node
    end
    node:set("Position", position)
    node:set("Size", size)
    node:set("Color", color)
    local radius = if absolute then math.min(rounding or 0, math.min(size.X, size.Y) * 0.5) else (rounding or 0) * corner
    node:set("Rounding", radius)
    node:set("ZIndex", z)
    node:setAlpha(math.clamp(alpha, 0, 1))
    node:show(true)
end

function Painter.text(
    text: string,
    position: Vector2,
    size: number,
    color: Color3,
    alpha: number,
    zIndex: number,
    center: boolean?,
    middle: boolean?
)
    local z = depth(zIndex)
    if alpha <= 0.004 or text == "" then
        return
    end
    local index = pool.textCount + 1
    pool.textCount = index
    local node = pool.texts[index]
    if not node then
        node = Draw.text("", 13, false, white, 1)
        pool.texts[index] = node
    end
    local drawSize = math.max(1, math.ceil(size))
    node:set("Text", text)
    node:setTextSize(drawSize)
    node:set("Font", Draw.font())
    node:set("Center", center == true)
    node:set("Color", color)
    node:set("ZIndex", z)
    node:set("Position", if middle then Vector2.new(position.X, position.Y - drawSize * 0.5) else position)
    node:setAlpha(math.clamp(alpha, 0, 1))
    node:show(true)
end

local probe: any = nil
local widths: { [string]: number } = {}
local widthCount = 0
local MAX_CACHED_WIDTHS = 256

function Painter.textWidth(text: string, size: number): number
    local rounded = math.max(1, math.ceil(size))
    local key = tostring(Draw.font()) .. ":" .. tostring(rounded) .. ":" .. text
    local cached = widths[key]
    if cached then
        return cached
    end
    if not probe then
        probe = Draw.text("", 13, false, white, 1)
    end
    probe:set("Text", text)
    probe:set("Size", rounded)
    probe:set("Font", Draw.font())
    local ok, bounds = pcall(function()
        return probe.object.TextBounds
    end)
    local width = if ok and bounds then bounds.X else #text * rounded * 0.5
    if widthCount >= MAX_CACHED_WIDTHS then
        widths = {}
        widthCount = 0
    end
    widths[key] = width
    widthCount += 1
    return width
end

function Painter.reset()
    pool.squares, pool.texts = {}, {}
    pool.squareCount, pool.textCount = 0, 0
    shownSquares, shownTexts = 0, 0
    probe = nil
    widths = {}
    widthCount = 0
end

return Painter
end
modules["ui/palette"] = function(...)

local import: (string) -> any = ...
local Color: typeof(require("../core/color")) = import("core/color")
local Theme: typeof(require("../core/theme")) = import("core/theme")
local Motion: typeof(require("./motion")) = import("ui/motion")

local Palette = {}

export type Colors = {
    Main: Color3,
    Panel: Color3,
    Off: Color3,
    Text: Color3,
    Sub: Color3,
    Disabled: Color3,
    Accent: Color3,
    Light: number,
}

local LIGHT_MAIN = Color3.fromRGB(251, 241, 199)
local LIGHT_PANEL = Color3.fromRGB(235, 219, 178)
local LIGHT_OFF = Color3.fromRGB(213, 196, 161)
local LIGHT_TEXT = Color3.fromRGB(60, 56, 54)
local LIGHT_SUB = Color3.fromRGB(124, 111, 100)

function Palette.glide(state: { [string]: any }, colorKeys: { [string]: boolean }, dt: number)
    local factor = 1 - math.exp(-4.5 * dt)
    for key in colorKeys do
        local target = state["Target_" .. key]
        if not target then
            state["Target_" .. key] = state[key]
        elseif state[key] ~= target then
            state[key] = Color.lerp(state[key], target, factor)
        end
    end
end

function Palette.compute(state: { [string]: any }, dt: number): Colors
    state.LightAlpha = Motion.ease(state, state.LightAlpha or (if state.LightMode then 1 else 0), if state.LightMode then 1 else 0, dt, 4.5)
    local light: number = state.LightAlpha

    local main: Color3 = state.MainCol
    local r, g, b = main.R, main.G, main.B
    local bright = 0.299 * r + 0.587 * g + 0.114 * b > 0.5
    local accent: Color3 = state.AccentCol
    local panel, off, text, sub, disabled

    if state.ThemeName == "Custom" then
        if bright then
            panel = Color3.new(math.clamp(r - 0.04, 0, 1), math.clamp(g - 0.04, 0, 1), math.clamp(b - 0.04, 0, 1))
            off = Color3.new(math.clamp(r - 0.10, 0, 1), math.clamp(g - 0.10, 0, 1), math.clamp(b - 0.10, 0, 1))
            text = Color.lerp(Color3.new(0.1, 0.1, 0.1), Color.lerp(accent, Color3.new(0, 0, 0), 0.65), 0.12)
            sub = Color.lerp(Color3.new(0.25, 0.25, 0.25), Color.lerp(accent, Color3.new(0, 0, 0), 0.5), 0.2)
        else
            panel = Color.lerp(main, Color3.new(1, 1, 1), 0.075)
            off = Color.lerp(main, Color3.new(1, 1, 1), 0.17)
            text = Color.lerp(Color3.new(0.93, 0.93, 0.93), Color.lighten(accent, 0.85), 0.12)
            sub = Color.lerp(Color3.new(0.66, 0.66, 0.66), Color.lighten(accent, 0.45), 0.2)
        end
        disabled = Color.lerp(sub, main, 0.5)
    else
        local base = state.ThemePreset or Theme.Presets.Gruvbox
        local function shifted(color: Color3): Color3
            return Color3.new(
                math.clamp(color.R + r - base.Main.R, 0, 1),
                math.clamp(color.G + g - base.Main.G, 0, 1),
                math.clamp(color.B + b - base.Main.B, 0, 1)
            )
        end
        panel, off = shifted(base.Panel), shifted(base.Off)
        text, sub = base.Text, base.Sub
        local away = math.abs(accent.R - base.Accent.R) + math.abs(accent.G - base.Accent.G) + math.abs(accent.B - base.Accent.B)
        local tint = math.clamp(away * 1.5, 0, 1) * 0.7
        if bright then
            panel = Color3.new(math.clamp(r - 0.04, 0, 1), math.clamp(g - 0.04, 0, 1), math.clamp(b - 0.04, 0, 1))
            off = Color3.new(math.clamp(r - 0.10, 0, 1), math.clamp(g - 0.10, 0, 1), math.clamp(b - 0.10, 0, 1))
            text, sub = Color3.new(0.1, 0.1, 0.1), Color3.new(0.25, 0.25, 0.25)
            text, sub = Color.lerp(text, Color.lerp(accent, Color3.new(0, 0, 0), 0.65), tint), Color.lerp(sub, Color.lerp(accent, Color3.new(0, 0, 0), 0.5), tint)
        else
            text, sub = Color.lerp(text, Color.lighten(accent, 0.85), tint), Color.lerp(sub, Color.lighten(accent, 0.45), tint)
        end
        disabled = base.Disabled or Theme.Disabled
    end

    local target: Colors = {
        Main = Color.lerp(main, LIGHT_MAIN, light),
        Panel = Color.lerp(panel, LIGHT_PANEL, light),
        Off = Color.lerp(off, LIGHT_OFF, light),
        Text = Color.lerp(text, LIGHT_TEXT, light),
        Sub = Color.lerp(sub, LIGHT_SUB, light),
        Disabled = Color.lerp(disabled, Color.lerp(LIGHT_SUB, LIGHT_MAIN, 0.5), light),
        Accent = state.AccentCol,
        Light = light,
    }

    local shown: Colors? = state.PaletteShown
    if not shown then
        state.PaletteShown = target
        return target
    end
    local factor = 1 - math.exp(-9 * math.clamp(dt, 0, 0.05))
    shown.Main = Color.lerp(shown.Main, target.Main, factor)
    shown.Panel = Color.lerp(shown.Panel, target.Panel, factor)
    shown.Off = Color.lerp(shown.Off, target.Off, factor)
    shown.Text = Color.lerp(shown.Text, target.Text, factor)
    shown.Sub = Color.lerp(shown.Sub, target.Sub, factor)
    shown.Disabled = Color.lerp(shown.Disabled, target.Disabled, factor)
    shown.Accent = target.Accent
    shown.Light = light
    return shown
end

return Palette
end
modules["ui/picker"] = function(...)

local import: (string) -> any = ...
local Color: typeof(require("../core/color")) = import("core/color")
local Settings: typeof(require("../state/settings")) = import("state/settings")
local Theme: typeof(require("../core/theme")) = import("core/theme")

local Picker = {}
Picker.__index = Picker

type App = { [string]: any }

function Picker.new(app: App)
    return setmetatable({
        App = app,
        Target = nil :: string?,
        Color = Color3.new(1, 1, 1),
        H = 0,
        S = 0,
        V = 1,
        Alpha = 1,
        Memory = {} :: { [string]: { [string]: any } },
    }, Picker)
end

type Self = typeof(Picker.new(nil :: any))

local function sameColor(first: Color3, second: Color3): boolean
    return math.abs(first.R - second.R) < 0.000001
        and math.abs(first.G - second.G) < 0.000001
        and math.abs(first.B - second.B) < 0.000001
end

function Picker.syncInputs(self: Self)
    local buffers = self.App.Buffers
    local color = self.Color
    local hex = string.gsub(Color.toHex(color), "#", "")
    buffers.Hex = string.upper(hex)
    buffers.Red = tostring(Color.channel(color.R))
    buffers.Green = tostring(Color.channel(color.G))
    buffers.Blue = tostring(Color.channel(color.B))
end

local function remember(self: Self)
    if self.Target then
        self.Memory[self.Target] = { Color = self.Color, H = self.H, S = self.S, V = self.V, Alpha = self.Alpha }
    end
end

function Picker.commit(self: Self)
    local target = self.Target
    if not target then
        return
    end
    local state = self.App.State
    state[target] = self.Color
    state["Target_" .. target] = self.Color
    local alphaKey = Settings.ALPHA_KEYS[target]
    if alphaKey then
        state[alphaKey] = self.Alpha
        state["Target_" .. alphaKey] = self.Alpha
    end
    remember(self)
    if target == "MainCol" or target == "AccentCol" then
        self.App:colorEdited()
    end
end

function Picker.setColor(self: Self, color: Color3)
    self.Color = color
    self.H, self.S, self.V = color:ToHSV()
    self:syncInputs()
    self:commit()
end

function Picker.setHSV(self: Self, h: number?, s: number?, v: number?)
    self.H = h or self.H
    self.S = s or self.S
    self.V = v or self.V
    self.Color = Color.fromHSV(self.H, self.S, self.V)
    self:syncInputs()
    self:commit()
end

function Picker.open(self: Self, target: string)
    local state = self.App.State
    self.Target = target
    local source: Color3 = state["Target_" .. target] or state[target]
    self.Color = source
    local memory = self.Memory[target]
    if memory and sameColor(memory.Color, source) then
        self.H, self.S, self.V, self.Alpha = memory.H, memory.S, memory.V, memory.Alpha
    else
        self.H, self.S, self.V = source:ToHSV()
        local alphaKey = Settings.ALPHA_KEYS[target]
        self.Alpha = if alphaKey then state[alphaKey] else 0
        remember(self)
    end
    self:syncInputs()
end

local function defaultFor(target: string): Color3
    if target == "MainCol" then
        return Theme.BgBase
    elseif target == "AccentCol" or target == "FOVColor" then
        return Theme.Accent
    elseif target == "NPCVisLineCol" then
        return Theme.EntityLine
    elseif target == "NPCVisFillCol" or target == "NPCVisTextCol" then
        return Theme.EntityFill
    end
    return Color3.new(1, 1, 1)
end

function Picker.reset(self: Self)
    if self.Target then
        self:setColor(defaultFor(self.Target))
    end
end

function Picker.applyField(self: Self, field: string)
    local buffers = self.App.Buffers
    if field == "Hex" then
        local color = Color.fromHex(buffers.Hex)
        if color then
            self:setColor(color)
        else
            self:syncInputs()
        end
        return
    end
    local value = tonumber(buffers[field])
    if not value then
        self:syncInputs()
        return
    end
    value = math.clamp(math.floor(value + 0.5), 0, 255)
    local r, g, b = Color.channel(self.Color.R), Color.channel(self.Color.G), Color.channel(self.Color.B)
    if field == "Red" then
        r = value
    elseif field == "Green" then
        g = value
    elseif field == "Blue" then
        b = value
    end
    self:setColor(Color3.fromRGB(r, g, b))
end

return Picker
end
