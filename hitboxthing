modules["entities/groups"] = function(...)

local import: (string) -> any = ...
local Models: typeof(require("./models")) = import("entities/models")
local Paths: typeof(require("./paths")) = import("entities/paths")
local Util: typeof(require("../core/util")) = import("core/util")

local Groups = {}

export type Group = { [string]: any }

export type Registry = {
    State: { [string]: any },
    LocalPlayer: any,
    GetPlayers: () -> { any },
    Models: any,
    Groups: { [string]: Group },
    GroupOrder: { Group },
    SearchOrder: { Group },
    ModelToGroup: { [any]: Group },
    SearchMembership: { [any]: { [Group]: boolean } },
    SearchByWord: { [string]: Group },
    PathGroupByPath: { [string]: Group },
    LastSearch: Group?,
    EnabledCount: number,
    Found: number,
    PlayerCharacters: { [any]: boolean },
    PlayerNames: { [string]: boolean },
    PlayerCharactersNext: number,
    DeadPath: string?,
    DeadPathContainer: any,
    DeadPathResolveAt: number,
    AsyncGeneration: number,
    ScanGeneration: number,
    Scanning: boolean,
    Scanned: number,
    ScanQueue: { any },
    ScanHead: number,
    SearchServiceRunning: boolean,
    SearchServiceCursor: number,
    CandidateGroupCursor: number,
}

local PLAYER_REFRESH_INTERVAL = 0.5
local OWNER_SEARCH_DEPTH = 16
local DEAD_PATH_RESOLVE_INTERVAL = 0.5
local DEAD_PATH_DEPTH = 32

local function weakSet(): { [any]: any }
    return setmetatable({}, { __mode = "k" }) :: any
end

Groups.weakSet = weakSet

local function refreshPlayers(registry: Registry, now: number)
    if now < registry.PlayerCharactersNext then
        return
    end
    registry.PlayerCharactersNext = now + PLAYER_REFRESH_INTERVAL
    local characters = weakSet()
    local names: { [string]: boolean } = {}
    for _, player in registry.GetPlayers() do
        local character = Util.read(player, "Character")
        local name = tostring(Util.read(player, "Name") or "")
        if character then
            characters[character] = true
        end
        if name ~= "" then
            names[name] = true
        end
    end
    registry.PlayerCharacters = characters
    registry.PlayerNames = names
end

function Groups.isPlayerOwned(registry: Registry, object: any): boolean
    if not object then
        return false
    end
    refreshPlayers(registry, os.clock())
    local localCharacter = Util.read(registry.LocalPlayer, "Character")
    local current = object
    for _ = 1, OWNER_SEARCH_DEPTH do
        if not current then
            break
        end
        if current == localCharacter or registry.PlayerCharacters[current] == true then
            return true
        end
        local className = tostring(Util.read(current, "ClassName") or "")
        local name = tostring(Util.read(current, "Name") or "")
        if className == "Model" and name ~= "" and registry.PlayerNames[name] == true then
            return true
        end
        current = Util.read(current, "Parent")
    end
    return false
end

function Groups.isPathEntity(registry: Registry, model: any, playerCharacters: { [any]: boolean }?): boolean
    if not model then
        return false
    end
    if registry.State.DeadCheck ~= false and Groups.inDeadPath(registry, model) then
        return false
    end
    if tostring(Util.read(model, "ClassName") or "") ~= "Model" then
        return false
    end
    if playerCharacters and playerCharacters[model] then
        return false
    end
    if Groups.isPlayerOwned(registry, model) then
        return false
    end
    return Models.entityParts(model) ~= nil
end

function Groups.groupFor(registry: Registry, model: any): Group?
    return registry.ModelToGroup[model]
end

function Groups.memberEnabled(group: Group?, model: any): boolean
    local value = group and group.MemberEnabled and group.MemberEnabled[model]
    return value ~= false
end

function Groups.modelEnabled(registry: Registry, model: any): boolean
    if registry.State.NPCHitboxEnabled == false or not model or not model.Parent or Groups.isPlayerOwned(registry, model) then
        return false
    end
    local group = registry.ModelToGroup[model]
    if group and group.Enabled == true and Groups.memberEnabled(group, model) then
        return true
    end
    local searches = registry.SearchMembership[model]
    if searches then
        for search in searches do
            if search and search.Enabled == true and Groups.memberEnabled(search, model) then
                return true
            end
        end
    end
    return false
end

function Groups.sizeFor(registry: Registry, model: any): number?
    local group = registry.ModelToGroup[model]
    if group and group.Enabled == true and group.Size and Groups.memberEnabled(group, model) then
        return group.Size
    end
    local searches = registry.SearchMembership[model]
    if searches then
        for search in searches do
            if search and search.Enabled == true and search.Size and Groups.memberEnabled(search, model) then
                return search.Size
            end
        end
    end
    return nil
end

function Groups.hasEnabledGroups(registry: Registry): boolean
    return registry.State.NPCHitboxEnabled ~= false and registry.EnabledCount > 0
end

function Groups.setEnabled(registry: Registry, group: Group?, enabled: boolean)
    if not group then
        return
    end
    local nextValue = enabled == true
    if (group.Enabled == true) == nextValue then
        return
    end
    group.Enabled = nextValue
    registry.EnabledCount = math.max(0, registry.EnabledCount + (if nextValue then 1 else -1))
    if nextValue and group.Search then
        group.NextPoll = 0
    end
    if group.Search then
        Groups.schedulePathSave(group)
    end
end

function Groups.schedulePathSave(group: Group?)
    if not group or not group.Search or group.Removed then
        return
    end
    group.PathSaveDue = os.clock() + 0.35
end

function Groups.removeMember(group: Group?, model: any)
    if not group or not model then
        return
    end
    for index = #group.Members, 1, -1 do
        if group.Members[index] == model then
            table.remove(group.Members, index)
            break
        end
    end
    if group.MemberEnabled then
        group.MemberEnabled[model] = nil
    end
end

function Groups.addToGroup(registry: Registry, group: Group, model: any): boolean
    local current = registry.ModelToGroup[model]
    if current == group then
        if group.Enabled and not registry.Models.Extended[model] then
            registry.Models:sync(model)
        end
        return false
    end
    if current then
        Groups.removeMember(current, model)
    end
    group.Members[#group.Members + 1] = model
    group.MemberEnabled[model] = true
    registry.ModelToGroup[model] = group
    if group.Enabled then
        registry.Models:sync(model)
    end
    return true
end

local function groupName(name: string): string
    local grouped = string.gsub(name, "[%s_%-]*%d+$", "")
    grouped = string.gsub(grouped, "[%s_%-]+$", "")
    if grouped == "" then
        return name
    end
    return grouped
end

function Groups.registerScanned(registry: Registry, model: any)
    if not Groups.isPathEntity(registry, model, registry.PlayerCharacters) then
        return
    end
    local name = groupName(tostring(model.Name or "NPC"))
    local key = string.lower(name)
    local group = registry.Groups[key]
    if not group then
        group = {
            Key = key,
            Name = name,
            Enabled = false,
            Members = {},
            MemberEnabled = weakSet(),
        }
        registry.Groups[key] = group
        registry.GroupOrder[#registry.GroupOrder + 1] = group
    end
    if Groups.addToGroup(registry, group, model) then
        registry.Found += 1
    end
end

function Groups.liveCount(group: Group?): number
    local count = 0
    if not group then
        return count
    end
    for _, model in group.Members do
        if model and model.Parent then
            count += 1
        end
    end
    return count
end

function Groups.newSearch(word: string): Group
    return {
        Key = "@search:" .. word,
        Name = "Contains: " .. word,
        Word = word,
        Enabled = false,
        Members = {},
        MemberEnabled = weakSet(),
        Search = true,
        Removed = false,
        Paths = {},
        PathOrder = {},
        PathResolveCursor = 1,
        PathQueue = {},
        PathHead = 1,
        PathSeen = weakSet(),
        PathScanRecursive = true,
        WatchContainers = {},
        WatchSet = weakSet(),
        Connections = {},
        NextPoll = 0,
        PendingQueue = {},
        PendingHead = 1,
        PendingSet = weakSet(),
        InitialQueue = {},
        InitialHead = 1,
        InitialSeen = weakSet(),
        InitialScanning = false,
        PathVotes = {},
        PathVoteContainers = {},
        AncestorPathVotes = {},
        AncestorPathContainers = {},
        BestPathVotes = 0,
        BestPathDepth = 0,
        BestPathContainer = nil,
        PathSource = false,
        PathSaveDue = nil,
    }
end

function Groups.newPathGroup(path: string): Group
    local group = Groups.newSearch("")
    group.Key = "@path:" .. tostring(Paths.hash(path))
    group.Name = "Path: " .. Paths.leaf(path)
    group.Word = ""
    group.PathSource = true
    group.InitialScanning = false
    group.PathOrder[1] = path
    return group
end

function Groups.addSearchMember(registry: Registry, group: Group, model: any): boolean
    if not group or not model or Groups.isPlayerOwned(registry, model) then
        return false
    end
    if not Groups.isPathEntity(registry, model, registry.PlayerCharacters) then
        return false
    end
    local memberships = registry.SearchMembership[model]
    if not memberships then
        memberships = weakSet()
        registry.SearchMembership[model] = memberships
    end
    if memberships[group] then
        if group.Enabled and not registry.Models.Extended[model] then
            registry.Models:sync(model)
        end
        return false
    end
    memberships[group] = true
    group.Members[#group.Members + 1] = model
    group.MemberEnabled[model] = true
    if group.Enabled then
        registry.Models:sync(model)
    end
    return true
end

function Groups.removeSearchMember(registry: Registry, group: Group, model: any)
    if not group or not model then
        return
    end
    Groups.removeMember(group, model)
    local memberships = registry.SearchMembership[model]
    if memberships then
        memberships[group] = nil
        if next(memberships) == nil then
            registry.SearchMembership[model] = nil
        end
    end
end

function Groups.removeFromSearches(registry: Registry, model: any)
    local memberships = registry.SearchMembership[model]
    if not memberships then
        return
    end
    local groups = {}
    for group in memberships do
        groups[#groups + 1] = group
    end
    for _, group in groups do
        Groups.removeSearchMember(registry, group, model)
    end
end

function Groups.resolveDeadPath(registry: Registry, now: number): any
    local container = registry.DeadPathContainer
    if container and Util.read(container, "Parent") ~= nil then
        return container
    end
    if now < registry.DeadPathResolveAt then
        return nil
    end
    registry.DeadPathResolveAt = now + DEAD_PATH_RESOLVE_INTERVAL
    container = if registry.DeadPath then Paths.resolve(registry.DeadPath) else nil
    registry.DeadPathContainer = container
    return container
end

function Groups.inDeadPath(registry: Registry, model: any): boolean
    if not registry.DeadPath or registry.DeadPath == "" or not model then
        return false
    end
    local container = Groups.resolveDeadPath(registry, os.clock())
    if not container then
        return false
    end
    local current = model
    for _ = 1, DEAD_PATH_DEPTH do
        if not current then
            break
        end
        if current == container then
            return true
        end
        if current == workspace then
            break
        end
        current = Util.read(current, "Parent")
    end
    return false
end

return Groups
end
modules["entities/manager"] = function(...)

local import: (string) -> any = ...
local Groups: typeof(require("./groups")) = import("entities/groups")
local Models: typeof(require("./models")) = import("entities/models")
local Paths: typeof(require("./paths")) = import("entities/paths")
local Preview: typeof(require("./preview")) = import("entities/preview")
local Search: typeof(require("./search")) = import("entities/search")
local Util: typeof(require("../core/util")) = import("core/util")

local Manager = {}
Manager.__index = Manager

type Group = { [string]: any }

export type Config = {
    State: { [string]: any },
    LocalPlayer: any,
    GetPlayers: () -> { any },
    GetCamera: () -> any,
    WallCheck: any,
}

local SCAN_BATCH = 120
local SCAN_SLICE = 0.0015
local CANDIDATE_LIMIT = 12
local CANDIDATE_SLICE = 0.0012

function Manager.new(config: Config)
    local registry: { [string]: any } = {
        State = config.State,
        LocalPlayer = config.LocalPlayer,
        GetPlayers = config.GetPlayers,
        Groups = {},
        GroupOrder = {},
        SearchOrder = {},
        ModelToGroup = Groups.weakSet(),
        SearchMembership = Groups.weakSet(),
        SearchByWord = {},
        PathGroupByPath = {},
        LastSearch = nil,
        EnabledCount = 0,
        Found = 0,
        PlayerCharacters = Groups.weakSet(),
        PlayerNames = {},
        PlayerCharactersNext = 0,
        DeadPath = nil,
        DeadPathContainer = nil,
        DeadPathResolveAt = 0,
        AsyncGeneration = 0,
        ScanGeneration = 0,
        Scanning = false,
        Scanned = 0,
        ScanQueue = {},
        ScanHead = 1,
        SearchServiceRunning = false,
        SearchServiceCursor = 1,
        CandidateGroupCursor = 1,
    }
    registry.Models = Models.new({
        State = config.State,
        WallCheck = config.WallCheck,
        GetCamera = config.GetCamera,
        IsPlayerOwned = function(object)
            return Groups.isPlayerOwned(registry :: any, object)
        end,
        InDeadPath = function(model)
            return Groups.inDeadPath(registry :: any, model)
        end,
        IsEnabled = function(model)
            return Groups.modelEnabled(registry :: any, model)
        end,
        SizeFor = function(model)
            return Groups.sizeFor(registry :: any, model)
        end,
        OnDead = function(model)
            local group = Groups.groupFor(registry :: any, model)
            if group then
                Groups.removeMember(group, model)
                if registry.ModelToGroup[model] == group then
                    registry.ModelToGroup[model] = nil
                end
            end
            Groups.removeFromSearches(registry :: any, model)
        end,
    })
    local preview = Preview.new(function(object)
        return Groups.isPlayerOwned(registry :: any, object)
    end)
    return setmetatable({ Registry = registry, Preview = preview }, Manager)
end

type Self = typeof(Manager.new(nil :: any))

local function registryOf(self: Self): any
    return self.Registry
end

function Manager.groupList(self: Self): { Group }
    return registryOf(self).GroupOrder
end

function Manager.searchList(self: Self): { Group }
    return registryOf(self).SearchOrder
end

function Manager.lastSearch(self: Self): Group?
    return registryOf(self).LastSearch
end

function Manager.isScanning(self: Self): (boolean, number)
    local registry = registryOf(self)
    return registry.Scanning, registry.Scanned
end

function Manager.deadPath(self: Self): string?
    return registryOf(self).DeadPath
end

function Manager.hasEnabledGroups(self: Self): boolean
    return Groups.hasEnabledGroups(registryOf(self))
end

function Manager.visualEntries(self: Self): { [any]: any }
    return registryOf(self).Models:visualEntries()
end

function Manager.isPlayerOwned(self: Self, object: any): boolean
    return Groups.isPlayerOwned(registryOf(self), object)
end

function Manager.memberEnabled(_self: Self, group: Group?, model: any): boolean
    return Groups.memberEnabled(group, model)
end

function Manager.liveCount(_self: Self, group: Group?): number
    return Groups.liveCount(group)
end

function Manager.liveMembers(_self: Self, group: Group?): { any }
    local list = {}
    if group then
        for _, model in group.Members do
            if model and model.Parent then
                list[#list + 1] = model
            end
        end
    end
    return list
end

function Manager.pathSummary(_self: Self, group: Group?): string
    if not group or #group.PathOrder == 0 then
        return "no path saved"
    end
    local text = Paths.display(group.PathOrder[1])
    if #group.PathOrder > 1 then
        text ..= "  (+" .. tostring(#group.PathOrder - 1) .. ")"
    end
    return text
end

function Manager.setGroupEnabled(self: Self, group: Group, enabled: boolean)
    Groups.setEnabled(registryOf(self), group, enabled)
    Search.syncGroup(registryOf(self), group)
end

function Manager.toggleMember(self: Self, group: Group, model: any)
    group.MemberEnabled[model] = not Groups.memberEnabled(group, model)
    registryOf(self).Models:sync(model)
end

function Manager.setGroupSize(_self: Self, group: Group, size: number?)
    group.Size = size
    group.SizeDirty = true
end

local function flushSizes(self: Self)
    local registry = registryOf(self)
    for _, list in { registry.GroupOrder, registry.SearchOrder } do
        for _, group in list do
            if group.SizeDirty then
                group.SizeDirty = nil
                if group.Search then
                    Groups.schedulePathSave(group)
                end
                Search.syncGroup(registry, group)
            end
        end
    end
end

function Manager.previewSearch(self: Self, word: string)
    self.Preview:set(word)
end

function Manager.previewResult(self: Self): (number, boolean, boolean)
    return self.Preview.Count, self.Preview.Done, self.Preview.Capped
end

function Manager.stopPreview(self: Self)
    self.Preview:stop()
end

function Manager.syncAll(self: Self)
    local registry = registryOf(self)
    for _, group in registry.GroupOrder do
        Search.syncGroup(registry, group)
    end
    for _, group in registry.SearchOrder do
        Search.syncGroup(registry, group)
    end
end

function Manager.addSearch(self: Self, word: string)
    Search.add(registryOf(self), word)
end

function Manager.deleteSearch(self: Self, group: Group)
    Search.delete(registryOf(self), group)
end

function Manager.addPath(self: Self, container: any): Group?
    return Search.addPath(registryOf(self), container)
end

local function clearScannedGroups(self: Self)
    local registry = registryOf(self)
    local affected = {}
    for _, group in registry.GroupOrder do
        if group.Enabled then
            Groups.setEnabled(registry, group, false)
        end
        for _, model in group.Members do
            if model then
                affected[#affected + 1] = model
                if registry.ModelToGroup[model] == group then
                    registry.ModelToGroup[model] = nil
                end
            end
        end
    end
    registry.Groups = {}
    registry.GroupOrder = {}
    for _, model in affected do
        registry.Models:sync(model)
    end
end

function Manager.startScan(self: Self)
    local registry = registryOf(self)
    registry.ScanGeneration += 1
    local generation = registry.ScanGeneration
    registry.Scanning = true
    registry.Scanned = 0
    registry.Found = 0
    clearScannedGroups(self)
    registry.ScanQueue = {}
    registry.ScanHead = 1
    for _, root in workspace:GetChildren() do
        registry.ScanQueue[#registry.ScanQueue + 1] = root
    end

    local playerCharacters = {}
    for _, player in registry.GetPlayers() do
        local character = Util.read(player, "Character")
        if character then
            playerCharacters[character] = true
        end
    end

    task.spawn(function()
        while registry.Scanning and registry.ScanGeneration == generation and registry.ScanHead <= #registry.ScanQueue do
            local started = os.clock()
            local processed = 0
            while registry.ScanHead <= #registry.ScanQueue and processed < SCAN_BATCH do
                local object = registry.ScanQueue[registry.ScanHead]
                registry.ScanHead += 1
                processed += 1
                registry.Scanned += 1
                local isEntity = false
                pcall(function()
                    isEntity = Groups.isPathEntity(registry :: any, object, playerCharacters)
                end)
                if isEntity then
                    pcall(Groups.registerScanned, registry :: any, object)
                end
                local className = tostring(Util.read(object, "ClassName") or "")
                if className == "Model" or className == "Folder" then
                    local ok, list = pcall(function()
                        return object:GetChildren()
                    end)
                    if ok then
                        for _, child in list do
                            registry.ScanQueue[#registry.ScanQueue + 1] = child
                        end
                    end
                end
                if os.clock() - started >= SCAN_SLICE then
                    break
                end
            end
            task.wait()
        end
        if registry.ScanGeneration == generation then
            table.sort(registry.GroupOrder, function(a, b)
                return string.lower(a.Name) < string.lower(b.Name)
            end)
            registry.Scanning = false
            registry.ScanQueue = {}
            registry.ScanHead = 1
        end
    end)
end

local function refreshCandidates(self: Self)
    local registry = registryOf(self)
    local autoCount = #registry.GroupOrder
    local totalGroups = autoCount + #registry.SearchOrder
    if totalGroups == 0 then
        return
    end
    local started = os.clock()
    local processed = 0
    local visited = 0
    local seen: { [any]: boolean } = {}
    while processed < CANDIDATE_LIMIT and visited < totalGroups and os.clock() - started < CANDIDATE_SLICE do
        if registry.CandidateGroupCursor > totalGroups then
            registry.CandidateGroupCursor = 1
        end
        local cursor = registry.CandidateGroupCursor
        registry.CandidateGroupCursor = cursor + 1
        visited += 1
        local group = if cursor <= autoCount then registry.GroupOrder[cursor] else registry.SearchOrder[cursor - autoCount]
        if group and group.Enabled == true and not group.Removed and #group.Members > 0 then
            local memberCursor = tonumber(group.CandidateMemberCursor) or 1
            if memberCursor > #group.Members then
                memberCursor = 1
            end
            local attempts = 0
            local perGroup = math.min(CANDIDATE_LIMIT - processed, #group.Members)
            while attempts < perGroup and processed < CANDIDATE_LIMIT and os.clock() - started < CANDIDATE_SLICE do
                if memberCursor > #group.Members then
                    memberCursor = 1
                end
                local model = group.Members[memberCursor]
                memberCursor += 1
                attempts += 1
                if model and not seen[model] and Groups.memberEnabled(group, model) then
                    local models = registry.Models
                    if not models.Extended[model] or not models:isRegistered(model) then
                        if Util.read(model, "Parent") and not Groups.isPlayerOwned(registry :: any, model) then
                            seen[model] = true
                            pcall(models.sync, models, model)
                            processed += 1
                        end
                    end
                end
            end
            group.CandidateMemberCursor = memberCursor
        end
    end
end

function Manager.update(self: Self)
    local registry = registryOf(self)
    if registry.State.NPCHitboxEnabled == false then
        registry.Models:clear()
        return
    end
    if not Groups.hasEnabledGroups(registry) then
        return
    end
    flushSizes(self)
    refreshCandidates(self)
    registry.Models:refresh()
end

function Manager.setDeadPath(self: Self, container: any): boolean
    local registry = registryOf(self)
    if not container or container == workspace then
        return false
    end
    local path = Paths.toText(container)
    if not path or path == "" then
        return false
    end
    registry.DeadPath = path
    registry.DeadPathContainer = container
    registry.DeadPathResolveAt = 0
    Paths.saveDead(path)
    local models = {}
    for model in registry.Models.Extended do
        models[#models + 1] = model
    end
    local asyncGeneration = registry.AsyncGeneration
    task.spawn(function()
        for index, model in models do
            if registry.AsyncGeneration ~= asyncGeneration then
                return
            end
            pcall(registry.Models.sync, registry.Models, model)
            if index % 8 == 0 then
                task.wait()
            end
        end
    end)
    return true
end

function Manager.clearDeadPath(self: Self)
    local registry = registryOf(self)
    registry.DeadPath = nil
    registry.DeadPathContainer = nil
    registry.DeadPathResolveAt = 0
    Paths.deleteDead()
end

function Manager.resolveDeadPath(self: Self): any
    return Groups.resolveDeadPath(registryOf(self), os.clock())
end

function Manager.browse(self: Self, container: any): { any }
    local registry = registryOf(self)
    local entries = {}
    local ok, list = pcall(function()
        return (container or workspace):GetChildren()
    end)
    if not ok then
        return entries
    end
    for _, child in list do
        if child and not Groups.isPlayerOwned(registry, child) then
            local className = tostring(Util.read(child, "ClassName") or "")
            if className == "Folder" or className == "Model" then
                entries[#entries + 1] = child
            end
        end
    end
    table.sort(entries, function(a, b)
        return string.lower(tostring(Util.read(a, "Name") or "")) < string.lower(tostring(Util.read(b, "Name") or ""))
    end)
    return entries
end

function Manager.browseUp(_self: Self, container: any): any
    if not container or container == workspace then
        return workspace
    end
    local parent = Util.read(container, "Parent")
    if parent and parent ~= game then
        return parent
    end
    return workspace
end

function Manager.canBrowse(self: Self, container: any): boolean
    return container ~= nil and not Groups.isPlayerOwned(registryOf(self), container)
end

function Manager.loadSaved(self: Self)
    Search.loadSaved(registryOf(self))
end

function Manager.stopAsyncWork(self: Self)
    local registry = registryOf(self)
    registry.AsyncGeneration += 1
    registry.ScanGeneration += 1
    registry.Scanning = false
    registry.ScanQueue = {}
    registry.ScanHead = 1
    for _, group in registry.GroupOrder do
        group.SyncGeneration = (group.SyncGeneration or 0) + 1
    end
    for _, group in registry.SearchOrder do
        group.SyncGeneration = (group.SyncGeneration or 0) + 1
    end
end

function Manager.shutdown(self: Self)
    local registry = registryOf(self)
    Manager.stopAsyncWork(self)
    self.Preview:stop()
    Search.clearAll(registry)
    registry.Models:clear()
end

return Manager
end
modules["entities/models"] = function(...)

local import: (string) -> any = ...
local Parts: typeof(require("../core/parts")) = import("core/parts")
local Util: typeof(require("../core/util")) = import("core/util")
local VisualClone: typeof(require("../hitbox/visual-clone")) = import("hitbox/visual-clone")

type State = { [string]: any }

type Checks = {
    NextBasic: number,
    NextWall: number,
    Dead: boolean,
    Forcefield: boolean,
    Invisible: boolean,
    WallVisible: boolean,
}

type Extended = {
    Part: any,
    Humanoid: any,
    Size: Vector3,
    Transparency: any,
    CanCollide: any,
    HasLocalTransparency: boolean,
    LocalTransparency: any,
    VisualClone: any,
    Target: Vector3?,
    AppliedTarget: Vector3,
    NextVerify: number,
    CollisionApplied: boolean,
    FallbackHidden: boolean?,
}

type Registration = {
    Health: number?,
    Weapon: string?,
    NextMetaRefresh: number,
    Registered: boolean,
}

export type Config = {
    State: State,
    WallCheck: any,
    GetCamera: () -> any,

    IsPlayerOwned: (object: any) -> boolean,

    InDeadPath: (model: any) -> boolean,

    IsEnabled: (model: any) -> boolean,

    SizeFor: (model: any) -> number?,

    OnDead: (model: any) -> (),
}

local Models = {}
Models.__index = Models

local ROOT_NAME = "HumanoidRootPart"
local CLONE_NAME = "SevereNPCVisualClone"
local BASIC_CHECK_INTERVAL = 0.4
local WALL_CHECK_INTERVAL = 0.12
local VERIFY_INTERVAL = 0.75
local META_INTERVAL = 0.8
local REFRESH_BATCH = 8
local SNAPSHOT_INTERVAL = 0.75

local ENTITY_PART_NAMES = { "HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso" }

function Models.new(config: Config)
    local self = {
        State = config.State,
        WallCheck = config.WallCheck,
        GetCamera = config.GetCamera,
        IsPlayerOwned = config.IsPlayerOwned,
        InDeadPath = config.InDeadPath,
        IsEnabled = config.IsEnabled,
        SizeFor = config.SizeFor,
        OnDead = config.OnDead,
        Extended = Util.newWeakKeyed() :: { [any]: Extended },
        Checks = Util.newWeakKeyed() :: { [any]: Checks },
        Keys = Util.newWeakKeyed() :: { [any]: string },
        NextId = 0,

        Entities = {} :: { [string]: any },
        Registrations = {} :: { [string]: Registration },
        RefreshKeys = {} :: { string },
        RefreshCursor = 1,
        NextSnapshot = 0,
    }
    return setmetatable(self, Models)
end

type Self = typeof(Models.new(nil :: any))

local function validHumanoid(candidate: any): boolean
    if not candidate then
        return false
    end
    return type(Util.read(candidate, "Health")) == "number"
end

function Models.humanoid(model: any): any
    if not model then
        return nil
    end
    local named = Util.child(model, "Humanoid")
    if validHumanoid(named) then
        return named
    end
    local ok, byClass = pcall(function()
        return model:FindFirstChildOfClass("Humanoid")
    end)
    if ok and validHumanoid(byClass) then
        return byClass
    end
    return nil
end

local function readablePart(candidate: any): boolean
    if not candidate then
        return false
    end
    local ok, parent, size = pcall(function()
        return candidate.Parent, candidate.Size
    end)
    return ok and parent ~= nil and size ~= nil and type(size.X) == "number" and type(size.Y) == "number" and type(size.Z) == "number"
end

Models.readablePart = readablePart

export type EntityParts = {
    HumanoidRootPart: any,
    TargetPart: any,
    Head: any,
    Torso: any,
    Fallback: boolean,
}

function Models.entityParts(model: any): EntityParts?
    if not model then
        return nil
    end
    local target = nil
    for _, name in ENTITY_PART_NAMES do
        local part = Util.child(model, name)
        if readablePart(part) then
            target = part
            break
        end
    end
    if not target then
        return nil
    end
    local head = Util.child(model, "Head")
    local torso = Util.child(model, "UpperTorso") or Util.child(model, "Torso") or Util.child(model, "LowerTorso")
    return {
        HumanoidRootPart = target,
        TargetPart = target,
        Head = if readablePart(head) then head else nil,
        Torso = if readablePart(torso) then torso else nil,
        Fallback = target.Name ~= ROOT_NAME,
    }
end

local function weaponName(model: any): string
    for _, child in model:GetChildren() do
        if Parts.className(child) == "Tool" then
            return child.Name
        end
    end
    return "None"
end

local function modelData(model: any, parts: EntityParts?): { [string]: any }?
    local humanoid = Models.humanoid(model)
    local target = parts and (parts.TargetPart or parts.HumanoidRootPart)
    if not humanoid or not target then
        return nil
    end
    local health = Util.read(humanoid, "Health")
    if type(health) ~= "number" then
        return nil
    end
    return {
        Username = model.Name,
        Character = model,
        PrimaryPart = target,
        Head = parts and parts.Head or nil,
        Torso = parts and parts.Torso or nil,
        Aimbot_Part = target,
        Aimbot_TP_Part = target,
        Triggerbot_Part = target,
        Health = health,
    }
end

function Models.key(self: Self, model: any): string
    local existing = self.Keys[model]
    if existing then
        return existing
    end
    self.NextId += 1
    local key = "NPC:" .. tostring(self.NextId) .. ":" .. tostring(model and model.Name or "NPC")
    self.Keys[model] = key
    return key
end

function Models.keyOf(self: Self, model: any): string?
    return self.Keys[model]
end

function Models.isRegistered(self: Self, model: any): boolean
    local key = self.Keys[model]
    return key ~= nil and self.Entities[key] ~= nil
end

local function destroyClone(self: Self, extended: Extended)
    local clone = extended.VisualClone
    if clone then
        if self.WallCheck then
            self.WallCheck:unignorePart(clone)
        end
        VisualClone.destroy(clone)
    end
    extended.VisualClone = nil
end

function Models.restore(self: Self, model: any)
    local extended = self.Extended[model]
    if not extended then
        return
    end
    local part = extended.Part
    if part and part.Parent then
        Util.write(part, "Size", extended.Size)
        Util.write(part, "CanCollide", extended.CanCollide)
        Util.write(part, "Transparency", extended.Transparency)
        if extended.HasLocalTransparency then
            Util.write(part, "LocalTransparencyModifier", extended.LocalTransparency)
        end
    end
    destroyClone(self, extended)
    self.Extended[model] = nil
end

local function ensureClone(self: Self, part: any, extended: Extended)
    if not part or part.Name == ROOT_NAME then
        return
    end
    local clone = extended.VisualClone
    if clone and Util.read(clone, "Parent") then
        return
    end
    clone = VisualClone.create(part, CLONE_NAME, extended.Size, extended.Transparency)
    if not clone then
        return
    end
    extended.VisualClone = clone
    if self.WallCheck then
        self.WallCheck:ignorePart(clone)
    end
    if extended.HasLocalTransparency then
        Util.write(part, "LocalTransparencyModifier", 1)
    end
end

local function isInvisible(self: Self, model: any): boolean
    local readable, visible = false, false
    for _, child in model:GetChildren() do
        if Parts.isBasePartClass(Parts.className(child)) and child.Name ~= ROOT_NAME then
            readable = true
            local extended = self.Extended[model]
            local transparency = nil
            if extended and extended.Part == child then
                transparency = extended.Transparency
            end
            if transparency == nil then
                transparency = Util.read(child, "Transparency")
            end
            if type(transparency) == "number" and transparency < 0.95 then
                visible = true
                break
            end
        end
    end
    return readable and not visible
end

local function isDead(self: Self, model: any, humanoid: any): boolean
    if not model or not model.Parent then
        return true
    end
    if self.InDeadPath(model) then
        return true
    end
    if humanoid then
        if not Util.read(humanoid, "Parent") then
            return true
        end
        local health = Util.read(humanoid, "Health")
        if type(health) == "number" and health <= 0 then
            return true
        end
    end
    local effects = model:FindFirstChild("BodyEffects")
    if not effects then
        return false
    end
    local knockedOut = effects:FindFirstChild("K.O") or effects:FindFirstChild("KO")
    if knockedOut and Util.read(knockedOut, "Value") == true then
        return true
    end
    local dead = effects:FindFirstChild("Dead")
    return dead ~= nil and Util.read(dead, "Value") == true
end

Models.dead = isDead

local function hasForcefield(model: any): boolean
    local ok, found = pcall(function()
        return model:FindFirstChild("ForceField") or model:FindFirstChildOfClass("ForceField")
    end)
    return ok and found ~= nil
end

local function wallVisible(self: Self, part: any): boolean
    local camera = self.GetCamera()
    if not self.WallCheck or not camera or not part then
        return true
    end
    local ok, origin, target = pcall(function()
        return camera.CFrame.Position, part.Position
    end)
    if not ok or not origin or not target then
        return true
    end
    local seen, visible = pcall(function()
        return self.WallCheck:canSee(origin, target)
    end)
    return not seen or visible ~= false
end

local function checksOf(self: Self, model: any): Checks
    local checks = self.Checks[model]
    if not checks then
        checks = { NextBasic = 0, NextWall = 0, Dead = false, Forcefield = false, Invisible = false, WallVisible = true }
        self.Checks[model] = checks
    end
    return checks
end

local function checkReason(self: Self, model: any, humanoid: any, part: any): string?
    local state = self.State
    local now = os.clock()
    local checks = checksOf(self, model)
    if state.DeadCheck ~= false and isDead(self, model, humanoid) then
        checks.Dead = true
        return "dead"
    end
    checks.Dead = false
    if state.ForcefieldCheck == false then
        checks.Forcefield = false
    end
    if state.InvisibleCheck == false then
        checks.Invisible = false
    end
    if now >= checks.NextBasic then
        checks.NextBasic = now + BASIC_CHECK_INTERVAL
        if state.ForcefieldCheck ~= false then
            checks.Forcefield = hasForcefield(model)
        end
        if state.InvisibleCheck ~= false then
            checks.Invisible = isInvisible(self, model)
        end
    end
    if checks.Forcefield then
        return "forcefield"
    end
    if checks.Invisible then
        return "invisible"
    end
    if state.WallCheck ~= false then
        if now >= checks.NextWall then
            checks.NextWall = now + WALL_CHECK_INTERVAL
            checks.WallVisible = wallVisible(self, part)
        end
        if checks.WallVisible == false then
            return "wall"
        end
    else
        checks.WallVisible = true
        checks.NextWall = 0
    end
    return nil
end

local function targetSize(state: State, groupSize: number?): Vector3
    local value = math.max(1, groupSize or tonumber(state.NPCSizeAll) or tonumber(state.SizeAll) or 1)
    return Vector3.new(value, value, value)
end

local function setSize(part: any, size: Vector3)
    part.Size = size
end

local function squaredGap(first: Vector3, second: Vector3): number
    local x, y, z = first.X - second.X, first.Y - second.Y, first.Z - second.Z
    return x * x + y * y + z * z
end

local function pickPart(self: Self, model: any, current: Extended?): any
    local part = current and current.Part or nil
    if part and part.Parent and part.Name ~= ROOT_NAME then
        local preferred = model:FindFirstChild(ROOT_NAME)
        if readablePart(preferred) then
            part = preferred
        end
    end
    if not part or not part.Parent then
        local parts = Models.entityParts(model)
        part = parts and (parts.TargetPart or parts.HumanoidRootPart) or nil
    end
    return part
end

function Models.apply(self: Self, model: any): boolean
    if self.IsPlayerOwned(model) or not self.IsEnabled(model) then
        Models.restore(self, model)
        return false
    end
    local extended = self.Extended[model]
    local part = pickPart(self, model, extended)
    if not part or not part.Parent or self.IsPlayerOwned(part) then
        Models.restore(self, model)
        return false
    end
    local humanoid = extended and extended.Humanoid or nil
    if not (humanoid and Util.read(humanoid, "Parent") ~= nil and type(Util.read(humanoid, "Health")) == "number") then
        humanoid = Models.humanoid(model)
    end
    if checkReason(self, model, humanoid, part) then
        Models.restore(self, model)
        return false
    end
    local entry: Extended
    if extended and extended.Part == part then
        extended.Humanoid = humanoid
        entry = extended
    else
        if extended then
            Models.restore(self, model)
        end
        local size = Util.read(part, "Size")
        if not size then
            return false
        end
        local localTransparency = Util.read(part, "LocalTransparencyModifier")
        entry = {
            Part = part,
            Humanoid = humanoid,
            Size = size,
            Transparency = Util.read(part, "Transparency"),
            CanCollide = Util.read(part, "CanCollide"),
            HasLocalTransparency = localTransparency ~= nil,
            LocalTransparency = localTransparency,
            VisualClone = nil,
            Target = nil,
            AppliedTarget = size,
            NextVerify = 0,
            CollisionApplied = false,
            FallbackHidden = nil,
        }
        self.Extended[model] = entry
    end

    local now = os.clock()
    local target = targetSize(self.State, self.SizeFor(model))
    entry.Target = target
    if part.Name ~= ROOT_NAME then
        ensureClone(self, part, entry)
    end
    local verify = now >= entry.NextVerify
    if verify then
        entry.NextVerify = now + VERIFY_INTERVAL
    end
    if squaredGap(entry.AppliedTarget, target) > 0.0009 then
        if pcall(setSize, part, target) then
            entry.AppliedTarget = target
        end
    elseif verify then
        local current = Util.read(part, "Size")
        if current and squaredGap(current, target) > 0.0025 and pcall(setSize, part, target) then
            entry.AppliedTarget = target
        end
    end
    if not entry.CollisionApplied then
        Util.write(part, "CanCollide", false)
        entry.CollisionApplied = true
    end
    if part.Name ~= ROOT_NAME then
        if entry.HasLocalTransparency then
            Util.write(part, "LocalTransparencyModifier", 1)
        elseif not entry.FallbackHidden then
            Util.write(part, "Transparency", 1)
            entry.FallbackHidden = true
        end
    end
    if entry.VisualClone then
        VisualClone.follow(part, entry.VisualClone)
    end
    return true
end

function Models.visualEntries(self: Self): { [any]: Extended }
    return self.Extended
end

local function unregister(self: Self, key: string)
    local registration = self.Registrations[key]
    if registration and registration.Registered then
        pcall(remove_model_data, key)
    end
    self.Entities[key] = nil
    self.Registrations[key] = nil
end

function Models.sync(self: Self, model: any): boolean
    if not model or self.IsPlayerOwned(model) then
        if model then
            Models.restore(self, model)
        end
        return false
    end
    local key = Models.key(self, model)
    local active = false
    if self.IsEnabled(model) then
        active = Models.apply(self, model)
    end
    if active then
        if not self.Entities[key] then
            local parts = Models.entityParts(model)
            if parts and parts.HumanoidRootPart then
                local data = modelData(model, parts)
                local registered = false
                if data then
                    local ok, result = pcall(add_model_data, data, key)
                    registered = ok and result == true
                end
                self.Entities[key] = model
                self.Registrations[key] = {
                    Health = data and data.Health or nil,
                    Weapon = nil,
                    NextMetaRefresh = 0,
                    Registered = registered,
                }
                self.NextSnapshot = 0
            end
        end
    else
        Models.restore(self, model)
        if self.Entities[key] then
            unregister(self, key)
        end
    end
    return active
end

function Models.clear(self: Self)
    local models = {}
    for model in self.Extended do
        models[#models + 1] = model
    end
    for _, model in models do
        Models.restore(self, model)
    end
    for key in self.Entities do
        local registration = self.Registrations[key]
        if registration and registration.Registered then
            pcall(remove_model_data, key)
        end
    end
    self.Entities = {}
    self.Registrations = {}
    self.RefreshKeys = {}
    self.RefreshCursor = 1
end

function Models.refresh(self: Self)
    local now = os.clock()
    if self.RefreshCursor > #self.RefreshKeys and now >= self.NextSnapshot then
        self.RefreshKeys = {}
        for key in self.Entities do
            self.RefreshKeys[#self.RefreshKeys + 1] = key
        end
        self.RefreshCursor = 1
        self.NextSnapshot = now + SNAPSHOT_INTERVAL
    end

    local refreshed = 0
    while self.RefreshCursor <= #self.RefreshKeys and refreshed < REFRESH_BATCH do
        local key = self.RefreshKeys[self.RefreshCursor]
        self.RefreshCursor += 1
        refreshed += 1
        local model = self.Entities[key]
        pcall(function()
            local humanoid = model and Models.humanoid(model) or nil
            local dead = self.State.DeadCheck ~= false and isDead(self, model, humanoid)
            if dead then
                self.OnDead(model)
            end
            if not dead and self.IsEnabled(model) and Models.apply(self, model) then
                local registration = self.Registrations[key]
                if not registration then
                    registration = { Health = nil, Weapon = nil, NextMetaRefresh = 0, Registered = false }
                    self.Registrations[key] = registration
                end
                if not registration.Registered and humanoid then
                    local parts = Models.entityParts(model)
                    local data = parts and modelData(model, parts)
                    if data then
                        local ok, result = pcall(add_model_data, data, key)
                        registration.Registered = ok and result == true
                        if registration.Registered then
                            registration.Health = data.Health
                        end
                    end
                end
                if registration.Registered and now >= registration.NextMetaRefresh then
                    registration.NextMetaRefresh = now + META_INTERVAL
                    local weapon = weaponName(model)
                    if registration.Weapon ~= weapon then
                        registration.Weapon = weapon
                        pcall(edit_model_data, { Toolname = weapon }, key)
                    end
                end
                local health = humanoid and Util.read(humanoid, "Health")
                if type(health) == "number" and registration.Health ~= health then
                    registration.Health = health
                    if registration.Registered then
                        pcall(edit_model_data, { Health = health }, key)
                    end
                end
            else
                if model then
                    Models.restore(self, model)
                end
                unregister(self, key)
            end
        end)
    end
end

return Models
end
modules["entities/paths"] = function(...)

local import: (string) -> any = ...
local Storage: typeof(require("../core/storage")) = import("core/storage")
local Util: typeof(require("../core/util")) = import("core/util")

local Paths = {}

local SEPARATOR = "\31"
local FOLDER = Storage.ROOT .. "/paths"
local SAVE_VERSION = 2
local MAX_DEPTH = 32

Paths.SEPARATOR = SEPARATOR

type Group = { [string]: any }

export type Record = {
    Kind: string,
    Word: string,
    Paths: { string },
    Enabled: boolean,

    Size: number?,
}

function Paths.toText(container: any): string?
    if not container or container == workspace then
        return ""
    end
    local names = {}
    local current = container
    local guard = 0
    while current and current ~= workspace and guard < MAX_DEPTH do
        guard += 1
        local name = Util.read(current, "Name")
        if type(name) ~= "string" or name == "" then
            return nil
        end
        table.insert(names, 1, name)
        current = Util.read(current, "Parent")
    end
    if current ~= workspace then
        return nil
    end
    return table.concat(names, SEPARATOR)
end

function Paths.resolve(path: string?): any
    if path == nil or path == "" then
        return workspace
    end
    local current = workspace
    for name in string.gmatch(path, "[^" .. SEPARATOR .. "]+") do
        current = Util.child(current, name)
        if not current then
            return nil
        end
    end
    return current
end

function Paths.display(path: string?): string
    if path == nil or path == "" then
        return "workspace"
    end
    return "workspace." .. string.gsub(path, SEPARATOR, ".")
end

function Paths.leaf(path: string?): string
    if not path or path == "" then
        return "workspace"
    end
    return string.match(path, "([^" .. SEPARATOR .. "]+)$") or path
end

function Paths.depth(path: string?): number
    if not path or path == "" then
        return 0
    end
    local _, separators = string.gsub(path, SEPARATOR, "")
    return separators + 1
end

function Paths.hash(text: string?): number
    local value = 17
    local source = tostring(text or "")
    for index = 1, #source do
        value = (value * 131 + string.byte(source, index)) % 2147483647
    end
    return value
end

local function safeName(text: string): string
    local lowered = string.lower(text)
    lowered = string.gsub(lowered, "[^%w%-_]+", "_")
    lowered = string.gsub(lowered, "_+", "_")
    return lowered
end

local function fileFor(group: Group): string
    local safe
    if group.PathSource then
        safe = "path_" .. tostring(Paths.hash(group.PathOrder[1] or group.Name))
    else
        safe = safeName(tostring(group.Word or "npc"))
    end
    safe = string.gsub(safe, "^_+", "")
    safe = string.gsub(safe, "_+$", "")
    if safe == "" then
        safe = "npc"
    end
    if #safe > 48 then
        safe = string.sub(safe, 1, 48)
    end
    return FOLDER .. "/" .. tostring(game.PlaceId) .. "__" .. safe .. ".json"
end

local function deadFile(): string
    return FOLDER .. "/" .. tostring(game.PlaceId) .. "__dead_check.json"
end

local function ensureFolder(): boolean
    Storage.ensureFolder(Storage.ROOT)
    return Storage.ensureFolder(FOLDER)
end

function Paths.saveGroup(group: Group)
    if not group.Search or group.Removed or not ensureFolder() then
        return
    end
    local paths = {}
    for _, path in group.PathOrder do
        paths[#paths + 1] = path
    end
    Storage.writeJson(fileFor(group), {
        Version = SAVE_VERSION,
        PlaceId = game.PlaceId,
        Kind = if group.PathSource then "path" else "search",
        Word = group.Word,
        Name = group.Name,
        Enabled = group.Enabled == true,
        Size = group.Size,
        Paths = paths,
    })
    group.PathSaveDue = nil
end

function Paths.deleteGroupFile(group: Group)
    Storage.delete(fileFor(group))
end

function Paths.saveDead(path: string)
    if path == "" or not ensureFolder() then
        return
    end
    Storage.writeJson(deadFile(), { Version = SAVE_VERSION, PlaceId = game.PlaceId, Kind = "dead", Paths = { path } })
end

function Paths.deleteDead()
    Storage.delete(deadFile())
end

function Paths.readAll(): { Record }
    local records: { Record } = {}
    if not ensureFolder() then
        return records
    end
    local files = Storage.list(FOLDER)
    table.sort(files, function(a, b)
        return tostring(a) < tostring(b)
    end)
    for _, file in files do
        if string.lower(string.sub(tostring(file), -5)) == ".json" then
            local data = Storage.readJson(file)
            if type(data) == "table" and tonumber(data.PlaceId) == tonumber(game.PlaceId) then
                local word = Util.trim(string.lower(tostring(data.Word or "")))
                local paths = if type(data.Paths) == "table" then data.Paths else {}
                records[#records + 1] = {
                    Kind = tostring(data.Kind or "search"),
                    Word = word,
                    Paths = paths,
                    Enabled = data.Enabled ~= false,
                    Size = tonumber(data.Size),
                }
            end
        end
    end
    return records
end

return Paths
end
modules["entities/preview"] = function(...)

local import: (string) -> any = ...
local Models: typeof(require("./models")) = import("entities/models")
local Util: typeof(require("../core/util")) = import("core/util")

local Preview = {}
Preview.__index = Preview

local BATCH = 250
local MAX_VISITED = 60000

function Preview.new(isPlayerOwned: (object: any) -> boolean)
    local self = {
        Word = "",
        Count = 0,
        Done = true,

        Capped = false,
        Generation = 0,
        IsPlayerOwned = isPlayerOwned,
    }
    return setmetatable(self, Preview)
end

type Self = typeof(Preview.new(nil :: any))

local function childrenOf(object: any): { any }
    local ok, list = pcall(function()
        return object:GetChildren()
    end)
    return if ok and type(list) == "table" then list else {}
end

local function walk(self: Self, generation: number, word: string)
    local queue: { any } = childrenOf(workspace)
    local head = 1
    local tail = #queue
    local visited = 0
    while head <= tail do
        if self.Generation ~= generation then
            return
        end
        local object = queue[head]
        queue[head] = nil
        head += 1
        visited += 1
        if object and not self.IsPlayerOwned(object) then
            if Util.read(object, "ClassName") == "Model" then
                local name = string.lower(tostring(Util.read(object, "Name") or ""))
                if string.find(name, word, 1, true) and Models.entityParts(object) then
                    self.Count += 1
                end
            end
            for _, child in childrenOf(object) do
                tail += 1
                queue[tail] = child
            end
        end
        if visited >= MAX_VISITED then
            self.Capped = true
            break
        end
        if visited % BATCH == 0 then
            task.wait()
        end
    end
    if self.Generation == generation then
        self.Done = true
    end
end

function Preview.set(self: Self, word: string)
    local text = string.lower(Util.trim(word))
    if text == self.Word then
        return
    end
    self.Generation += 1
    self.Word = text
    self.Count = 0
    self.Capped = false
    self.Done = text == ""
    if text == "" then
        return
    end
    local generation = self.Generation
    task.spawn(walk, self, generation, text)
end

function Preview.stop(self: Self)
    self.Generation += 1
    self.Word = ""
    self.Count = 0
    self.Done = true
    self.Capped = false
end

return Preview
end
modules["entities/search"] = function(...)

local import: (string) -> any = ...
local Groups: typeof(require("./groups")) = import("entities/groups")
local Models: typeof(require("./models")) = import("entities/models")
local Paths: typeof(require("./paths")) = import("entities/paths")
local Util: typeof(require("../core/util")) = import("core/util")

local Search = {}

type Group = { [string]: any }
type Registry = { [string]: any }

local PENDING_SECONDS = 8
local PENDING_BATCH = 4
local PATH_BATCH = 10
local PATH_SLICE = 0.00032
local INITIAL_BATCH = 42
local INITIAL_SLICE = 0.00045
local POLL_INTERVAL = 0.55
local SERVICE_WAIT = 0.04
local VOTE_LEVELS = 8
local QUEUE_COMPACT_SIZE = 64

local function children(object: any): { any }
    local ok, list = pcall(function()
        return object:GetChildren()
    end)
    if ok and type(list) == "table" then
        return list
    end
    return {}
end

local function classOf(object: any): string
    return tostring(Util.read(object, "ClassName") or "")
end

local function queueObject(group: Group, object: any)
    if group.Removed or not object or group.PathSeen[object] then
        return
    end
    group.PathSeen[object] = true
    group.PathQueue[#group.PathQueue + 1] = object
end

local function queuePending(registry: Registry, group: Group, model: any, now: number)
    if group.Removed or not model or Groups.isPlayerOwned(registry, model) or group.PendingSet[model] then
        return
    end
    group.PendingSet[model] = now + PENDING_SECONDS
    group.PendingQueue[#group.PendingQueue + 1] = model
end

local function watchContainer(registry: Registry, group: Group, container: any)
    if group.Removed or not container or group.WatchSet[container] then
        return
    end
    group.WatchSet[container] = true
    group.WatchContainers[#group.WatchContainers + 1] = container
    local ok, connection = pcall(function()
        return container.ChildAdded:Connect(function(child)
            if group.Removed or not child or Groups.isPlayerOwned(registry, child) then
                return
            end
            if classOf(child) == "Model" then
                queuePending(registry, group, child, os.clock())
            end
            queueObject(group, child)
        end)
    end)
    if ok and connection then
        group.Connections[#group.Connections + 1] = connection
    end
end

local function queueChildren(group: Group, container: any)
    for _, child in children(container) do
        queueObject(group, child)
    end
end

local function learnPath(registry: Registry, group: Group, container: any)
    if group.Removed or not container or Groups.isPlayerOwned(registry, container) then
        return
    end
    local path = Paths.toText(container)
    if path == nil then
        return
    end
    if not group.Paths[path] then
        group.Paths[path] = container
        group.PathOrder[#group.PathOrder + 1] = path
        watchContainer(registry, group, container)
        group.PathScanRecursive = path ~= ""
        queueChildren(group, container)
        Groups.schedulePathSave(group)
    elseif not group.Paths[path].Parent then
        group.Paths[path] = container
        watchContainer(registry, group, container)
        queueChildren(group, container)
    end
end

local function processPending(registry: Registry, group: Group, now: number)
    local processed = 0
    while group.PendingHead <= #group.PendingQueue and processed < PENDING_BATCH do
        local model = group.PendingQueue[group.PendingHead]
        group.PendingHead += 1
        processed += 1
        local deadline = group.PendingSet[model]
        if deadline then
            local parent = Util.read(model, "Parent")
            if group.Removed or not parent or Groups.isPlayerOwned(registry, model) then
                group.PendingSet[model] = nil
            else
                local parts = Models.entityParts(model)
                local humanoid = Models.humanoid(model)
                if parts and (parts.TargetPart or parts.HumanoidRootPart) then
                    group.PendingSet[model] = nil
                    if not Models.dead(registry.Models, model, humanoid) then
                        Groups.addSearchMember(registry, group, model)
                    end
                elseif now < deadline then
                    group.PendingQueue[#group.PendingQueue + 1] = model
                else
                    group.PendingSet[model] = nil
                end
            end
        end
    end
    if group.PendingHead > QUEUE_COMPACT_SIZE and group.PendingHead > (#group.PendingQueue / 2) then
        local compact = {}
        for index = group.PendingHead, #group.PendingQueue do
            compact[#compact + 1] = group.PendingQueue[index]
        end
        group.PendingQueue = compact
        group.PendingHead = 1
    end
end

local function processPath(registry: Registry, group: Group)
    local started = os.clock()
    local processed = 0
    while group.PathHead <= #group.PathQueue and processed < PATH_BATCH do
        local object = group.PathQueue[group.PathHead]
        group.PathHead += 1
        processed += 1
        if object and object.Parent and not Groups.isPlayerOwned(registry, object) then
            local className = classOf(object)
            if className == "Model" and Groups.isPathEntity(registry, object, registry.PlayerCharacters) then
                Groups.addSearchMember(registry, group, object)
            end
            if group.PathScanRecursive ~= false and (className == "Model" or className == "Folder") then
                queueChildren(group, object)
            end
        end
        if os.clock() - started >= PATH_SLICE then
            break
        end
    end
    if group.PathHead > #group.PathQueue then
        group.PathQueue = {}
        group.PathHead = 1
        group.PathSeen = Groups.weakSet()
    end
end

local function voteForPath(registry: Registry, group: Group, container: any)
    if not container or Groups.isPlayerOwned(registry, container) then
        return
    end
    local exact = Paths.toText(container)
    if exact == nil then
        return
    end
    group.PathVotes[exact] = (group.PathVotes[exact] or 0) + 1
    group.PathVoteContainers[exact] = container
    if group.PathVotes[exact] >= 2 then
        learnPath(registry, group, container)
    end

    local current = container
    local levels = 0
    while current and current ~= workspace and levels < VOTE_LEVELS do
        levels += 1
        local path = Paths.toText(current)
        if path ~= nil then
            group.AncestorPathVotes[path] = (group.AncestorPathVotes[path] or 0) + 1
            group.AncestorPathContainers[path] = current
            local votes = group.AncestorPathVotes[path]
            local depth = Paths.depth(path)
            if votes > (group.BestPathVotes or 0) or (votes == (group.BestPathVotes or 0) and depth > (group.BestPathDepth or 0)) then
                group.BestPathVotes = votes
                group.BestPathDepth = depth
                group.BestPathContainer = current
            end
        end
        current = Util.read(current, "Parent")
    end
end

local function processInitial(registry: Registry, group: Group, now: number)
    if not group.InitialScanning then
        return
    end
    local started = os.clock()
    local processed = 0
    while group.InitialHead <= #group.InitialQueue and processed < INITIAL_BATCH do
        local object = group.InitialQueue[group.InitialHead]
        group.InitialHead += 1
        processed += 1
        if object and object.Parent and not Groups.isPlayerOwned(registry, object) then
            local name = string.lower(tostring(Util.read(object, "Name") or ""))
            local className = classOf(object)
            local matched = string.find(name, group.Word, 1, true) ~= nil
            if matched and (className == "Model" or className == "Folder") then
                if className == "Model" then
                    if Models.entityParts(object) then
                        local parent = Util.read(object, "Parent")
                        voteForPath(registry, group, parent or object)
                        Groups.addSearchMember(registry, group, object)
                    else
                        queuePending(registry, group, object, now)
                    end
                else
                    learnPath(registry, group, object)
                end
            end
            for _, child in children(object) do
                if not group.InitialSeen[child] then
                    group.InitialSeen[child] = true
                    group.InitialQueue[#group.InitialQueue + 1] = child
                end
            end
        end
        if os.clock() - started >= INITIAL_SLICE then
            break
        end
    end
    if group.InitialHead > #group.InitialQueue then
        if group.BestPathContainer then
            learnPath(registry, group, group.BestPathContainer)
        end
        group.InitialScanning = false
        group.InitialQueue = {}
        group.InitialHead = 1
        group.InitialSeen = Groups.weakSet()
    end
end

local function pollPaths(registry: Registry, group: Group, now: number)
    if now < group.NextPoll or group.PathHead <= #group.PathQueue then
        return
    end
    group.NextPoll = now + POLL_INTERVAL
    if #group.PathOrder == 0 then
        return
    end
    if group.PathResolveCursor > #group.PathOrder then
        group.PathResolveCursor = 1
    end
    local path = group.PathOrder[group.PathResolveCursor]
    group.PathResolveCursor += 1
    local container = group.Paths[path]
    if not container or not container.Parent then
        container = Paths.resolve(path)
        group.Paths[path] = container
    end
    if not container or Groups.isPlayerOwned(registry, container) then
        return
    end
    watchContainer(registry, group, container)
    group.PathScanRecursive = path ~= ""
    group.PathQueue = {}
    group.PathHead = 1
    group.PathSeen = Groups.weakSet()
    queueChildren(group, container)
end

local function processGroup(registry: Registry, group: Group, now: number)
    if not group or group.Removed then
        return
    end
    if group.InitialScanning then
        processInitial(registry, group, now)
    end
    if group.Enabled then
        processPath(registry, group)
        processPending(registry, group, now)
        pollPaths(registry, group, now)
    end
    if group.PathSaveDue and now >= group.PathSaveDue then
        Paths.saveGroup(group)
    end
end

function Search.startService(registry: Registry)
    if registry.SearchServiceRunning then
        return
    end
    registry.SearchServiceRunning = true
    task.spawn(function()
        while #registry.SearchOrder > 0 do
            if registry.SearchServiceCursor > #registry.SearchOrder then
                registry.SearchServiceCursor = 1
            end
            local group = registry.SearchOrder[registry.SearchServiceCursor]
            registry.SearchServiceCursor += 1
            if group and not group.Removed then
                pcall(processGroup, registry, group, os.clock())
            end
            task.wait(SERVICE_WAIT)
        end
        registry.SearchServiceRunning = false
        registry.SearchServiceCursor = 1
    end)
end

function Search.restart(registry: Registry, group: Group)
    if not group or group.Removed then
        return
    end
    group.InitialQueue = {}
    group.InitialHead = 1
    group.InitialSeen = Groups.weakSet()
    for _, root in children(workspace) do
        group.InitialSeen[root] = true
        group.InitialQueue[#group.InitialQueue + 1] = root
    end
    group.InitialScanning = true
    group.PathVotes = {}
    group.PathVoteContainers = {}
    group.AncestorPathVotes = {}
    group.AncestorPathContainers = {}
    group.BestPathVotes = 0
    group.BestPathDepth = 0
    group.BestPathContainer = nil
    registry.LastSearch = group
    Search.startService(registry)
end

local function syncGroupAsync(registry: Registry, group: Group)
    group.SyncGeneration = (group.SyncGeneration or 0) + 1
    local generation = group.SyncGeneration
    local asyncGeneration = registry.AsyncGeneration
    task.spawn(function()
        for index = 1, #group.Members do
            if group.SyncGeneration ~= generation or registry.AsyncGeneration ~= asyncGeneration then
                return
            end
            pcall(registry.Models.sync, registry.Models, group.Members[index])
            if index % 8 == 0 then
                task.wait()
            end
        end
    end)
end

Search.syncGroup = syncGroupAsync

function Search.add(registry: Registry, word: string)
    local text = Util.trim(string.lower(tostring(word or "")))
    if text == "" then
        return
    end
    local existing = registry.SearchByWord[text]
    if existing and not existing.Removed then
        Groups.setEnabled(registry, existing, true)
        Search.restart(registry, existing)
        syncGroupAsync(registry, existing)
        Groups.schedulePathSave(existing)
        return
    end
    local group = Groups.newSearch(text)
    registry.SearchByWord[text] = group
    registry.SearchOrder[#registry.SearchOrder + 1] = group
    registry.LastSearch = group
    Groups.setEnabled(registry, group, true)
    Search.restart(registry, group)
    Groups.schedulePathSave(group)
end

function Search.addPath(registry: Registry, container: any): Group?
    if not container or container == workspace or Groups.isPlayerOwned(registry, container) then
        return nil
    end
    local path = Paths.toText(container)
    if path == nil then
        return nil
    end
    local existing = registry.PathGroupByPath[path]
    if existing and not existing.Removed then
        Groups.setEnabled(registry, existing, true)
        existing.Paths[path] = container
        existing.NextPoll = 0
        syncGroupAsync(registry, existing)
        Groups.schedulePathSave(existing)
        Search.startService(registry)
        return existing
    end
    local group = Groups.newPathGroup(path)
    group.Paths[path] = container
    group.PathScanRecursive = true
    registry.PathGroupByPath[path] = group
    registry.SearchOrder[#registry.SearchOrder + 1] = group
    Groups.setEnabled(registry, group, true)
    watchContainer(registry, group, container)
    queueChildren(group, container)
    Groups.schedulePathSave(group)
    Search.startService(registry)
    return group
end

local function disconnectAll(group: Group)
    for _, connection in group.Connections do
        if connection then
            pcall(function()
                connection:Disconnect()
            end)
        end
    end
    group.Connections = {}
end

function Search.delete(registry: Registry, group: Group)
    if not group or not group.Search or group.Removed then
        return
    end
    group.Removed = true
    if group.Enabled then
        Groups.setEnabled(registry, group, false)
    end
    disconnectAll(group)
    local affected = {}
    for _, model in group.Members do
        if model then
            affected[#affected + 1] = model
        end
    end
    for _, model in affected do
        Groups.removeSearchMember(registry, group, model)
    end
    if group.PathSource then
        for _, path in group.PathOrder do
            registry.PathGroupByPath[path] = nil
        end
    else
        registry.SearchByWord[group.Word] = nil
    end
    pcall(Paths.deleteGroupFile, group)
    Util.removeValue(registry.SearchOrder, group)
    if registry.LastSearch == group then
        registry.LastSearch = nil
        for index = #registry.SearchOrder, 1, -1 do
            local candidate = registry.SearchOrder[index]
            if candidate and not candidate.Removed and not candidate.PathSource then
                registry.LastSearch = candidate
                break
            end
        end
    end
    for _, model in affected do
        registry.Models:sync(model)
    end
end

function Search.clearAll(registry: Registry)
    for _, group in registry.SearchOrder do
        if group.PathSaveDue then
            pcall(Paths.saveGroup, group)
        end
        group.Removed = true
        disconnectAll(group)
    end
    registry.SearchOrder = {}
    registry.SearchByWord = {}
    registry.PathGroupByPath = {}
    registry.SearchMembership = Groups.weakSet()
    registry.SearchServiceCursor = 1
    registry.LastSearch = nil
end

function Search.loadSaved(registry: Registry)
    for _, record in Paths.readAll() do
        local firstPath = tostring(record.Paths[1] or "")
        if record.Kind == "dead" then
            if firstPath ~= "" then
                registry.DeadPath = firstPath
                registry.DeadPathContainer = Paths.resolve(firstPath)
                registry.DeadPathResolveAt = 0
            end
        else
            local isPath = record.Kind == "path"
            local allowed
            if isPath then
                allowed = firstPath ~= "" and not registry.PathGroupByPath[firstPath]
            else
                allowed = record.Word ~= "" and not registry.SearchByWord[record.Word]
            end
            if allowed then
                local group = if isPath then Groups.newPathGroup(firstPath) else Groups.newSearch(record.Word)
                if isPath then
                    registry.PathGroupByPath[firstPath] = group
                else
                    registry.SearchByWord[record.Word] = group
                end
                registry.SearchOrder[#registry.SearchOrder + 1] = group
                if group.PathSource then
                    group.PathOrder = {}
                end
                for _, saved in record.Paths do
                    local path = tostring(saved or "")
                    if path ~= "" and not group.Paths[path] then
                        group.PathOrder[#group.PathOrder + 1] = path
                        local container = Paths.resolve(path)
                        group.Paths[path] = container
                        if container then
                            watchContainer(registry, group, container)
                            queueChildren(group, container)
                        end
                    end
                end
                group.Size = record.Size
                Groups.setEnabled(registry, group, record.Enabled)
                if not group.PathSource then
                    registry.LastSearch = group
                end
            end
        end
    end
    if #registry.SearchOrder > 0 then
        Search.startService(registry)
    end
end

return Search
end
