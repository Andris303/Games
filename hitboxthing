    Storage.ensureFolder(Storage.ROOT)
    local names = {}
    for _, path in Storage.list(Storage.ROOT) do
        local name = string.match(path, "([^/\\]+)%.json$")
        if name and not string.match(name, "^default_") then
            table.insert(names, name)
        end
    end
    if #names == 0 then
        table.insert(names, "None")
    end
    return names
end

function Config.listWithNone(): { string }
    local options = Config.list()
    if options[1] ~= "None" then
        table.insert(options, 1, "None")
    end
    return options
end

local SHARE_PREFIX = "HBE4:"

local PRIVATE_KEYS: { [string]: boolean } = { Targets = true, TargetOrder = true, Whitelist = true, WhitelistOrder = true }

Config.IMPORT_FILE = Storage.ROOT .. "/import.txt"

local function collect(state: State, shared: boolean): { [string]: any }
    local data: { [string]: any } = {}
    for _, key in Settings.PERSISTED_KEYS do
        local value = state[key]
        if shared and PRIVATE_KEYS[key] then
            continue
        end
        if Settings.COLOR_KEYS[key] then
            data[key] = Color.toHex(value)
        elseif type(value) == "number" then
            data[key] = tostring(value)
        elseif type(value) == "boolean" then
            data[key] = if value then "true" else "false"
        elseif type(value) == "string" or type(value) == "table" then
            data[key] = value
        end
    end
    return data
end

function Config.save(name: string, state: State): boolean
    Storage.ensureFolder(Storage.ROOT)
    return Storage.writeJson(filePath(name), collect(state, false))
end

function Config.share(state: State): string
    local json = Storage.encode(collect(state, true))
    local ok, encoded = pcall(function()
        return crypt.base64.encode(json)
    end)
    if json == "" or not ok or type(encoded) ~= "string" then
        return ""
    end
    return SHARE_PREFIX .. encoded
end

local function migratedColor(key: string, text: string, fallback: Color3): Color3
    local normalized = string.upper(text)
    if not string.find(normalized, "^#") then
        normalized = "#" .. normalized
    end
    if (key == "AccentCol" or key == "FOVColor") and OLD_ACCENTS[normalized] then
        return Theme.Accent
    elseif key == "MainCol" and OLD_MAIN[normalized] then
        return Theme.BgBase
    end
    return Color.fromHex(text) or fallback
end

export type Loaded = {
    Colors: { [string]: Color3 },
    LayoutVersion: number,
}

local function apply(data: any, state: State): Loaded?
    if type(data) ~= "table" then
        return nil
    end
    local colors: { [string]: Color3 } = {}
    for _, key in Settings.PERSISTED_KEYS do
        local value = data[key]
        if value ~= nil then
            if Settings.COLOR_KEYS[key] then
                if type(value) == "string" then
                    local color = migratedColor(key, value, state[key])
                    state[key] = color
                    colors[key] = color
                elseif type(value) == "table" and value.R then
                    local color = Color3.new(value.R, value.G, value.B)
                    state[key] = color
                    colors[key] = color
                end
            elseif type(state[key]) == "number" then
                state[key] = tonumber(value) or state[key]
            elseif type(state[key]) == "boolean" then
                state[key] = value == true or value == "true"
            else
                state[key] = value
            end
        end
    end
    return { Colors = colors, LayoutVersion = tonumber(data.UILayoutVersion) or 0 }
end

function Config.load(name: string, state: State): Loaded?
    return apply(Storage.readJson(filePath(name)), state)
end

function Config.loadCode(text: string, state: State): Loaded?
    local code = string.match(text, "^%s*(.-)%s*$") or ""
    if string.sub(code, 1, #SHARE_PREFIX) ~= SHARE_PREFIX then
        return nil
    end
    local ok, json = pcall(function()
        return crypt.base64.decode(string.sub(code, #SHARE_PREFIX + 1))
    end)
    if not ok or type(json) ~= "string" then
        return nil
    end
    return apply(Storage.decode(json), state)
end

function Config.migrateScale(layoutVersion: number, scale: number, defaultScale: number): number
    if layoutVersion < Settings.LAYOUT_VERSION then
        for _, old in { 1.0, 0.92, 0.80, 0.74 } do
            if math.abs(scale - old) < 0.04 then
                return defaultScale
            end
        end
    end
    return scale
end

function Config.migrate(layoutVersion: number, state: State, defaults: State)
    if layoutVersion >= Settings.LAYOUT_VERSION then
        return
    end
    if math.abs((tonumber(state.Roundness) or defaults.Roundness) - Settings.OLD_ROUNDNESS) < 0.02 then
        state.Roundness = defaults.Roundness
    end

    state.BlockRobloxWindow = defaults.BlockRobloxWindow
end

function Config.delete(name: string, defaultName: string): boolean
    Storage.delete(filePath(name))
    if defaultName == name then
        Storage.delete(GLOBAL_DEFAULT)
        Storage.delete(gameDefaultPath())
        return true
    end
    return false
end

function Config.setDefault(name: string, scope: string)
    local onlyThisGame = scope == "This Game"
    if name == "None" or name == "" then
        Storage.delete(gameDefaultPath())
        if not onlyThisGame then
            Storage.delete(GLOBAL_DEFAULT)
        end
        return
    end
    if onlyThisGame then
        Storage.writeJson(gameDefaultPath(), { Config = name, GameName = tostring(game.PlaceId) })
    elseif Storage.writeJson(GLOBAL_DEFAULT, { Config = name, GameName = "All Games" }) then
        Storage.delete(gameDefaultPath())
    end
end

function Config.defaultScope(): string
    return if Storage.isFile(gameDefaultPath()) then "This Game" else "All Games"
end

local function configNameIn(path: string): string?
    local data = Storage.readJson(path)
    if type(data) == "table" and data.Config then
        return tostring(data.Config)
    end
    return nil
end

local function configNameInText(path: string): string?
    local text = Storage.read(path)
    if text and text ~= "" then
        return text
    end
    return nil
end

function Config.defaultName(): string?
    if Storage.isFile(gameDefaultPath()) then
        return configNameIn(gameDefaultPath())
    elseif Storage.isFile(GLOBAL_DEFAULT) then
        return configNameIn(GLOBAL_DEFAULT)
    elseif Storage.isFile(gameDefaultTextPath()) then
        return configNameInText(gameDefaultTextPath())
    elseif Storage.isFile(GLOBAL_DEFAULT_TEXT) then
        return configNameInText(GLOBAL_DEFAULT_TEXT)
    end
    return nil
end

function Config.clearMissingDefault()
    Storage.delete(gameDefaultPath())
    Storage.delete(GLOBAL_DEFAULT)
    Storage.delete(gameDefaultTextPath())
    Storage.delete(GLOBAL_DEFAULT_TEXT)
end

function Config.exists(name: string): boolean
    return Storage.isFile(filePath(name))
end

return Config
end
