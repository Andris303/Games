local import: (string) -> any = ...
local Chrome: typeof(require("./chrome")) = import("ui/chrome")
local Color: typeof(require("../core/color")) = import("core/color")
local Config: typeof(require("../state/config")) = import("state/config")
local Draw: typeof(require("../render/draw")) = import("render/draw")
local Effects: typeof(require("./effects")) = import("ui/effects")
local Fonts: typeof(require("./fonts")) = import("ui/fonts")
local Keys: typeof(require("../input/keys")) = import("input/keys")
local Paths: typeof(require("../entities/paths")) = import("entities/paths")
local Picker: typeof(require("./picker")) = import("ui/picker")
local Settings: typeof(require("../state/settings")) = import("state/settings")
local Spec: typeof(require("./spec")) = import("ui/spec")
local Storage: typeof(require("../core/storage")) = import("core/storage")
local Typing: typeof(require("./typing")) = import("ui/typing")
local Theme: typeof(require("../core/theme")) = import("core/theme")
local Util: typeof(require("../core/util")) = import("core/util")

local App = {}
App.__index = App

type Map = { [string]: any }

App.VERSION = "4.0.0"
App.BIND_PREFIX = "OptionBind:"

App.CAPTURE_STATE = { Keybind = "Keybind", HoldKey = "HoldKey" } :: { [string]: string }
local UPDATE_MARKER = Storage.ROOT .. "/v4_update_version.txt"

local PART_ORDER = { "HRP", "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }

local PLAYER_HITBOX_TABS: { [string]: boolean } = { Hitbox = true, Targeting = true, Parts = true, FOV = true, Dynamic = true, Dimensions = true }

local NAV_GROUPS = {
    { Name = "Hitbox", Tabs = { "Hitbox", "Targeting", "Parts", "FOV", "Dynamic", "Dimensions" } },
    { Name = "NPC", Tabs = { "NPC", "NPCVisuals" } },
    { Name = "Visuals", Tabs = { "Customize" } },
    { Name = "UI", Tabs = { "Motion" } },
    { Name = "Settings", Tabs = { "Keybinds", "Config", "Changelog", "Info" } },
}

local KEY_ALIASES: { [string]: string } = {
    RightShift = "rshift", LeftShift = "lshift", RightControl = "rctrl", LeftControl = "lctrl",
    RightCtrl = "rctrl", LeftCtrl = "lctrl", RightAlt = "ralt", LeftAlt = "lalt",
    Backspace = "bksp", CapsLock = "caps", PageUp = "pgup", PageDown = "pgdn",
    MouseButton1 = "m1", MouseButton2 = "m2", MouseButton3 = "m3", LeftMouse = "m1", RightMouse = "m2",
    KeypadPlus = "num+", KeypadMinus = "num-", KeypadMultiply = "num*", KeypadDivide = "num/",
}

export type Config = {
    State: Map,
    Profile: Map,
    Players: any,
    LocalPlayer: any,
    GetPlayers: () -> { any },
    Hitbox: any,
    Entities: any,
    Vehicle: any,
    DPI: number,
    OnReload: () -> (),
    OnUnload: () -> (),
}

function App.new(config: Config)
    local isZombie = config.Profile.Id == "zombie"
    local self: Map = {
        State = config.State,
        Profile = config.Profile,
        Players = config.Players,
        LocalPlayer = config.LocalPlayer,
        GetPlayers = config.GetPlayers,
        Hitbox = config.Hitbox,
        Entities = config.Entities,
        Vehicle = config.Vehicle,
        DPI = config.DPI,
        OnReload = config.OnReload,
        OnUnload = config.OnUnload,
        M = Chrome.metrics(isZombie),
        IsZombie = isZombie,

        Buffers = {},
        Focus = nil,
        NavAnim = {},
        Springs = {},
        PopAnim = {},
        Popup = { Name = "None", Arg = nil, Open = false, Alpha = 0, SourcePos = Vector2.zero, SourceSize = Vector2.zero, SourceKey = nil, Return = nil },
        LastClick = nil,
        Browser = { Container = workspace, Page = 1, DeadContainer = workspace, DeadPage = 1, GroupPage = 1, SearchPage = 1, MemberPage = 1 },
        OpenDropdown = nil,
        DropdownValues = {},
        Welcome = nil,
        Particles = {},

        Pal = nil,
        Alpha = { UI = 0, Btn = 0, Text = 0 },
        Scale = 1,
        Unit = 1,
        TextScale = 1,
        Dt = 0.016,
        Now = 0,
        Mouse = Vector2.zero,
        LeftDown = false,
        HoverKey = nil,
        Modal = false,
        Moving = false,
        Viewport = Vector2.new(1920, 1080),
        WindowPos = Vector2.zero,
        WindowSize = Vector2.zero,
        MenuPos = Vector2.zero,
        TargetPos = Vector2.zero,
        Centered = false,
        Suspended = false,

        ToggleSpecs = {},
        ToggleOrder = {},
        Tabs = {},
        TabByName = {},
        TabGroup = {},
        TabOrder = {},
        NavGroups = {},
        StatusCache = { At = 0, Search = "", Browser = "", Dead = "" },
    }
    local app: Map = setmetatable(self, App) :: any
    app.Picker = Picker.new(app)
    app.Typing = Typing.new(app)
    App.prepareState(app)
    app:loadTheme()
    App.buildPages(app)
    app.Particles = Effects.createParticles(app.State.SnowAmount)
    return app
end

type Self = Map

function App.prepareState(self: Self)
    local state = self.State
    local runtime: Map = {
        Visible = true, CurrentTab = "Hitbox", NextTab = nil, TabAlpha = 1, TabReveal = 1, NavReveal = 1,
        TabSlideDirection = 1, SectionByTab = {}, VisibilityAnim = 0, IntroAlpha = 0, EdgeStableAlpha = 0,
        DropAlpha = 0, TogglePulse = 0, LightAlpha = if state.LightMode then 1 else 0, PopFontPage = 1,
        RangePage = 1, FOVCustomizeOpen = "Animation", OutlinePhases = {}, UIScaleAnim = 0.945,
        UpdateNoticePending = false, UpdateNoticeOpened = false,
        TargetPage = 1, WhitelistPage = 1, IsReloading = false,
    }
    for key, value in runtime do
        if state[key] == nil then
            state[key] = value
        end
    end
    for key in Settings.COLOR_KEYS do
        state["Target_" .. key] = state[key]
    end
    if Storage.isFile(UPDATE_MARKER) then
        local seen = Storage.read(UPDATE_MARKER)
        if seen and Util.trim(seen) == App.VERSION then
            state.UpdateNoticePending = false
        end
    end
end

function App.buildPages(self: Self)
    local builders = {
        import("ui/pages/hitbox"),
        import("ui/pages/entities"),
        import("ui/pages/appearance"),
        import("ui/pages/system"),
    }
    for _, build in builders do
        for _, tab in build(self) do
            Spec.assignIds(tab)
            if not self.IsZombie and PLAYER_HITBOX_TABS[tab.name] then
                Spec.gate(tab, { HitboxEnabled = true })
            end
            self.Tabs[#self.Tabs + 1] = tab
            self.TabByName[tab.name] = tab
        end
    end
    local groups: { Map } = if self.IsZombie then { { Name = "Hitbox", Tabs = { "Hitbox" } } } else NAV_GROUPS
    local order = 0
    for _, group in groups do
        self.NavGroups[#self.NavGroups + 1] = group
        for _, name in group.Tabs do
            order += 1
            self.TabGroup[name] = group.Name
            self.TabOrder[name] = order
        end
    end
    if self.IsZombie then
        self.State.CurrentTab = "Hitbox"
    end

    local binds = self.State.OptionKeybinds
    for _, tab in self.Tabs do
        for _, section in tab.sections do
            for _, row in section.rows do
                local specs: { Map } = if row.kind == "pair" then { row.left, row.right } else { row }
                for _, spec in specs do
                    if spec.kind == "toggle" and spec.bindable then
                        self.ToggleSpecs[spec.state] = spec
                        table.insert(self.ToggleOrder, spec)
                        if binds[spec.state] == nil then
                            binds[spec.state] = "None"
                        end
                    end
                end
            end
        end
    end
end

function App.pos(self: Self, x: number, y: number): Vector2

    return self.WindowPos + Vector2.new(x, y) * self.Unit
end

function App.size(self: Self, w: number, h: number): Vector2
    return Vector2.new(w, h) * self.Unit
end

function App.currentTab(self: Self): Map
    return self.TabByName[self.State.CurrentTab] or self.Tabs[1]
end

function App.switchTab(self: Self, name: string)
    local state = self.State
    local target = state.NextTab or state.CurrentTab
    if target == name then
        return
    end
    local from = self.TabOrder[target] or self.TabOrder[state.CurrentTab] or 1
    local to = self.TabOrder[name] or from
    state.TabSlideDirection = if to >= from then 1 else -1
    if state.NextTab and name == state.CurrentTab then
        state.NextTab = nil
        self.Focus = nil
        self.OpenDropdown = nil
        return
    end
    state.NextTab = name
    self.Focus = nil
    self.OpenDropdown = nil
end

function App.toggle(self: Self, spec: Map)
    local state = self.State
    local key: string = spec.state
    state[key] = not state[key]
    if spec.Anim then
        spec.Anim.bounce = 1
    end
    state.TogglePulse = 1
    if key == "HitboxEnabled" and not state[key] then
        self.Hitbox:resetAll()
    end
    if spec.onChange then
        spec.onChange(state[key], self)
    end
end

function App.toggleState(self: Self, key: string)
    local spec = self.ToggleSpecs[key]
    if spec then
        self:toggle(spec)
    elseif type(self.State[key]) == "boolean" then
        self.State[key] = not self.State[key]
    end
end

function App.setValue(self: Self, spec: Map, value: any)
    self.State[spec.state] = value
end

function App.isCapturing(self: Self, focus: string): boolean
    return App.CAPTURE_STATE[focus] ~= nil or string.sub(focus, 1, #self.BIND_PREFIX) == self.BIND_PREFIX
end

function App.beginInput(self: Self, key: string, text: string)
    self.Focus = key
    self.Buffers[key] = text
end

function App.inputText(self: Self, key: string, idle: string): string
    local buffer = self.Buffers[key] or ""
    if self.Focus == key then
        return if App.CAPTURE_STATE[key] then "Press Any..." else buffer .. "|"
    end
    if App.CAPTURE_STATE[key] or buffer == "" then
        return idle
    end
    return buffer
end

function App.playerInputText(self: Self, key: string, idle: string): string
    if self.Focus ~= key then
        return self:inputText(key, idle)
    end
    local buffer = self.Buffers[key] or ""
    local text = buffer .. "|"
    local match = Typing.matchPlayer(self, buffer)
    if match ~= "" then
        text ..= "   match: " .. Util.truncate(match, 22) .. " [TAB]"
    end
    return text
end

function App.toggleDropdown(self: Self, spec: Map)
    if self.OpenDropdown == spec then
        self.OpenDropdown = nil
        return
    end
    self.Focus = nil
    self.OpenDropdown = spec
    local values = spec.values
    self.DropdownValues = if type(values) == "function" then values() else values
end

function App.selectDropdown(self: Self, spec: Map, value: any)
    self.State[spec.state] = value
    if spec.state == "DefaultConfigName" or spec.state == "AutoLoadScope" then
        Config.setDefault(tostring(self.State.DefaultConfigName), tostring(self.State.AutoLoadScope))
    elseif spec.state == "BackgroundEffect" then
        self:regenerateParticles()
    end
    self.OpenDropdown = nil
end

function App.shortKey(self: Self, key: any): string
    local name = Keys.normalize(key)
    if name == "" or name == "None" then
        return "none"
    end
    return Util.truncate(KEY_ALIASES[name] or string.lower(name), 7, "")
end

function App.countBinds(self: Self): number
    local count = 0
    for _, key in self.State.OptionKeybinds do
        local name = Keys.normalize(key)
        if name ~= "" and name ~= "None" then
            count += 1
        end
    end
    return count
end

function App.boundOptions(self: Self): { { [string]: any } }
    if self.BoundList and self.BoundAt == self.Now then
        return self.BoundList
    end
    local list: { { [string]: any } } = {}
    local binds = self.State.OptionKeybinds
    for _, spec in self.ToggleOrder do
        local key = binds[spec.state]
        local name = Keys.normalize(key)
        if name ~= "" and name ~= "None" then
            table.insert(list, { Name = spec.text, Key = key, State = spec.state })
        end
    end
    self.BoundList, self.BoundAt = list, self.Now
    return list
end

function App.clearBinds(self: Self)
    local binds = self.State.OptionKeybinds
    for key in binds do
        binds[key] = "None"
    end
    for key in self.ToggleSpecs do
        binds[key] = "None"
    end
end

function App.selectedPartsText(self: Self): string
    local names = {}
    for _, key in PART_ORDER do
        if self.State.TargetParts[key] then
            names[#names + 1] = key
        end
    end
    return if #names == 0 then "None" else table.concat(names, ", ")
end

function App.setVehicleFix(self: Self, enabled: boolean)
    if enabled then
        self.Vehicle:start()
    else
        self.Vehicle:stop()
    end
end

local function refreshStatus(self: Self)
    if self.Now < self.StatusCache.At then
        return
    end
    self.StatusCache.At = self.Now + 0.25
    local entities = self.Entities
    local browser = self.Browser

    local group = entities:lastSearch()
    if not group or group.Removed then
        self.StatusCache.Search = "No saved searches"
    else
        local busy = group.InitialScanning or group.PathHead <= #group.PathQueue or group.PendingHead <= #group.PendingQueue
        if busy then
            self.StatusCache.Search = "Contains: " .. group.Word .. "  -  scanning..."
        else
            self.StatusCache.Search = "Contains: " .. group.Word .. "  -  " .. tostring(entities:liveCount(group)) .. " NPCs  -  " .. entities:pathSummary(group)
        end
    end
    local display = Paths.display(Paths.toText(browser.Container or workspace))
    self.StatusCache.Browser = "Current: " .. Util.truncate(display, 46, "...")
    local dead = entities:deadPath()
    self.StatusCache.Dead = "Dead Check Path: " .. Util.truncate(if dead then Paths.display(dead) else "none", 48, "...")
end

function App.refreshStatus(self: Self)
    refreshStatus(self)
end

function App.searchStatusText(self: Self): string
    if self.Focus == "NPCMatch" then
        local count, done, capped = self.Entities:previewResult()
        local word = Util.trim(self.Buffers.NPCMatch or "")
        if word == "" then
            return "Type a word, press enter to add the search"
        end
        local total = tostring(count) .. (if capped then "+" else "")
        return total .. (if count == 1 then " NPC matches" else " NPCs match") .. (if done then "" else ", counting...")
    end
    return self.StatusCache.Search
end

function App.browserPathText(self: Self): string
    return self.StatusCache.Browser
end

function App.statusPathText(self: Self): string
    return self.StatusCache.Dead
end

function App.rememberClick(self: Self, position: Vector2, size: Vector2, key: any)
    local unit = self.Unit
    self.LastClick = {
        Pos = (position - self.WindowPos) / unit,
        Size = size / unit,
        Key = key,
    }
end

function App.sourceFade(self: Self, key: any): number
    local popup = self.Popup
    if popup.Name ~= "None" and popup.SourceKey == key then
        return 1 - math.clamp(popup.Alpha, 0, 1)
    end
    return 1
end

function App.openPopup(self: Self, name: string, arg: any?)
    local popup = self.Popup
    local click = self.LastClick
    if click and popup.Name == "None" then
        popup.SourcePos, popup.SourceSize, popup.SourceKey = click.Pos, click.Size, click.Key
    else
        popup.SourcePos = Vector2.new(self.M.Width / 2, self.M.Height / 2)
        popup.SourceSize = Vector2.new(1, 1)
        popup.SourceKey = nil
    end
    self.LastClick = nil
    popup.Name, popup.Arg, popup.Open, popup.Alpha = name, arg, true, 0
    self.Springs.popup = { x = 0, v = 0 }
    self.OpenDropdown = nil
end

function App.closePopup(self: Self)
    local popup = self.Popup
    local back = popup.Return
    popup.Return = nil
    if self.Focus and not self:isCapturing(self.Focus) then
        self.Typing:apply()
    end
    if back then
        self:openPopup(back.Name, back.Arg)
    else
        popup.Open = false
    end
end

function App.togglePopup(self: Self, name: string, arg: any?)
    local popup = self.Popup
    if popup.Open and popup.Name == name and popup.Arg == arg then
        self:closePopup()
    else
        self:openPopup(name, arg)
    end
end

function App.setPopupReturn(self: Self, name: string, arg: any?)
    self.Popup.Return = { Name = name, Arg = arg }
end

function App.openColor(self: Self, target: string)
    local popup = self.Popup
    if popup.Open and popup.Name == "color" and self.Picker.Target == target then
        self:closePopup()
        return
    end
    self.Picker:open(target)
    self:openPopup("color")
end

function App.finishColor(self: Self)
    if self.Focus then
        self.Typing:apply()
    end
    self.Picker:commit()
    self:closePopup()
end

function App.regenerateParticles(self: Self)
    self.Particles = Effects.createParticles(self.State.SnowAmount)
    Effects.resetStars(os.clock())
end

local THEME_VERSION = 2

function App.themePath(self: Self): string
    return Storage.ROOT .. "/default_theme.json"
end

function App.loadTheme(self: Self)
    local state = self.State
    state.ThemeName = "Gruvbox"
    state.ThemePreset = Theme.Presets.Gruvbox
    state.CustomMainCol, state.CustomAccentCol = Theme.CustomMain, Theme.CustomAccent
    local data = Storage.readJson(self:themePath())
    if type(data) ~= "table" or data.Version ~= THEME_VERSION or type(data.Main) ~= "string" or type(data.Accent) ~= "string" then
        return
    end
    local main, accent = Color.fromHex(data.Main), Color.fromHex(data.Accent)
    if not main or not accent then
        return
    end
    state.CustomMainCol, state.CustomAccentCol = main, accent
    local saved = if type(data.Theme) == "string" then Theme.Presets[data.Theme] else nil
    if saved then
        state.ThemeName = saved.Name
        state.ThemePreset = saved
        state.MainCol, state.AccentCol = saved.Main, saved.Accent
        state.Target_MainCol, state.Target_AccentCol = saved.Main, saved.Accent
    elseif data.Theme == "Custom" then
        state.ThemeName = "Custom"
        state.MainCol, state.AccentCol = main, accent
        state.Target_MainCol, state.Target_AccentCol = main, accent
    end
end

function App.saveTheme(self: Self)
    local state = self.State
    Storage.ensureFolder(Storage.ROOT)
    Storage.writeJson(self:themePath(), {
        Version = THEME_VERSION,
        Theme = state.ThemeName,
        Main = Color.toHex(state.CustomMainCol),
        Accent = Color.toHex(state.CustomAccentCol),
    })
    self.ThemeDirty = nil
end

function App.colorEdited(self: Self)
    local state = self.State
    state.ThemeName = "Custom"
    state.CustomMainCol = state.Target_MainCol or state.MainCol
    state.CustomAccentCol = state.Target_AccentCol or state.AccentCol
    self.ThemeDirty = os.clock()
end

function App.flushTheme(self: Self, force: boolean?)
    local changed: number? = self.ThemeDirty
    if changed and (force or os.clock() - changed > 0.5) then
        self:saveTheme()
    end
end

function App.themeFromColors(self: Self)
    local state = self.State
    local main: Color3 = state.Target_MainCol or state.MainCol
    local accent: Color3 = state.Target_AccentCol or state.AccentCol
    local matched = Theme.exactPreset(main, accent)
    if matched then
        state.ThemeName = matched
        state.ThemePreset = Theme.Presets[matched]
    else
        state.ThemeName = "Custom"
        state.CustomMainCol, state.CustomAccentCol = main, accent
    end
    self:saveTheme()
end

function App.applyTheme(self: Self, name: string)
    local state = self.State
    if name == "Custom" then
        state.Target_MainCol, state.Target_AccentCol = state.CustomMainCol, state.CustomAccentCol
    elseif Theme.Presets[name] then
        local preset = Theme.Presets[name]
        state.ThemePreset = preset
        state.Target_MainCol, state.Target_AccentCol = preset.Main, preset.Accent
    else
        return
    end
    state.ThemeName = name
    self:saveTheme()
end

function App.resetAppearance(self: Self)
    local state = self.State
    local defaults = Settings.create(self.Profile)
    for _, key in { "NavSide", "Roundness", "ToggleRoundness", "UITrans", "ButtonTrans", "Transparent", "LightMode", "VisLineTrans", "VisFillTrans", "VisShowNames",
        "Snowfall", "BackgroundEffect", "SnowSize", "SnowSpeed", "SnowAmount", "SnowTrans", "UIFont", "PremiumEffects", "AnimationIntensity", "UIScale" } do
        state[key] = defaults[key]
    end
    for _, key in { "AccentCol", "MainCol", "VisLineCol", "VisFillCol", "VisTextCol", "SnowCol", "FOVColor" } do
        state["Target_" .. key] = defaults[key]
    end
    state.UILayoutVersion = Settings.LAYOUT_VERSION
    state.ThemeName = "Gruvbox"
    state.ThemePreset = Theme.Presets.Gruvbox
    state.CustomMainCol, state.CustomAccentCol = Theme.CustomMain, Theme.CustomAccent
    self:saveTheme()
    self:regenerateParticles()
end

function App.saveConfig(self: Self, name: string?)
    if not name or name == "" then
        return
    end
    local state = self.State
    state.UILayoutVersion = Settings.LAYOUT_VERSION
    if Config.save(name, state) then
        state.SelectedConfig = name
    end
end

local function finishLoad(self: Self, loaded: { Colors: { [string]: Color3 }, LayoutVersion: number })
    local state = self.State
    for key, color in loaded.Colors do
        state["Target_" .. key] = color
    end
    if loaded.Colors.MainCol or loaded.Colors.AccentCol then
        self:themeFromColors()
    end
    local baseW = self.M.Width
    local saved = tonumber(state.UIScale) or Settings.defaultUiScale()
    saved = Config.migrateScale(loaded.LayoutVersion, saved, Settings.defaultUiScale())
    state.UIScale = math.max(0.10, saved)
    Config.migrate(loaded.LayoutVersion, state, Settings.create(self.Profile))
    state.UILayoutVersion = Settings.LAYOUT_VERSION
    state.MenuSizeX, state.MenuSizeY = baseW * state.UIScale, self.M.Height * state.UIScale
    self:regenerateParticles()
end

function App.loadConfig(self: Self, name: string, auto: boolean)
    local loaded = Config.load(name, self.State)
    if not loaded then
        return
    end
    finishLoad(self, loaded)
    if not auto then
        self.State.SelectedConfig = name
    end
end

function App.copyConfigCode(self: Self)
    local code = Config.share(self.State)
    local copied = code ~= "" and pcall(setclipboard, code)
    self.State.ShareNote = if copied then "Config code copied to the clipboard" else "Could not copy the config code"
end

function App.importConfigCode(self: Self)
    local text = Storage.read(Config.IMPORT_FILE)
    local loaded = if text then Config.loadCode(text, self.State) else nil
    if loaded then
        finishLoad(self, loaded)
        self.State.ShareNote = "Config code imported"
    else
        self.State.ShareNote = "No config code found in " .. Config.IMPORT_FILE
    end
end

function App.deleteConfig(self: Self, name: string)
    if Config.delete(name, self.State.DefaultConfigName) then
        self.State.DefaultConfigName = "None"
    end
    self.State.SelectedConfig = "None"
end

function App.loadStartupConfig(self: Self)
    local name = Config.defaultName()
    if not name then
        return
    end
    if Config.exists(name) then
        self:loadConfig(name, true)
        self.State.DefaultConfigName = name
        self.State.AutoLoadScope = Config.defaultScope()
        self.State.SelectedConfig = "None"
    else
        Config.clearMissingDefault()
        self.State.DefaultConfigName = "None"
    end
end

function App.acknowledgeUpdate(self: Self)
    self.State.UpdateNoticePending = false
    Storage.ensureFolder(Storage.ROOT)
    Storage.write(UPDATE_MARKER, App.VERSION)
end

function App.reload(self: Self)
    local state = self.State
    if state.IsReloading then
        return
    end
    state.IsReloading = true
    self:flushTheme(true)
    if state.DefaultConfigName and state.DefaultConfigName ~= "None" then
        self:saveConfig(state.DefaultConfigName)
    end
    state.Visible = false
    self.OnReload()
end

function App.unload(self: Self)
    local state = self.State
    if state.IsReloading then
        return
    end
    state.IsReloading = true
    self:flushTheme(true)
    self.Popup.Open = false
    self.OpenDropdown = nil
    self.Focus = nil
    state.Visible = false
    self.OnUnload()
end

function App.finishWelcome(self: Self, position: Vector2, scale: number)
    local state = self.State
    state.Visible = true
    state.VisibilityAnim = 1
    state.IntroAlpha = 1
    state.UIScaleAnim = 1
    state.NavReveal, state.TabReveal, state.TabAlpha = 0, 0, 1
    state.EdgeStableAlpha = 1
    state.UIScale = scale
    state.MenuSizeX, state.MenuSizeY = self.M.Width * scale, self.M.Height * scale
    self.MenuPos, self.TargetPos = position, position
    self.Centered = true
    self.Welcome = nil
    self.RevealStart = self.Now
end

function App.fontScale(_self: Self, font: number): number
    return Fonts.scale(font)
end

function App.applyFont(self: Self)
    Draw.setFont(tonumber(self.State.UIFont) or 5)
end

return App
end
